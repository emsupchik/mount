const RemoteActions = {
  forgotOpen: () => ResetUI.forgot(), restoreOpen: () => ResetUI.restore(),
  useDemo: () => { Remote.forceDemo = true; Modal.closeAll(); Toast.show('Локальное ДЕМО: данные остаются только в этом браузере', { icon: '🟣', duration: 6000 }); AuthUI.open(AuthUI.role); },
  syncOpen: () => SyncUI.open(), syncRetry: () => { Outbox.flush(true); Toast.show('Отправляем…', { icon: '⟳' }); },
  syncDrop: t => { Outbox.remove(t.dataset.id); },
  shareToggle: () => {
    const on = !Prefs.get().share;
    if (on && !confirm_('Отправлять мою позицию группе и в журнал похода, пока приложение открыто? Отключить можно в любой момент.')) return;
    Prefs.set(P => { P.share = on; });
    if (on) { GeoSvc.startTracking(); LocPub.tick(true); Toast.show('Позиция передаётся группе, пока приложение открыто', { icon: '📍', duration: 6000 }); } else Toast.show('Передача позиции выключена', { icon: '✓' });
    repaint();
  },
  /* диспетчер */
  rOpen: t => RescueUI.open(t.dataset.id),
  rFilter: t => RescueUI.load(t.dataset.v),
  rTeamPick: t => RescueUI.pickTeam(t.dataset.id),
  rTeamGo: async t => { const i = Sel.incident(t.dataset.id); if (!i) return; try { await Remote.post('/rescue/incidents/' + i.sid + '/team', { teamId: t.dataset.team }); Modal.close('rmod'); await Remote.loadIncident(i.sid); await RescueUI.load(); Toast.show('Команда направлена', { icon: '🧭' }); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️', duration: 7000 }); } },
  rUnassign: async t => { const i = Sel.incident(t.dataset.id); if (!i) return; try { await Remote.del('/rescue/incidents/' + i.sid + '/team', {}); await Remote.loadIncident(i.sid); await RescueUI.load(); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  rCancelInc: t => { const i = Sel.incident(t.dataset.id); RescueUI.askNote(t.dataset.id, 'Отменить обращение', 'Причина отмены', false, async n => { try { await Remote.post('/rescue/incidents/' + i.sid + '/status', { status: 'CANCELLED', note: n }); await Remote.loadIncident(i.sid); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } }); },
  rTake: async t => { const i = Sel.incident(t.dataset.id); try { await Remote.post('/rescue/incidents/' + i.sid + '/dispatcher', {}); await Remote.loadIncident(i.sid); Toast.show('Обращение закреплено за вами', { icon: '✓' }); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  rMissions: async t => { try { RescueUI.missions[t.dataset.id] = (await Remote.get('/rescue/teams/' + t.dataset.id + '/missions')).missions; Bus.emit('db'); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  rTeamLoc: async t => { const g = await Geo.once(); if (!g) return; try { const r = await Remote.post('/rescue/teams/' + t.dataset.id + '/location', { lat: g.lat, lon: g.lon }); Toast.show('Позиция команды обновлена' + (r.updated.length ? '; ETA пересчитан' : ''), { icon: '📍' }); await Remote.loadQueue(true); Bus.emit('db'); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  /* админ */
  cTab: t => { Console.tab = t.dataset.v; Console.lazy(); Bus.emit('db'); },
  cuBlock: t => RescueUI.askNote(null, 'Заблокировать аккаунт', 'Причина (видна в аудите)', true, async n => { try { await Remote.post('/admin/users/' + t.dataset.id + '/block', { reason: n }); await Console.reloadUsers(); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } }),
  cuUnblock: async t => { try { await Remote.post('/admin/users/' + t.dataset.id + '/unblock', {}); await Console.reloadUsers(); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  cuLogout: async t => { try { const r = await Remote.post('/admin/users/' + t.dataset.id + '/logout', {}); Toast.show('Сессий завершено: ' + r.revoked, { icon: '✓' }); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  cmHide: async t => { try { await Remote.post('/admin/complaints/' + t.dataset.id, { action: 'hide' }); Console.complaints = null; Console.lazy(); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  cmDismiss: async t => { try { await Remote.post('/admin/complaints/' + t.dataset.id, { action: 'dismiss' }); Console.complaints = null; Console.lazy(); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  stReg: async () => { const on = !(Console.settings && Console.settings.registration_open !== false); try { await Remote.put('/admin/settings/registration_open', { value: on }); Console.settings = null; Console.lazy(); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  rtHide: async t => { try { await Remote.post('/admin/routes/' + t.dataset.id + '/status', { status: t.dataset.s }); Console.routes = null; Console.lazy(); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  repOk: t => RemoteActions.moder(t.dataset.id, 'verified', false), repOkAlert: t => RemoteActions.moder(t.dataset.id, 'verified', true),
  repNo: t => RescueUI.askNote(null, 'Отклонить отчёт', 'Причина', false, n => RemoteActions.moder(t.dataset.id, 'rejected', false, n)),
  moder: async (id, status, createAlert, note) => { try { await Remote.post('/moderation/reports/' + id, { status, createAlert, note: note || undefined }); RescueUI.reports = null; await Console.loadMod(); Toast.show('Готово', { icon: '✓' }); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
  alCancel: async t => { try { await Remote.del('/alerts/' + t.dataset.id, {}); await Console.loadMod(); } catch (e) { Toast.show(Remote.errText(e), { icon: '⚠️' }); } },
};
const confirm_ = msg => { try { return window.confirm(msg); } catch (e) { return true; } };

/* формы панели (data-rform) */
document.addEventListener('submit', async e => {
  const f = e.target.closest('[data-rform]'); if (!f) return; const kind = f.dataset.rform;
  if (!['rnote', 'imsg', 'inote', 'newteam', 'teammember', 'newuser', 'banner', 'broadcast', 'newalert'].includes(kind)) return;
  e.preventDefault(); const v = n => (($(`[name="${n}"]`, f) || {}).value || '').trim(), ok = m => Toast.show(m, { icon: '✓' }), bad = er => Toast.show(Remote.errText(er), { icon: '⚠️', duration: 7000 });
  try {
    if (kind === 'rnote') { const n = v('note'); if (v('req') && !n) return Toast.show('Укажите текст', { icon: '⚠️' }); Modal.close('rmod'); const cb = RescueUI._cb; RescueUI._cb = null; if (cb) await cb(n); }
    else if (kind === 'imsg' || kind === 'inote') { const i = Sel.incident(f.dataset.id), b = v('body'); if (!b) return; await Remote.post('/sos/' + i.sid + '/messages', { body: b, internal: kind === 'inote' }); await Remote.loadIncident(i.sid); }
    else if (kind === 'newteam') { await Remote.post('/rescue/teams', { name: v('name'), channel: v('channel') || undefined, speedKmh: +v('speed') || 4, equipment: v('equip') ? v('equip').split(',').map(s => s.trim()).filter(Boolean) : [] }); await Remote.loadQueue(true); Bus.emit('db'); ok('Команда создана'); }
    else if (kind === 'teammember') { const u = await Remote.get('/admin/users?role=RESCUER&q=' + encodeURIComponent(v('email'))); const x = u.items.find(y => y.email === v('email').toLowerCase()); if (!x) return Toast.show('Спасатель с таким email не найден (роль RESCUER)', { icon: '⚠️' }); await Remote.post('/rescue/teams/' + v('team') + '/members', { userId: x.id }); await Remote.loadQueue(true); Bus.emit('db'); ok('Добавлен в команду'); }
    else if (kind === 'newuser') { await Remote.post('/admin/users', { fullName: v('name'), email: v('email'), password: (($('[name=password]', f) || {}).value || ''), role: v('role') }); await Console.reloadUsers(); ok('Пользователь создан'); }
    else if (kind === 'banner') { await Remote.put('/admin/settings/maintenance_banner', { value: v('text') }); ok('Сохранено'); }
    else if (kind === 'broadcast') { const r = await Remote.post('/admin/broadcast', { title: v('title'), body: v('body'), role: v('role') || undefined }); ok(`Доставлено: ${r.delivered} из ${r.recipients}`); }
    else if (kind === 'newalert') { const lat = v('lat'), lon = v('lon'); await Remote.post('/alerts', { kind: v('kind'), severity: v('severity'), title: v('title'), body: v('body') || undefined, lat: lat ? +lat : undefined, lon: lon ? +lon : undefined, radiusKm: lat ? +v('radius') || 10 : undefined, ttlHours: +v('ttl') || 24, source: v('source'), sourceUrl: v('url') || undefined }); await Console.loadMod(); ok('Предупреждение опубликовано'); }
  } catch (er) { bad(er); }
});
/* селекты, поиск (change/input) */
document.addEventListener('change', async e => {
  const el = e.target, s = el.dataset && el.dataset.sel; if (!s || !Remote.active) return;
  try {
    if (s === 'rPrio') { const i = Sel.incident(el.dataset.id); await Remote.post('/rescue/incidents/' + i.sid + '/priority', { priority: el.value }); await Remote.loadIncident(i.sid); }
    else if (s === 'rFilterPrio') { RescueUI.prio = el.value; RescueUI.load(); }
    else if (s === 'rSort') { RescueUI.sort = el.value; RescueUI.load(); }
    else if (s === 'rTeamAvail') { await Remote.patch('/rescue/teams/' + el.dataset.id, { availability: el.value }); await Remote.loadQueue(); }
    else if (s === 'cuRole') { Console.ur = el.value; Console.reloadUsers(); }
    else if (s === 'cuStatus') { Console.us = el.value; Console.reloadUsers(); }
    else if (s === 'cuSetRole') { await Remote.post('/admin/users/' + el.dataset.id + '/role', { role: el.value }); Toast.show('Роль изменена, сессии пользователя завершены', { icon: '✓' }); Console.reloadUsers(); }
  } catch (er) { Toast.show(Remote.errText(er), { icon: '⚠️', duration: 7000 }); if (Console.users) Console.reloadUsers(); }
});
{ let tm_; document.addEventListener('input', e => { const el = e.target; if (!Remote.active) return; if (el.id === 'rq') { clearTimeout(tm_); tm_ = setTimeout(() => { RescueUI.q = el.value.trim(); RescueUI.load(); }, 350); } if (el.id === 'cuq') { clearTimeout(tm_); tm_ = setTimeout(() => { Console.uq = el.value.trim(); Console.reloadUsers(); }, 350); } }); }

/* ════════ Группа в онлайн-режиме: приглашения, сообщения, рассылка, живые показатели ════════ */
function createGroupCard() {
  return `<div class="card"><div class="sect-t">Создать группу</div><p class="muted-p">Вы станете руководителем: приглашайте туристов, запрашивайте перекличку, ведите журнал.</p><form data-form="createGroup"><div class="form-grid"><div class="field span-2"><label for="gn">Название</label><input id="gn" name="name" placeholder="Поход 9А" maxlength="40"></div><div class="field span-2"><label for="gm">Режим</label><select id="gm" name="mode">${Object.keys(MODES).map(k => `<option value="${k}">${MODES[k][0]}</option>`).join('')}</select></div></div><button class="btn btn-primary btn-block" type="submit">Создать группу</button></form></div>`;
}
function inviteCard(g) {
  if (!g.remote) return inviteCardLocal(g);
  const inv = Remote.inviteCodes[g.id], list = pdata('inv|' + g.id, '/groups/' + g.id + '/invites', r => r.invites) || [];
  return `<div class="card"><div class="row sp"><div><div class="sect-t">Приглашение</div>${inv ? `<div class="mono" style="font-size:38px;font-weight:700;letter-spacing:.14em">${jsq(inv.code)}</div><small class="muted">Код показывается один раз. Действует до ${tm(isoMs(inv.expiresAt))} (${dt(isoMs(inv.expiresAt))}), до ${inv.maxUses} вступлений.</small>` : '<div class="muted-p">Создайте код и передайте его туристам. Коды одноразовые и ограничены по времени.</div>'}</div><div class="col" style="align-items:flex-end">${inv ? `<button class="btn" data-action="copyText" data-t="Присоединяйтесь к группе «${jsq(g.name)}» в Mountain Safe. Код: ${jsq(inv.code)}">${icon('copy', 16)} Копировать</button>` : ''}<button class="btn btn-primary" data-action="invCreate" data-id="${g.id}">${inv ? 'Новый код' : 'Создать код'}</button></div></div>
    <small class="muted">${jsq(MODES[g.mode] ? MODES[g.mode][1] : '')}</small>${list.filter(x => !x.revoked && new Date(x.expiresAt) > new Date() && x.usedCount < x.maxUses).map(x => `<div class="emnum"><span style="flex:1"><small class="muted">действует до ${dt(isoMs(x.expiresAt))} · использовано ${x.usedCount}/${x.maxUses}</small></span><button class="btn btn-sm btn-ghost" data-action="invRevoke" data-gid="${g.id}" data-id="${x.id}">Отозвать</button></div>`).join('')}</div>`;
}
function groupExtras(g, leader) {
  if (!g || !g.remote) return '';
  const msgs = pdata('gm|' + g.id, '/groups/' + g.id + '/messages', r => r.messages) || [], sh = !!Prefs.get().share;
  const live = g.members.filter(m => !m.guest).map(m => `<div class="emnum"><span style="flex:1"><b>${jsq(m.name)}</b> ${m.online ? '<span class="badge dark">онлайн</span>' : '<span class="badge">не в сети</span>'}<br><small class="muted">${m.battery != null ? '🔋' + m.battery + '% · ' : ''}${m.gps ? 'GPS ' + jsq(m.gps) + ' · ' : ''}${m.net ? 'связь ' + jsq(m.net) + ' · ' : ''}${m.lat != null ? `<a href="${osmLink(m.lat, m.lon)}" target="_blank" rel="noopener">${jsq(fmtCoord(m.lat, m.lon))}</a>` : 'позиция не передаётся'} · ${agoTxt(m.seenAt)}</small></span></div>`).join('');
  return `<div class="card"><div class="row sp"><div class="sect-t">Участники в реальном времени</div><span class="badge dark">SSE</span></div>${live}<label class="chk ${sh ? 'on' : ''}" data-action="shareToggle" role="checkbox" aria-checked="${sh}" style="margin-top:8px"><span class="bx">✓</span><span>Передавать мою позицию группе (пока приложение открыто)</span></label><small class="muted">Частота автоматически снижается при слабом заряде, неподвижности и медленной сети.</small></div>
  <div class="card"><div class="sect-t">Сообщения группы</div><div class="chat-msgs" id="gmsgs" style="max-height:260px;overflow:auto">${msgs.map(m => `<div class="msg ${m.userId === Remote.uid ? 'me' : ''}"><div class="bubble">${m.kind === 'broadcast' ? '<b>📣 Рассылка руководителя:</b> ' : `<small class="muted">${jsq(m.name || '')}:</small> `}${jsq(m.body)}</div><small>${tm(isoMs(m.at))}</small></div>`).join('') || '<div class="muted-p" style="text-align:center">Сообщений пока нет</div>'}</div>
  <form data-pform="gmsg" data-id="${g.id}" class="row" style="flex-wrap:nowrap;margin-top:8px"><input name="body" class="sel" placeholder="Сообщение группе" style="flex:1" maxlength="1000"><button class="btn btn-sm btn-primary" type="submit">Отправить</button></form>
