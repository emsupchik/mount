      if (status === 'RESOLVED' && role !== 'owner' && !note && role === 'rescuer') throw E.validation({ note: 'укажите итог операции' });
      const sets = ['status=$2', STAMP[status] + '=now()', 'updated_at=now()']; const vals = [id, status];
      if (status === 'ACKNOWLEDGED' && !i.dispatcher_id) { vals.push(u.id); sets.push('dispatcher_id=$' + vals.length); sets.push('acknowledged_by=$' + vals.length); }
      if (status === 'ACKNOWLEDGED' && i.acknowledged_at) sets.splice(1, 1);                 // повторное ACKNOWLEDGED (возврат) не перезаписывает время первого подтверждения
      if (status === 'RESOLVED' && note) { vals.push(note); sets.push('resolution=$' + vals.length); }
      const r = await q.one('UPDATE sos_incidents SET ' + sets.join(',') + ' WHERE id=$1 RETURNING *', vals);
      await event(q, id, u, 'status', { from: i.status, to: status, note: note || null, by: role });
      if (['RESOLVED', 'CANCELLED'].includes(status) && i.team_id) {
        const other = await q.one("SELECT 1 FROM sos_incidents WHERE team_id=$1 AND id<>$2 AND status IN ('DISPATCHED','IN_PROGRESS')", [i.team_id, id]);
        if (!other) await q.query("UPDATE rescue_teams SET availability='available' WHERE id=$1 AND availability='busy'", [i.team_id]);
      }
      if (['RESOLVED', 'CANCELLED'].includes(status) && i.group_id) await q.query("UPDATE group_members SET member_status='unknown' WHERE group_id=$1 AND user_id=$2 AND member_status='sos'", [i.group_id, i.user_id]);
      return { r, prev: i.status, role };
    });
    const i = res.r;
    log.event('sos', 'status', { incidentId: id, from: res.prev, to: status, role: u.role });
    await audit.log(ctx, 'sos.status.' + status, 'incident', id, { from: res.prev, note: note ? '[provided]' : null });
    bus.publish(tp(i), 'sos.status', { id: i.id, code: i.code, status, priority: i.priority });
    if (i.user_id && res.role !== 'owner') {
      const msg = { ACKNOWLEDGED: 'Диспетчер подтвердил получение вашего SOS.', DISPATCHED: 'Спасательная команда направлена.' + (i.eta_min ? ' Ориентировочное время прибытия: ~' + i.eta_min + ' мин (оценка).' : ''), IN_PROGRESS: 'Спасательная операция идёт.', RESOLVED: 'Инцидент отмечен как завершённый.', CANCELLED: 'Инцидент отменён.' }[status];
      notify.send(i.user_id, { category: 'sos', title: 'SOS ' + i.code + ': ' + ({ ACKNOWLEDGED: 'диспетчер подтвердил', DISPATCHED: 'команда направлена', IN_PROGRESS: 'операция идёт', RESOLVED: 'завершён', CANCELLED: 'отменён' }[status] || status), body: msg, urgent: true, data: { incidentId: i.id, status } }).catch(() => {});
    }
    if (res.role === 'owner' && status === 'CANCELLED') {
      const staff = i.dispatcher_id ? [i.dispatcher_id] : (await db.all("SELECT id FROM users WHERE role='DISPATCHER' AND status='active'")).map(x => x.id);
      notify.sendMany(staff, { category: 'sos', title: 'SOS ' + i.code + ' отменён пользователем', body: 'Пользователь отменил обращение.', data: { incidentId: i.id } }).catch(() => {});
    }
    return S.detail(ctx, id);
  };

  S.setPriority = async (ctx, id, priority) => {
    if (!isStaff(ctx.user)) throw E.forbidden();
    const i = await load(id); if (!OPEN.includes(i.status)) throw E.conflict('Инцидент закрыт', 'incident_closed');
