==================== src/services/friends.js ====================

'use strict';
/* Друзья по коду дружбы.
   - У каждого пользователя постоянный код (8 символов без похожих букв/цифр), его можно перевыпустить.
   - Дружба взаимная: запрос по коду → второй пользователь принимает.
   - Геопозицию друга видно на карте, только если ОН сам включил «Показывать меня друзьям» (по умолчанию выключено).
   - Показывается последняя известная позиция не старше 48 часов; точная история перемещений друзьям не отдаётся. */
const crypto = require('node:crypto');
const { E } = require('../lib/errors');

const ALPHA = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
const newCode = () => { const b = crypto.randomBytes(8); let s = ''; for (let i = 0; i < 8; i++) s += ALPHA[b[i] % ALPHA.length]; return s.slice(0, 4) + '-' + s.slice(4); };
const normCode = c => String(c || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
const pair = (x, y) => (x < y ? [x, y] : [y, x]);
const FRESH_H = 48;

function createFriends({ db, audit, notify, bus }) {
  const F = {};
  async function myCode(uid) {
    const p = await db.one('SELECT friend_code, share_location_friends FROM profiles WHERE user_id=$1', [uid]);
    if (p && p.friend_code) return p;
    for (let i = 0; i < 5; i++) {
      try { return await db.one('UPDATE profiles SET friend_code=$2 WHERE user_id=$1 RETURNING friend_code, share_location_friends', [uid, newCode()]); }
      catch (e) { if (e.code !== '23505') throw e; }
    }
    throw E.unavailable('Не удалось выдать код, попробуйте ещё раз', 'friend_code');
  }
  const person = r => ({ id: r.id, name: r.full_name || 'Пользователь', tag: r.tag || null, photo: r.photo || null });

  F.overview = async (ctx) => {
    const uid = ctx.user.id, me = await myCode(uid);
    const rows = await db.all(`SELECT f.*, CASE WHEN f.user_a=$1 THEN f.user_b ELSE f.user_a END AS other, p.full_name, p.tag, p.share_location_friends AS other_shares
      FROM friendships f JOIN profiles p ON p.user_id = CASE WHEN f.user_a=$1 THEN f.user_b ELSE f.user_a END
      JOIN users u ON u.id = p.user_id AND u.status='active'
      WHERE f.user_a=$1 OR f.user_b=$1 ORDER BY f.created_at DESC`, [uid]);
    const v = r => Object.assign(person({ id: r.other, full_name: r.full_name, tag: r.tag }), { since: r.accepted_at || r.created_at, sharesLocation: r.status === 'accepted' ? !!r.other_shares : undefined });
    return {
      me: { code: me.friend_code, shareLocation: !!me.share_location_friends },
      friends: rows.filter(r => r.status === 'accepted').map(v),
      incoming: rows.filter(r => r.status === 'pending' && r.requested_by !== uid).map(v),
      outgoing: rows.filter(r => r.status === 'pending' && r.requested_by === uid).map(v),
    };
  };

  F.request = async (ctx, code) => {
    const uid = ctx.user.id, c = normCode(code);
    if (c.length !== 8) throw E.validation({ code: 'код из 8 символов, например K7Q4-M2XP' });
    const other = await db.one("SELECT p.user_id, p.full_name FROM profiles p JOIN users u ON u.id=p.user_id AND u.status='active' WHERE replace(p.friend_code,'-','')=$1", [c]);
    if (!other) throw E.notFound('Пользователь с таким кодом не найден');
    if (other.user_id === uid) throw E.validation({ code: 'это ваш собственный код' });
    const [a, b] = pair(uid, other.user_id);
    const ex = await db.one('SELECT * FROM friendships WHERE user_a=$1 AND user_b=$2', [a, b]);
    if (ex && ex.status === 'accepted') return { status: 'already_friends' };
    if (ex && ex.requested_by !== uid) {                       // встречный запрос → сразу дружба
      await db.query("UPDATE friendships SET status='accepted', accepted_at=now() WHERE user_a=$1 AND user_b=$2", [a, b]);
      notify.send(other.user_id, { category: 'community', title: 'Запрос в друзья принят', body: 'Теперь вы друзья в Mountain Safe', data: { friendId: uid } }).catch(() => {});
      await audit.log(ctx, 'friend.accepted', 'user', other.user_id);
      return { status: 'accepted' };
    }
    if (ex) return { status: 'pending' };
    const pending = await db.one("SELECT count(*)::int n FROM friendships WHERE requested_by=$1 AND status='pending'", [uid]);
    if (pending.n >= 50) throw E.conflict('Слишком много неотвеченных запросов', 'too_many_requests');
    await db.query('INSERT INTO friendships(user_a,user_b,requested_by) VALUES($1,$2,$3)', [a, b, uid]);
    const me = await db.one('SELECT full_name FROM profiles WHERE user_id=$1', [uid]);
    notify.send(other.user_id, { category: 'community', title: 'Запрос в друзья', body: (me && me.full_name ? me.full_name : 'Пользователь') + ' хочет добавить вас в друзья', data: { friendId: uid } }).catch(() => {});
    await audit.log(ctx, 'friend.requested', 'user', other.user_id);
    return { status: 'pending' };
  };

  async function row(uid, otherId) { const [a, b] = pair(uid, otherId); const r = await db.one('SELECT * FROM friendships WHERE user_a=$1 AND user_b=$2', [a, b]); return { r, a, b }; }
  F.accept = async (ctx, otherId) => {
    const { r, a, b } = await row(ctx.user.id, otherId);
    if (!r || r.status !== 'pending' || r.requested_by === ctx.user.id) throw E.notFound('Запрос не найден');
    await db.query("UPDATE friendships SET status='accepted', accepted_at=now() WHERE user_a=$1 AND user_b=$2", [a, b]);
    notify.send(otherId, { category: 'community', title: 'Запрос в друзья принят', body: 'Теперь вы друзья в Mountain Safe', data: { friendId: ctx.user.id } }).catch(() => {});
    await audit.log(ctx, 'friend.accepted', 'user', otherId);
    return { status: 'accepted' };
  };
  F.remove = async (ctx, otherId) => {
    const { r, a, b } = await row(ctx.user.id, otherId); if (!r) throw E.notFound('Нет такой дружбы или запроса');
    await db.query('DELETE FROM friendships WHERE user_a=$1 AND user_b=$2', [a, b]);
    await audit.log(ctx, r.status === 'accepted' ? 'friend.removed' : 'friend.request_cancelled', 'user', otherId);
    return { removed: true };
  };
  F.settings = async (ctx, d) => {
    if (d.regenerateCode) await db.query('UPDATE profiles SET friend_code=NULL WHERE user_id=$1', [ctx.user.id]);
    if (typeof d.shareLocation === 'boolean') { await db.query('UPDATE profiles SET share_location_friends=$2 WHERE user_id=$1', [ctx.user.id, d.shareLocation]); await audit.log(ctx, 'friend.share_location', 'user', ctx.user.id, { on: d.shareLocation }); }
    return (await F.overview(ctx)).me;
  };
  /* позиции друзей: только принятая дружба + друг сам разрешил показывать себя + позиция не старше 48 ч */
  F.locations = async (ctx) => (await db.all(`SELECT p.user_id, p.full_name, p.tag, d.lat, d.lon, d.accuracy, d.altitude, d.battery, d.location_at
      FROM friendships f JOIN profiles p ON p.user_id = CASE WHEN f.user_a=$1 THEN f.user_b ELSE f.user_a END
      JOIN users u ON u.id=p.user_id AND u.status='active'
      JOIN device_states d ON d.user_id=p.user_id
      WHERE (f.user_a=$1 OR f.user_b=$1) AND f.status='accepted' AND p.share_location_friends AND d.lat IS NOT NULL AND d.location_at > now() - ($2 || ' hours')::interval`, [ctx.user.id, String(FRESH_H)]))
    .map(r => ({ id: r.user_id, name: r.full_name || 'Друг', tag: r.tag, lat: r.lat, lon: r.lon, accuracy: r.accuracy, altitude: r.altitude, battery: r.battery, at: r.location_at }));
  F.normCode = normCode;
  return F;
}
module.exports = { createFriends };


