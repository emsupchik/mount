  /* ═════════════ #/nav/to — маршрут до любой точки ═════════════ */
  const Dest = {
    q: '', target: null, model: null, from: null, busy: false, err: '', straight: false,
    async here() {
      const f = GeoSvc.cur() && Date.now() - GeoSvc.cur().ts < 5 * 60000 ? GeoSvc.cur() : null; if (f) return f;
      try { return await GS.getCurrentPosition({ maxWaitMs: 20000, targetAccM: 50 }); } catch (e) { return GS.getLastKnownPosition(); }
    },
    list() {
