    snapCheckpoint(c, P) { const pr = Geo.project({ lat: c.lat, lon: c.lon }, P.pts, P.cum); return { ...c, km: pr ? round(pr.km, 3) : null, offRouteM: pr ? Math.round(pr.deviationM) : null }; },
    /* Точка на маршруте по км */
