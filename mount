const KIND_RU = { peak: 'Вершина', lake: 'Озеро', pass: 'Перевал', campsite: 'Кемпинг', camp: 'Стоянка', rest: 'Место привала', water: 'Вода', emergency: 'Экстренная точка', shelter: 'Укрытие', connectivity: 'Точка связи', ski_resort: 'Горнолыжный курорт', landmark: 'Ориентир' };
