  assert.equal(low.level, 'low'); assert.ok(low.reasons.includes('группа состоит из одного человека'));
  const high = Engine.calculateRouteRisk({ durationHours: 96, participants: 5, overnights: 3, equipment: { ...ALL, mobile: false }, startDate: '2026-07-10' });
  assert.equal(high.level, 'high'); assert.ok(high.reasons.some(r => /4 дня/.test(r))); assert.ok(high.reasons.some(r => /нет мобильной/.test(r)));
