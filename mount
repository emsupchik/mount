'use strict';
/* Друзья по коду и геопозиция на карте; треки каталога из OSM и сводка маршрута. */
const { test, before, after } = require('node:test');
const assert = require('node:assert/strict');
const { makeEnv, client, signup } = require('./helpers');

let env; before(async () => { env = await makeEnv(); }); after(() => env.close());

test('код дружбы → запрос → принятие; позицию видно только если друг сам разрешил', async () => {
  const a = await signup(env), b = await signup(env), c = await signup(env);
  const A = (await a.get('/api/v1/friends')).body, B = (await b.get('/api/v1/friends')).body;
  assert.match(A.me.code, /^[A-Z2-9]{4}-[A-Z2-9]{4}$/); assert.notEqual(A.me.code, B.me.code); assert.equal(A.me.shareLocation, false);
  assert.equal((await a.post('/api/v1/friends/request', { code: A.me.code })).status, 422);                 // свой код
  assert.equal((await a.post('/api/v1/friends/request', { code: 'ZZZZ-ZZZZ' })).status, 404);
  assert.equal((await a.post('/api/v1/friends/request', { code: B.me.code.toLowerCase().replace('-', ' ') })).body.status, 'pending');
  const inc = (await b.get('/api/v1/friends')).body.incoming; assert.equal(inc.length, 1);
  assert.equal((await c.post(`/api/v1/friends/${inc[0].id}/accept`)).status, 404);                          // чужой запрос не принять
  assert.equal((await b.post(`/api/v1/friends/${inc[0].id}/accept`)).body.status, 'accepted');
  assert.equal((await a.get('/api/v1/friends')).body.friends.length, 1);
  // позиция b: есть в device_states, но b не разрешил показывать себя
  await b.post('/api/v1/device/state', { lat: 43.15, lon: 77.06, accuracy: 15 });
  assert.equal((await a.get('/api/v1/friends/locations')).body.friends.length, 0);
  await b.patch('/api/v1/friends/settings', { shareLocation: true });
  const L = (await a.get('/api/v1/friends/locations')).body.friends; assert.equal(L.length, 1); assert.equal(L[0].lat, 43.15);
  assert.equal((await c.get('/api/v1/friends/locations')).body.friends.length, 0);                          // не друг — не видит
  assert.equal((await client(env).get('/api/v1/friends/locations')).status, 401);
  // удаление дружбы — позиция больше не видна
  const bId = (await a.get('/api/v1/friends')).body.friends[0].id; assert.equal((await a.del('/api/v1/friends/' + bId)).status, 200);
  const bid = (await a.get('/api/v1/friends')).body.friends; assert.equal(bid.length, 0);
  assert.equal((await a.get('/api/v1/friends/locations')).body.friends.length, 0);
  // перевыпуск кода
  const old = (await b.get('/api/v1/friends')).body.me.code; const nw = (await b.patch('/api/v1/friends/settings', { regenerateCode: true })).body.me.code;
  assert.notEqual(old, nw); assert.equal((await c.post('/api/v1/friends/request', { code: old })).status, 404);
});

