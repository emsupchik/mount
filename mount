.sim-legend span{display:inline-flex;align-items:center;gap:6px}
.sim-legend i{display:inline-block;width:12px;height:12px;border-radius:50%}
.lg-cur{background:#2f7bd8;border:2px solid #fff}.lg-pre{border:2px dashed #6ee7b7}.lg-exp{background:rgba(245,154,74,.55);border-radius:3px!important;height:6px!important}.lg-sig{border-top:2px dotted #a78bfa;border-radius:0!important;height:0!important;width:14px!important}
.sim-demo-tag{position:absolute;right:12px;bottom:26px;z-index:500;font:700 10.5px var(--label);letter-spacing:.14em;padding:5px 9px;border-radius:6px;background:rgba(245,197,66,.14);color:#f5c542;border:1px solid #7a6420}
