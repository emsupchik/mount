/* SSE-клиент: подключается по одноразовому билету, собирает события */
async function sse(env, c) {
  const t = (await c.post('/api/v1/stream/ticket')).body.ticket;
  const ac = new AbortController();
  const res = await fetch(env.base + '/api/v1/stream?ticket=' + encodeURIComponent(t), { signal: ac.signal });
  if (res.status !== 200) { ac.abort(); return { status: res.status, close() {} }; }
  const events = [], waiters = [];
  (async () => {
    const dec = new TextDecoder(); let buf = '';
    try { for await (const chunk of res.body) { buf += dec.decode(chunk, { stream: true }); let i; while ((i = buf.indexOf('\n\n')) >= 0) { const block = buf.slice(0, i); buf = buf.slice(i + 2); const ev = /event: (.+)/.exec(block), da = /data: (.+)/.exec(block); if (ev && da) { const e = { type: ev[1], data: JSON.parse(da[1]) }; events.push(e); waiters.slice().forEach(w => w(e)); } } } } catch (e) { /* aborted */ }
  })();
  const api = {
    status: 200, events, close: () => ac.abort(),
    wait(type, pred = () => true, ms = 3000) {
      const found = events.find(e => e.type === type && pred(e.data)); if (found) return Promise.resolve(found);
      return new Promise((ok, bad) => { const to = setTimeout(() => { const i = waiters.indexOf(w); if (i >= 0) waiters.splice(i, 1); bad(new Error('SSE timeout waiting for ' + type + '; got ' + events.map(e => e.type).join(','))); }, ms); const w = e => { if (e.type === type && pred(e.data)) { clearTimeout(to); const i = waiters.indexOf(w); if (i >= 0) waiters.splice(i, 1); ok(e); } }; waiters.push(w); });
    },
    none: async (type, ms = 400) => { await new Promise(r => setTimeout(r, ms)); return !events.some(e => e.type === type); },
  };
  await api.wait('ready'); return api;
}
module.exports.sse = sse;


