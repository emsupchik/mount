# ── Прочее ───────────────────────────────────────────────────────────────────
ACCESS_TTL_SEC=900            # время жизни access-токена
REFRESH_TTL_SEC=2592000       # 30 дней
ACCOUNT_GRACE_DAYS=30         # срок восстановления удалённого аккаунта
DB_POOL_MAX=10
JOBS_ENABLED=true             # фоновые задачи (просрочка, check-in, очистка); безопасно на нескольких экземплярах
