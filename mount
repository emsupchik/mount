.sim-eyebrow{display:inline-flex;align-items:center;gap:6px;margin-bottom:8px;padding:5px 11px;border:1px solid var(--line-2);border-radius:999px;font:600 11.5px var(--label);letter-spacing:.12em;text-transform:uppercase;color:var(--accent);background:rgba(110,231,183,.06)}
