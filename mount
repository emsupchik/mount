const TNAV = [['sos', 'SOS', 'alert'], ['location', 'Локация', 'pin'], ['prep', 'Подготовка', 'list'], ['routes', 'Горы Алматы', 'mountain'], ['route', 'Мой маршрут', 'route'], ['sim', 'Симуляция', 'gauge'], ['weather', 'Погода', 'cloud'], ['memos', 'Памятки', 'book'], ['learn', 'Обучение', 'cap'], ['group', 'Группа', 'users'], ['card', 'Карточка', 'card']];
const TOURIST_ROUTES = TNAV.map(x => x[0]).concat(['track']);
const pageHead = (t, p, extra = '') => `<div class="sec-head page-head"><div><h1>${t}</h1>${p ? `<p>${p}</p>` : ''}</div>${extra}</div>`;
const demoBadge = '<span class="badge demo">ДЕМО</span>';
const numsCard = () => `<div class="card flat"><div class="sect-t">Экстренные номера</div>${EMERGENCY_NUMBERS.map(x => `<div class="emnum"><b class="n">${x.n}</b><span class="muted-p" style="flex:1">${x.t}</span><a class="btn btn-sm" href="tel:${x.n}">Позвонить</a></div>`).join('')}<small class="muted">Номера для Казахстана. Проверьте номера своего региона. Ссылка на звонок может не сработать в этом окне.</small></div>`;

/* ── связь и геопозиция ── */
const Conn = {
  pingOk: null,   // результат реальной проверки связи (см. NetWatch.ping); null = не проверяли
  sim() { return Local.get('ms_sim') || 'auto'; },
  state() { const s = this.sim(); if (s !== 'auto') return s; if (navigator.onLine === false || this.pingOk === false) return 'offline'; const c = navigator.connection; if (c && (/(^|-)2g/.test(c.effectiveType || '') || c.saveData)) return 'weak'; return 'online'; },
  meta: { online: { t: 'ONLINE', c: 'ok' }, weak: { t: 'WEAK', c: 'warn' }, offline: { t: 'OFFLINE', c: 'crit' } },
  pill() { const m = this.meta[this.state()]; return `<button class="pill conn" data-action="openConn" title="Состояние связи"><span class="dot ${m.c}"></span>${m.t}</button>`; },
  open() {
