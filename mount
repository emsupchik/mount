document.addEventListener('submit', async e => {
  const f = e.target.closest('[data-pform="report"]'); if (!f) return; e.preventDefault(); const v = n => (($(`[name="${n}"]`, f) || {}).value || '').trim(), btn = $('button[type=submit]', f); setBusy(btn, true);
  try {
    const b = { kind: v('kind'), body: v('body') || undefined, observedAt: v('observedAt') ? new Date(v('observedAt')).toISOString() : undefined }; if (v('routeId')) b.routeId = v('routeId');
    const fix = GeoSvc.cur(); if ($('#repUse') && $('#repUse').getAttribute('aria-checked') === 'true' && fix && !GeoSvc.demo()) { b.lat = fix.lat; b.lon = fix.lon; }
