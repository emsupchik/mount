  { type: 'way', id: 301, center: { lat: 43.129, lon: 77.082 }, tags: { aerialway: 'chair_lift', name: 'Л1' } },
  { type: 'way', id: 401, center: { lat: 43.127, lon: 77.080 }, tags: { 'piste:type': 'downhill', 'piste:difficulty': 'easy' } },
] };

