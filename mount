  return ['MOUNTAIN SAFE — СООБЩЕНИЕ СПАСАТЕЛЯМ', 'Время: ' + tm(Date.now()), 'Что случилось: ' + I.t, 'Пострадавший: ' + (SA.who[a.who] || 'не указано'), 'Может двигаться: ' + (SA.move[a.move] || 'не указано'), 'Опасность на месте: ' + (SA.danger[a.danger] || 'не указано'), 'Связь: ' + (SA.comm[a.comm] || 'не указано'),
    'Координаты: ' + (a.where || 'неизвестны, опишу ориентиры') + (P.gps && a.where && a.where.indexOf(fmtCoord(P.gps.lat, P.gps.lon)) === 0 ? ` (точность ±${P.gps.acc} м, ${tm(P.gps.ts)})` : ''), 'Группа: ' + (g ? g.name + ', ' + g.members.length + ' чел.' : 'нет'), 'Маршрут: ' + c.route, 'Старт: ' + c.start, 'Контакт: ' + c.cname + ' ' + c.cphone].join('\n');
}
const smsHref = t => 'sms:' + String(Prefs.get().card.cphone || '').replace(/[^\d+]/g, '') + '?&body=' + encodeURIComponent(t);
async function shareText(t) { if (navigator.share) { try { await navigator.share({ text: t }); return; } catch (e) { if (e && e.name === 'AbortError') return; } } copyText(t); }
async function copyText(t) { try { await navigator.clipboard.writeText(t); Toast.show('Скопировано', { icon: '📋' }); } catch (e) { try { const ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); Toast.show('Скопировано', { icon: '📋' }); } catch (e2) { Toast.show('Выделите текст и скопируйте вручную', { icon: '📋' }); } } }

const Stress = {
  st: null,
  start(inc, preset) {
    const P = Prefs.get(); this.st = { a: Object.assign({ inc: inc || null, danger: null, who: null, move: null, comm: null, where: GeoSvc.whereText() || P.card.coords || '' }, preset || {}), q: inc ? 1 : 0, pi: 0, phase: 'ask' };
