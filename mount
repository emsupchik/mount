.map{height:340px;border-radius:16px;border:1px solid var(--line);overflow:hidden;background:#0f1a16;position:relative;z-index:0}
.leaflet-container{font-family:var(--font);background:#0f1a16;outline:0}
.leaflet-tile-pane{filter:invert(1) hue-rotate(180deg) saturate(.55) brightness(.82) contrast(.95)}
.leaflet-control-attribution{background:rgba(10,19,16,.8)!important;color:#a3c2b3!important}.leaflet-control-attribution a{color:var(--accent)!important}
.leaflet-bar a,.leaflet-bar a:hover{background:var(--surface);color:var(--ink);border-bottom-color:var(--line-2)}
.leaflet-touch .leaflet-bar{border:1px solid var(--line-2)}
.rcard .demoline{background:#efe9ff;color:#3b1f8f;padding:8px 10px;border-radius:8px;font-weight:600;font-size:14px}
.tabbar button{display:flex;flex-direction:column;align-items:center;gap:1px;padding:6px 2px;font:500 10.5px var(--label);color:var(--ink-3);border-radius:10px}
