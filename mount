const barChart = (rows, key, label, unit) => {
  if (!rows.length) return '<div class="muted-p">Нет данных</div>';
  const W = 560, H = 170, pad = 26, max = Math.max(...rows.map(r => r[key]), 1), bw = Math.min(46, (W - pad * 2) / rows.length - 6);
  return `<svg viewBox="0 0 ${W} ${H + 24}" role="img" aria-label="${jsq(label)}" style="width:100%;height:auto">${rows.map((r, i) => { const h = Math.max(2, Math.round(r[key] / max * (H - 26))), x = pad + i * ((W - pad * 2) / rows.length) + 3; return `<g><rect x="${x}" y="${H - h}" width="${bw}" height="${h}" rx="5" fill="var(--accent)" opacity=".85"><title>${jsq(r.m || r.y)}: ${r[key]} ${unit}</title></rect><text x="${x + bw / 2}" y="${H - h - 5}" text-anchor="middle" font-size="11" fill="currentColor">${r[key]}</text><text x="${x + bw / 2}" y="${H + 14}" text-anchor="middle" font-size="10" fill="currentColor" opacity=".7">${jsq(String(r.m || r.y).slice(-5))}</text></g>`; }).join('')}</svg>`;
};
