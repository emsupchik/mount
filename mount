#!/bin/sh
# Резервная копия PostgreSQL с ротацией. Запуск: DATABASE_URL=... BACKUP_DIR=/var/backups/mountain-safe sh scripts/backup.sh
# Рекомендуется cron: 15 3 * * *  (раз в сутки), плюс WAL-архивация для восстановления на момент времени (см. docs/BACKUP.md).
set -eu
: "${DATABASE_URL:?DATABASE_URL не задан}"
DIR="${BACKUP_DIR:-./backups}"; KEEP_DAILY="${KEEP_DAILY:-14}"; KEEP_WEEKLY="${KEEP_WEEKLY:-8}"; KEEP_MONTHLY="${KEEP_MONTHLY:-12}"
mkdir -p "$DIR/daily" "$DIR/weekly" "$DIR/monthly"; umask 077
STAMP=$(date -u +%Y%m%dT%H%M%SZ); OUT="$DIR/daily/ms-$STAMP.dump"
pg_dump --format=custom --no-owner --no-privileges "$DATABASE_URL" > "$OUT.tmp"
pg_restore --list "$OUT.tmp" > /dev/null          # проверка, что дамп читается
mv "$OUT.tmp" "$OUT"; sha256sum "$OUT" > "$OUT.sha256"
[ "$(date -u +%u)" = "7" ] && cp "$OUT" "$OUT.sha256" "$DIR/weekly/"
[ "$(date -u +%d)" = "01" ] && cp "$OUT" "$OUT.sha256" "$DIR/monthly/"
# ротация
prune() { ls -1t "$1"/ms-*.dump 2>/dev/null | tail -n +"$(( $2 + 1 ))" | while read -r f; do rm -f "$f" "$f.sha256"; done; }
prune "$DIR/daily" "$KEEP_DAILY"; prune "$DIR/weekly" "$KEEP_WEEKLY"; prune "$DIR/monthly" "$KEEP_MONTHLY"
echo "Backup OK: $OUT"
# Шифрование и вынос за пределы сервера (пример): gpg --encrypt -r backup@your-domain "$OUT" && rclone copy "$OUT.gpg" remote:mountain-safe/


