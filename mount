'use strict';
const crypto = require('node:crypto');
const { AppError, E } = require('./lib/errors');
const { parse } = require('./lib/validate');

/* Маршрутизатор без зависимостей. Каждый маршрут описывает: метод, путь, требования к аутентификации/ролям,
   лимит запросов и схему тела/query. Проверка прав выполняется здесь на сервере, независимо от клиента. */
class Router {
  constructor() { this.routes = []; }
  add(method, pattern, opts, handler) {
    if (typeof opts === 'function') { handler = opts; opts = {}; }
    const keys = []; const re = new RegExp('^' + pattern.replace(/:([A-Za-z]+)/g, (_, k) => { keys.push(k); return '([^/]+)'; }) + '/?$');
    this.routes.push({ method, pattern, re, keys, opts: Object.assign({ auth: 'user' }, opts), handler });
    return this;
  }
  get(p, o, h) { return this.add('GET', p, o, h); }
  post(p, o, h) { return this.add('POST', p, o, h); }
  put(p, o, h) { return this.add('PUT', p, o, h); }
  patch(p, o, h) { return this.add('PATCH', p, o, h); }
  del(p, o, h) { return this.add('DELETE', p, o, h); }
  match(method, pathname) {
    let pathMatched = false;
    for (const r of this.routes) {
      const m = r.re.exec(pathname); if (!m) continue;
      pathMatched = true; if (r.method !== method) continue;
      const params = {}; r.keys.forEach((k, i) => { try { params[k] = decodeURIComponent(m[i + 1]); } catch (e) { params[k] = m[i + 1]; } });
      return { route: r, params };
    }
    return { route: null, pathMatched };
  }
}

function readBody(req, limit) {
  return new Promise((ok, bad) => {
    let n = 0, over = false; const ch = [];
    req.on('data', c => { if (over) return; n += c.length; if (n > limit) { over = true; bad(new AppError(413, 'payload_too_large', 'Слишком большой запрос')); return; } ch.push(c); });
    req.on('end', () => {
      if (over) return; if (!ch.length) return ok({});
      const ct = String(req.headers['content-type'] || '');
      if (!/application\/json/i.test(ct)) return bad(new AppError(415, 'unsupported_media_type', 'Ожидается application/json'));
      try { const b = JSON.parse(Buffer.concat(ch).toString('utf8')); ok(b); } catch (e) { bad(E.badRequest('Некорректный JSON')); }
    });
    req.on('error', bad);
  });
}

function clientIp(req, trustProxy) {
  if (trustProxy && req.headers['x-forwarded-for']) return String(req.headers['x-forwarded-for']).split(',')[0].trim();
  return req.socket.remoteAddress || '';
}

function parseCookies(h) { const o = {}; String(h || '').split(';').forEach(p => { const i = p.indexOf('='); if (i > 0) o[p.slice(0, i).trim()] = decodeURIComponent(p.slice(i + 1).trim()); }); return o; }

module.exports = { Router, readBody, clientIp, parseCookies, parse };


