#!/usr/bin/env python3
"""Mountain Safe — построение треков каталога «Горы Алматы» по реальным данным:
   якоря — объекты OpenStreetMap (ссылки в A), трасса — пеший маршрутизатор Valhalla (FOSSGIS) по тропам OSM,
   высоты — Open-Meteo Elevation (Copernicus DEM). Результат: src/db/seed/catalog-tracks.json (сервер ставит его при запуске,
   только маршрутам без геометрии). Это не записанные GPS-треки — в источнике так и написано.
   Запуск: python3 scripts/build-catalog-tracks.py   (удалите маршрут из json, чтобы перестроить его)"""
import json, sys, urllib.request
def dec6(s):
    i=lat=lon=0; out=[]
    while i<len(s):
        r=sh=0
        while True:
            b=ord(s[i])-63; i+=1; r|=(b&31)<<sh; sh+=5
            if b<32: break
        lat+=~(r>>1) if r&1 else r>>1
        r=sh=0
        while True:
            b=ord(s[i])-63; i+=1; r|=(b&31)<<sh; sh+=5
            if b<32: break
        lon+=~(r>>1) if r&1 else r>>1
        out.append((lat/1e6,lon/1e6))
    return out
def route(pts):
    body={'locations':[{'lat':a,'lon':b} for a,b in pts],'costing':'pedestrian','costing_options':{'pedestrian':{'max_hiking_difficulty':6,'use_hills':1}},'directions_options':{'units':'kilometers'}}
    r=urllib.request.Request('https://valhalla1.openstreetmap.de/route',data=json.dumps(body).encode(),headers={'Content-Type':'application/json','User-Agent':'MountainSafe-dev/1.0'})
    try: j=json.load(urllib.request.urlopen(r,timeout=60))
    except Exception as e: return None, str(e)
    c=[]
    for n,leg in enumerate(j['trip']['legs']):
        d=dec6(leg['shape']); c+= d[1:] if n else d
    return c, j['trip']['summary']
if False:  # (тестовый запуск отключён)
    specs=json.loads(sys.argv[1])
    for k,pts in specs.items():
        c,s=route(pts); print(k, 'FAIL '+s if c is None else '%d pts %.2f km %d min'%(len(c),s['length'],s['time']/60), flush=True)

def nominatim_way_coords(q):
