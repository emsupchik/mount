'use strict';
/* Оповещение дежурного диспетчера о новом SOS по внешним каналам (email + SMS) и журнал доставки.
   Адреса берутся ТОЛЬКО из переменных окружения DISPATCH_EMAIL / DISPATCH_PHONE (не из фронтенда и не из БД).
   Статус каждой отправки хранится в dispatch_notifications: SENT — только после успешного ответа провайдера. */
const { E } = require('../lib/errors');
const { mask } = require('./notifications');

const SIT_RU = { bleeding: 'Кровотечение', fracture: 'Перелом / травма', unconscious: 'Без сознания', hypothermia: 'Переохлаждение', heat: 'Перегрев', lost: 'Потерялся', breath: 'Проблемы с дыханием', fall: 'Падение', storm: 'Непогода', animal: 'Животное', nocomm: 'Нет связи с группой', other: 'Другое', missing: 'Пропал участник', burn: 'Ожог', bruise: 'Ушиб', sprain: 'Растяжение' };

function createDispatch({ cfg, db, log, bus, notifications }) {
  const D = {};
  const fmtTime = d => d ? new Date(d).toISOString().replace('T', ' ').slice(0, 19) + ' UTC' : '—';
  const link = id => (cfg.publicUrl || 'http://localhost:' + cfg.port) + '/#/admin/incidents/' + id;

  /* Последние точки движения пользователя (не старше 3 ч): для понимания, куда он шёл */
  async function lastMovement(userId) {
    if (!userId) return null;
    const pts = await db.all("SELECT lat, lon, altitude, speed, ts FROM gps_points WHERE user_id=$1 AND ts > now() - interval '3 hours' ORDER BY ts DESC LIMIT 5", [userId]);
    if (!pts.length) { const d = await db.one('SELECT lat, lon, altitude, location_at ts FROM device_states WHERE user_id=$1 AND lat IS NOT NULL', [userId]); return d ? [{ lat: d.lat, lon: d.lon, altitude: d.altitude, ts: d.ts }] : null; }
    return pts;
  }

  D.compose = async (incidentId) => {
    const i = await db.one('SELECT * FROM sos_incidents WHERE id=$1', [incidentId]); if (!i) throw E.notFound('Инцидент не найден');
    const g = i.group_id ? await db.one('SELECT name FROM groups WHERE id=$1', [i.group_id]) : null;
    const mv = await lastMovement(i.user_id);
    const coords = i.lat != null ? `${(+i.lat).toFixed(6)}, ${(+i.lon).toFixed(6)}` + (i.accuracy != null ? ` (±${Math.round(i.accuracy)} м)` : '') : 'НЕТ КООРДИНАТ (устройство не передало позицию)';
    const routeName = i.route && (i.route.name || i.route.title) || '—';
    const movement = mv && mv.length ? mv.map(p => `  ${fmtTime(p.ts)}  ${(+p.lat).toFixed(5)}, ${(+p.lon).toFixed(5)}${p.altitude != null ? '  ' + Math.round(p.altitude) + ' м' : ''}${p.speed != null ? '  ' + (p.speed * 3.6).toFixed(1) + ' км/ч' : ''}`).join('\n') : '  нет данных';
    const maps = i.lat != null ? `https://www.openstreetmap.org/?mlat=${i.lat}&mlon=${i.lon}#map=16/${i.lat}/${i.lon}` : '';
    const subject = '🚨 MOUNTAIN SAFE — NEW SOS INCIDENT ' + i.code;
    const text = [
      'NEW SOS ALERT', '',
      'Incident:', `${i.code} · priority ${i.priority} · ${SIT_RU[i.situation] || i.situation}`, '',
      'Tourist:', `${i.reporter_name || 'Турист'}${i.reporter_phone ? ' · ' + i.reporter_phone : ''}`, '',
      'Time:', fmtTime(i.client_created_at || i.received_at) + (i.client_created_at ? ' (нажато на устройстве), получено сервером ' + fmtTime(i.received_at) : ''), '',
      'Location:', i.lat != null ? maps : 'неизвестно', '',
      'Coordinates:', coords, '',
      'Altitude:', i.altitude != null ? Math.round(i.altitude) + ' m' : '—', '',
      'Battery:', i.battery != null ? i.battery + '%' : '—', '',
      'Connectivity:', i.connection || '—', '',
      'Route:', routeName, '',
      'Group:', g ? g.name : '—', '',
      'Medical profile:', i.medical_enc ? 'available to authorized dispatcher in dashboard' : 'not provided', '',
      'Last known movement:', movement, '',
      'Description:', i.description || '—', '',
      'Open incident:', link(i.id), '',
      '— Mountain Safe. Это автоматическое уведомление. Статусы «подтверждено» и «команда направлена» появляются только после действий диспетчера в системе.',
    ].join('\n');
    const sms = `MOUNTAIN SAFE SOS ${i.code} ${i.priority}: ${(i.reporter_name || 'Турист').slice(0, 30)}, ${SIT_RU[i.situation] || i.situation}. ${i.lat != null ? (+i.lat).toFixed(5) + ',' + (+i.lon).toFixed(5) : 'без координат'}${i.altitude != null ? ' ' + Math.round(i.altitude) + 'м' : ''}${i.battery != null ? ' бат.' + i.battery + '%' : ''}. ${link(i.id)}`;
    return { i, subject, text, sms };
  };

  async function record(incidentId, channel, target, r) {
    const row = await db.one(`INSERT INTO dispatch_notifications(incident_id,channel,target,provider,status,provider_message_id,error,attempts,sent_at)
      VALUES($1,$2,$3,$4,$5,$6,$7,1,CASE WHEN $5='SENT' THEN now() END) RETURNING *`, [incidentId, channel, mask(target || '—'), r.provider || 'none', r.status, r.id || null, r.error || null]);
    log.event('dispatch', 'notify', { incidentId, channel, status: r.status, provider: r.provider });
    bus.publish('staff', 'dispatch.notification', view(row));
    return row;
  }
  const view = n => ({ id: n.id, incidentId: n.incident_id, channel: n.channel, target: n.target, provider: n.provider, status: n.status, providerMessageId: n.provider_message_id, error: n.error, attempts: n.attempts, createdAt: n.created_at, sentAt: n.sent_at });

  /* Вызывается после создания SOS. Никогда не бросает: ошибка доставки не должна мешать созданию инцидента. */
  D.onSosCreated = async (incidentId) => {
    try {
      const m = await D.compose(incidentId);
      const [em, sm] = await Promise.all([
        notifications.sendEmail({ to: cfg.dispatch.email, subject: m.subject, text: m.text }),
        notifications.sendSMS({ to: cfg.dispatch.phone, text: m.sms }),
      ]);
      await record(incidentId, 'email', cfg.dispatch.email, em);
      await record(incidentId, 'sms', cfg.dispatch.phone, sm);
    } catch (e) { log.error({ err: e, incidentId }, 'dispatch notification failed'); }
  };

  D.list = async (incidentId) => (await db.all('SELECT * FROM dispatch_notifications WHERE incident_id=$1 ORDER BY created_at', [incidentId])).map(view);

  /* Повторная отправка неуспешного уведомления (диспетчер нажал «Повторить») */
  D.retry = async (ctx, id) => {
    const n = await db.one('SELECT * FROM dispatch_notifications WHERE id=$1', [id]); if (!n) throw E.notFound('Уведомление не найдено');
    if (n.status === 'SENT') return view(n);
    const m = await D.compose(n.incident_id);
    const r = n.channel === 'email' ? await notifications.sendEmail({ to: cfg.dispatch.email, subject: m.subject, text: m.text }) : await notifications.sendSMS({ to: cfg.dispatch.phone, text: m.sms });
    const row = await db.one("UPDATE dispatch_notifications SET status=$2, provider=$3, provider_message_id=$4, error=$5, attempts=attempts+1, sent_at=CASE WHEN $2='SENT' THEN now() ELSE sent_at END, updated_at=now() WHERE id=$1 RETURNING *", [id, r.status, r.provider || n.provider, r.id || null, r.error || null]);
    bus.publish('staff', 'dispatch.notification', view(row));
    return view(row);
  };

  D.config = () => ({ email: { target: cfg.dispatch.email ? mask(cfg.dispatch.email) : null, ...notifications.status().email }, sms: { target: cfg.dispatch.phone ? mask(cfg.dispatch.phone) : null, ...notifications.status().sms }, push: notifications.status().push });
  return D;
}
module.exports = { createDispatch };


