.sim-pk{background:rgba(10,19,16,.55);color:#6ee7b7;border:2px dashed #6ee7b7;box-shadow:0 0 0 4px rgba(110,231,183,.12)}
.sim-plabel{width:max-content;transform:translate(18px,-34px);white-space:nowrap;font:700 11px var(--label);letter-spacing:.06em;padding:4px 8px;border-radius:6px;background:#6ee7b7;color:#04140d;box-shadow:var(--shadow-sm)}
.sim-shelter{width:max-content;transform:translate(-115%,-50%);white-space:nowrap;font:700 11px var(--label);letter-spacing:.1em;padding:4px 8px;border-radius:6px;background:#04140d;color:#6ee7b7;border:1.5px solid #6ee7b7}
.leaflet-tooltip.sim-tt{background:rgba(10,19,16,.9);color:var(--ink);border:1px solid var(--line-2);box-shadow:none;font:600 11px var(--label)}
