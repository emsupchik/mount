  const FACTOR_NAME = { weather: { en: 'Weather deterioration', ru: 'Ухудшение погоды' }, terrain: { en: 'Steep terrain', ru: 'Сложный рельеф' }, separation: { en: 'Group separation', ru: 'Разрыв группы' }, connectivity: { en: 'Connectivity loss', ru: 'Потеря связи' }, daylight: { en: 'Reduced daylight', ru: 'Мало светлого времени' } };

  /* Погода из почасового прогноза → значения на минуту t от «сейчас» */
  function wxAt(weather, t) {
    const h = (weather && weather.hourly) || []; if (!h.length) return null;
    const pts = h.map(x => ({ ...x, t: x.t != null ? x.t : (x.time != null ? (x.time - weather.now) / 60000 : 0) })).sort((a, b) => a.t - b.t);
    if (t <= pts[0].t) return pts[0]; if (t >= pts[pts.length - 1].t) return pts[pts.length - 1];
