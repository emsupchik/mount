  },
  root() { let r = $('#sos-root'); if (!r) { r = document.createElement('div'); r.id = 'sos-root'; r.className = 'ov-full'; r.setAttribute('role', 'dialog'); r.setAttribute('aria-modal', 'true'); document.body.appendChild(r); document.body.classList.add('lock'); } return r; },
  close() { const r = $('#sos-root'); if (r) r.remove(); if (!Stress.st) document.body.classList.remove('lock'); },
  async confirm() {
    if (this.busy) return; this.busy = true; Modal.closeAll();
    const r = this.root(); r.innerHTML = `<div class="in"><span class="st-calm">ШАГ 1 ИЗ 2</span><div class="st-h">Получаем вашу геопозицию…</div><div class="risk"><div class="spinner" aria-hidden="true"></div><div><b>${GeoSvc.demo() ? '🟣 DEMO MODE: берём позицию сценария' : 'Запрашиваем GPS'}</b><div class="small muted">Не закрывайте экран. Если GPS не ответит за 12 секунд, будет использована последняя известная позиция.</div></div></div><a class="btn btn-danger" href="tel:112">Позвонить 112</a></div>`;
    let fix = null, fresh = false;
    if (GeoSvc.demo()) { fix = GeoSvc.st.demoFix || GeoSvc.demoGoto(GeoSvc.st.demoIdx >= 0 ? GeoSvc.st.demoIdx : 0); fresh = true; }
    else { const before = GeoSvc.st.real; const got = await GeoSvc.requestOnce({ silent: true, opts: { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 } }); fix = got || before || GeoStore.d.last; fresh = !!got && !GeoSvc.st.error; }
    const payload = this.payload(fix, fresh); GeoStore.d.sos = { level: 'emergency', ts: Date.now(), id: 'SOS-' + uid().toUpperCase(), payload }; GeoStore.save(); Bus.emit('geo');
    await Sync.enqueue('sos', payload);
    const res = await sendEmergencyData(payload); this.res = res; this.busy = false; this.card(fix, fresh, res);
  },
  payload(fix, fresh) {
    const P = Prefs.get(), a = Sel.actor(), g = Sel.groupOf(a) || Sel.leaderGroup(a);
    return { type: 'sos', ts: Date.now(), demo: GeoSvc.demo(), participant: P.card.name || a.name, contact: P.card.cname + ' ' + P.card.cphone, group: g ? g.name : '', coords: fix ? { lat: fix.lat, lon: fix.lon, acc: fix.acc, ts: fix.ts, src: fix.src } : null, coordsFresh: fresh, connection: Conn.state(), gps: GeoSvc.status().t };
  },
  text(p) {
    const c = p.coords, l = c ? GeoSvc.mapLinks(c) : null;
    return ['MOUNTAIN SAFE EMERGENCY' + (p.demo ? ' (DEMO)' : ''), 'Статус: EMERGENCY', 'Участник: ' + p.participant, c ? `Координаты: ${c.lat.toFixed(6)}, ${c.lon.toFixed(6)}` : 'Координаты: неизвестны', c ? `Точность: ±${Math.round(c.acc)} м` : '', c ? `Последнее обновление: ${tms(c.ts)}${p.coordsFresh ? '' : ' (последняя известная позиция)'}` : '', 'Связь: ' + NET_LABEL[p.connection], p.group ? 'Группа: ' + p.group : '', 'Контакт: ' + p.contact, l ? 'Карта: ' + l.osm : ''].filter(Boolean).join('\n');
  },
  card(fix, fresh, res) {
    const p = GeoStore.d.sos.payload, c = p.coords, n = p.connection, l = c ? GeoSvc.mapLinks(c) : null, age = c ? GeoSvc.agoText(c.ts) : '';
    const rows = [['Статус', p.demo ? '🟣 EMERGENCY (DEMO)' : '🔴 EMERGENCY'], ['Координаты', c ? `${c.lat.toFixed(6)}, ${c.lon.toFixed(6)}` : 'неизвестны'], ['Точность', c ? '±' + Math.round(c.acc) + ' м' : '—'], ['Последнее обновление', c ? tms(c.ts) + (fresh ? '' : ' · ' + age) : '—'], ['Связь', NET_LABEL[n]], ['Участник', p.participant]];
    if (p.group) rows.push(['Группа', p.group]);
    this.root().innerHTML = `<div class="in"><div class="row sp"><span class="st-calm">ШАГ 2 ИЗ 2 · EMERGENCY CARD</span><button class="btn btn-sm" data-action="sosClose">Закрыть</button></div>
      ${c ? (fresh ? `<div class="risk t-ok"><b>📍 Координаты получены</b></div>` : `<div class="warnbox"><b>GPS недоступен.</b> Показана последняя известная позиция, полученная в ${tms(c.ts)} (${age}). Реальное положение может отличаться.</div>`) : `<div class="dngbox"><b>Координаты неизвестны.</b> GPS не дал позицию, и сохранённых данных нет. Назовите спасателям ориентиры: река, хребет, тропа, время пути от старта.</div>`}
      ${c && GeoSvc.accInfo(c.acc).low ? `<div class="warnbox"><b>🟡 Низкая точность GPS (±${Math.round(c.acc)} м).</b> Переместитесь на открытое место и обновите позицию, если это безопасно.</div>` : ''}
      <div class="rcard"><div class="hd">Mountain Safe Emergency</div>${rows.map(r => `<div class="r"><span>${r[0]}</span><b>${esc(r[1])}</b></div>`).join('')}${p.demo ? '<div class="demoline">🟣 DEMO MODE: координаты из симуляции, не реальный GPS</div>' : ''}</div>
