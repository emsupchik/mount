  assert.equal((await r1.post(`/api/v1/rescue/incidents/${ib.id}/status`, { status: 'IN_PROGRESS' })).status, 404);
  assert.equal((await r1.post(`/api/v1/rescue/incidents/${ia.id}/status`, { status: 'CANCELLED' })).status, 403);                                // спасатель не отменяет
