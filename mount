const Db = {
  KEY: 'mountainsafe_db_v1', data: null, raw: '',
  load() {
    const raw = Local.get(this.KEY);
    if (raw) { try { this.data = JSON.parse(raw); this.raw = raw; } catch (e) { this.data = null; } }
    if (!this.data) { this.data = seedDb(); this.commit(true); }
  },
  commit(silent) { this.raw = JSON.stringify(this.data); Local.set(this.KEY, this.raw); if (!silent) Bus.emit('db'); },
  sync() { const raw = Local.get(this.KEY); if (raw && raw !== this.raw) { this.data = JSON.parse(raw); this.raw = raw; Bus.emit('db', { remote: true }); } },
  reset() { Local.del(this.KEY); this.data = seedDb(); this.commit(); },
};
window.addEventListener('storage', e => { if (e.key === Db.KEY) Db.sync(); });
