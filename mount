'use strict';
/* Вход и регистрация по номеру телефона (OTP). AuthService.sendOTP / verifyOTP.
   • Код генерирует и проверяет СЕРВЕР; в БД хранится только HMAC-SHA256(код), не сам код; клиенту код не отдаётся.
   • Провайдер: Twilio Verify (TWILIO_VERIFY_SID — код генерирует Twilio) или собственный код + SMS_PROVIDER (twilio/smsc/mobizon).
   • Без провайдера в production — 503 sms_not_configured. В разработке можно включить OTP_DEV_ECHO=true:
     тогда код возвращается в ответе с явной пометкой DEV_ECHO (в production этот флаг игнорируется конфигурацией).
   • Ограничения: повторная отправка не чаще OTP_RESEND_SEC, ≤ 5 кодов на номер в час, ≤ OTP_MAX_ATTEMPTS попыток на код,
     срок жизни OTP_TTL_SEC; плюс лимиты по IP в контроллере. Роль нового аккаунта всегда TOURIST (клиенту не доверяем). */
const crypto = require('node:crypto');
const { E } = require('../lib/errors');

function createOtp({ cfg, db, log, audit, auth, sms, notifications }) {
  const O = {};
  const hmac = (phone, code) => crypto.createHmac('sha256', cfg.jwtSecret).update('otp:' + phone + ':' + code).digest('hex');
  const verifyLive = () => sms.live();                      // Twilio Verify
  const ownLive = () => notifications.status().sms.configured;

  O.status = () => !cfg.phoneLogin ? { provider: 'disabled', configured: false, devEcho: false, enabled: false, length: cfg.otp.length, ttlSec: cfg.otp.ttlSec } : ({ enabled: true,  provider: verifyLive() ? 'twilio_verify' : ownLive() ? cfg.smsOut.provider : (cfg.otp.devEcho ? 'dev_echo' : 'none'), configured: verifyLive() || ownLive(), devEcho: !verifyLive() && !ownLive() && cfg.otp.devEcho, length: cfg.otp.length, ttlSec: cfg.otp.ttlSec });

  O.sendOTP = async (ctx, phone) => {
    if (!cfg.phoneLogin) throw E.unavailable('Вход по телефону отключён на сервере. Войдите по email', 'phone_login_disabled');
    const last = await db.one("SELECT created_at FROM otp_codes WHERE phone=$1 ORDER BY created_at DESC LIMIT 1", [phone]);
    if (last && Date.now() - new Date(last.created_at) < cfg.otp.resendSec * 1000) throw Object.assign(E.tooMany(Math.ceil((cfg.otp.resendSec * 1000 - (Date.now() - new Date(last.created_at))) / 1000)), { message: 'Код уже отправлен. Повторно — через минуту' });
    const n = await db.one("SELECT count(*)::int n FROM otp_codes WHERE phone=$1 AND created_at > now() - interval '1 hour'", [phone]);
    if (n.n >= 5) { await audit.security('otp_flood', { ip: ctx.ip, meta: { phone: phone.slice(0, 5) + '***' } }); throw Object.assign(E.tooMany(3600), { message: 'Слишком много кодов на этот номер. Попробуйте через час' }); }
    const exp = new Date(Date.now() + cfg.otp.ttlSec * 1000);
    if (verifyLive()) {
      await sms.start(phone);                              // бросает 503, если Twilio не принял запрос → статус не «отправлено»
      await db.query("INSERT INTO otp_codes(phone,provider,delivery,ip,expires_at) VALUES($1,'twilio_verify','SENT',$2,$3)", [phone, ctx.ip, exp]);
      return { delivery: 'SENT', provider: 'twilio_verify', expiresIn: cfg.otp.ttlSec, length: cfg.smsCodeLength };
    }
    const code = String(crypto.randomInt(0, 10 ** cfg.otp.length)).padStart(cfg.otp.length, '0');
    let delivery, provider, id = null;
    if (ownLive()) {
      const r = await notifications.sendSMS({ to: phone, text: `Mountain Safe: код входа ${code}. Никому его не сообщайте. Действует ${Math.round(cfg.otp.ttlSec / 60)} мин.` });
      delivery = r.status; provider = r.provider; id = r.id || null;
      if (r.status !== 'SENT') { await db.query('INSERT INTO otp_codes(phone,code_hash,provider,delivery,ip,expires_at,consumed_at) VALUES($1,NULL,$2,$3,$4,$5,now())', [phone, provider, delivery, ctx.ip, exp]); throw E.unavailable('Не удалось отправить SMS: ' + (r.error || r.status), 'sms_failed'); }
    } else if (cfg.otp.devEcho) { delivery = 'DEV_ECHO'; provider = 'dev_echo'; }
    else throw E.unavailable('SMS-провайдер не настроен на сервере. Войдите по email или настройте SMS_PROVIDER', 'sms_not_configured');
    await db.query('INSERT INTO otp_codes(phone,code_hash,provider,delivery,provider_message_id,ip,expires_at) VALUES($1,$2,$3,$4,$5,$6,$7)', [phone, hmac(phone, code), provider, delivery, id, ctx.ip, exp]);
    log.event('auth', 'otp_sent', { provider, delivery });
    return Object.assign({ delivery, provider, expiresIn: cfg.otp.ttlSec, length: cfg.otp.length }, delivery === 'DEV_ECHO' ? { devCode: code, devNotice: 'DEV ONLY: SMS-провайдер не настроен, код показан, потому что OTP_DEV_ECHO=true. В production так не работает.' } : {});
  };

  O.verifyOTP = async (ctx, phone, code) => {
    if (!cfg.phoneLogin) throw E.unavailable('Вход по телефону отключён на сервере. Войдите по email', 'phone_login_disabled');
    let ok = false;
    if (verifyLive()) {
      const row = await db.one("SELECT * FROM otp_codes WHERE phone=$1 AND provider='twilio_verify' AND consumed_at IS NULL AND expires_at>now() ORDER BY created_at DESC LIMIT 1", [phone]);
      if (!row) throw E.badRequest('Код устарел. Запросите новый');
      if (row.attempts >= cfg.otp.maxAttempts) throw E.badRequest('Слишком много попыток. Запросите новый код');
      await db.query('UPDATE otp_codes SET attempts=attempts+1 WHERE id=$1', [row.id]);
      ok = await sms.check(phone, code);
      if (ok) await db.query('UPDATE otp_codes SET consumed_at=now() WHERE id=$1', [row.id]);
    } else {
      const row = await db.one("SELECT * FROM otp_codes WHERE phone=$1 AND code_hash IS NOT NULL AND consumed_at IS NULL AND expires_at>now() ORDER BY created_at DESC LIMIT 1", [phone]);
      if (!row) throw E.badRequest('Код устарел. Запросите новый');
      if (row.attempts >= cfg.otp.maxAttempts) throw E.badRequest('Слишком много попыток. Запросите новый код');
      const want = Buffer.from(row.code_hash, 'hex'), got = Buffer.from(hmac(phone, String(code)), 'hex');
      ok = want.length === got.length && crypto.timingSafeEqual(want, got);
      if (ok) { const r = await db.one('UPDATE otp_codes SET consumed_at=now(), attempts=attempts+1 WHERE id=$1 AND consumed_at IS NULL RETURNING id', [row.id]); ok = !!r; }
      else await db.query('UPDATE otp_codes SET attempts=attempts+1 WHERE id=$1', [row.id]);
    }
    if (!ok) { await audit.security('otp_failed', { ip: ctx.ip }); throw E.badRequest('Неверный код'); }
    return O.loginOrCreate(ctx, phone, ctx.body && ctx.body.fullName);
  };

  /* Вход в существующий аккаунт с подтверждённым номером или создание нового (всегда TOURIST) */
  O.loginOrCreate = async (ctx, phone, fullName) => {
    let u = await db.one('SELECT * FROM users WHERE phone=$1 AND phone_verified_at IS NOT NULL', [phone]);
    let created = false;
    if (!u) {
      const r = await db.tx(async q => {
        const u = await q.one("INSERT INTO users(email,password_hash,phone,phone_verified_at,role) VALUES(NULL,NULL,$1,now(),'TOURIST') RETURNING *", [phone]);
        const tag = await auth.newTag(q, fullName || 'hiker');
        await q.query('INSERT INTO profiles(user_id,tag,full_name) VALUES($1,$2,$3)', [u.id, tag, (fullName || '').slice(0, 80)]);
        return u;
      });
      u = r; created = true;
      await audit.log({ ip: ctx.ip, actorId: u.id }, 'auth.register_phone', 'user', u.id);
    }
    if (u.status === 'deleted') throw Object.assign(E.forbidden('Аккаунт удалён'), { code: 'account_deleted' });
    if (u.status === 'blocked') { await audit.security('blocked_login', { userId: u.id, ip: ctx.ip }); throw Object.assign(E.forbidden('Аккаунт заблокирован администратором'), { code: 'account_blocked' }); }
    await db.query('UPDATE users SET failed_logins=0, locked_until=NULL, last_login_at=now() WHERE id=$1', [u.id]);
    const s = await auth.startSession(u, ctx);
    const p = await db.one('SELECT * FROM profiles WHERE user_id=$1', [u.id]);
    await audit.log({ actorId: u.id, ip: ctx.ip }, 'auth.login_phone', 'session', s.sessionId);
    log.event('auth', 'login_phone', { userId: u.id, created });
    return Object.assign(s, { user: auth.publicUser(u, p), created });
  };
  return O;
}
module.exports = { createOtp };


