'use strict';
/* NotificationService: sendEmail / sendSMS / sendPush через внешних провайдеров.
   Правило честности: статус SENT возвращается ТОЛЬКО после успешного ответа API провайдера.
   Провайдер не настроен → NOT_CONFIGURED; ошибка/таймаут/отказ → FAILED. Никаких «SMS sent» без реальной отправки.

   EMAIL_PROVIDER: smtp (SMTP_URL, nodemailer) | resend (RESEND_API_KEY) | sendgrid (SENDGRID_API_KEY) | none
   SMS_PROVIDER:   twilio (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM) | smsc (SMSC_LOGIN, SMSC_PASSWORD; smsc.kz/smsc.ru)
                   | mobizon (MOBIZON_API_KEY, MOBIZON_DOMAIN=api.mobizon.kz) | none
   Push: Web Push (VAPID), уже настроенный в support.createNotify. */

const mask = s => { s = String(s || ''); if (s.includes('@')) { const [u, d] = s.split('@'); return u.slice(0, 2) + '***@' + d; } return s.length > 6 ? s.slice(0, 4) + '***' + s.slice(-2) : '***'; };

function createNotificationService({ cfg, log, notify, fetchImpl }) {
  const F = fetchImpl || ((...a) => fetch(...a));
  const E = cfg.email, S = cfg.smsOut;
  let smtp = null;
  const result = (status, extra = {}) => ({ status, ...extra });
  const timeout = () => AbortSignal.timeout(15000);

  async function sendEmail({ to, subject, text, html }) {
    const provider = E.provider;
    if (!to) return result('NOT_CONFIGURED', { provider, error: 'recipient not configured' });
    try {
      if (provider === 'smtp') {
        if (!E.smtpUrl) return result('NOT_CONFIGURED', { provider, error: 'SMTP_URL is empty' });
        if (!smtp) smtp = require('nodemailer').createTransport(E.smtpUrl);
        const info = await smtp.sendMail({ from: E.from, to, subject, text, html });
        if (info && Array.isArray(info.rejected) && info.rejected.length) return result('FAILED', { provider, error: 'rejected by SMTP: ' + info.rejected.length });
        return result('SENT', { provider, id: info && info.messageId });
      }
      if (provider === 'resend') {
        if (!E.resendKey) return result('NOT_CONFIGURED', { provider, error: 'RESEND_API_KEY is empty' });
        const r = await F('https://api.resend.com/emails', { method: 'POST', headers: { Authorization: 'Bearer ' + E.resendKey, 'Content-Type': 'application/json' }, body: JSON.stringify({ from: E.from, to: [to], subject, text, html }), signal: timeout() });
        const j = await r.json().catch(() => ({}));
        return r.ok && j.id ? result('SENT', { provider, id: j.id }) : result('FAILED', { provider, error: 'HTTP ' + r.status + (j.message ? ': ' + String(j.message).slice(0, 200) : '') });
      }
      if (provider === 'sendgrid') {
        if (!E.sendgridKey) return result('NOT_CONFIGURED', { provider, error: 'SENDGRID_API_KEY is empty' });
        const from = /<([^>]+)>/.exec(E.from); const fromName = E.from.replace(/\s*<[^>]+>/, '').replace(/^"|"$/g, '');
        const content = [{ type: 'text/plain', value: text }]; if (html) content.push({ type: 'text/html', value: html });
        const r = await F('https://api.sendgrid.com/v3/mail/send', { method: 'POST', headers: { Authorization: 'Bearer ' + E.sendgridKey, 'Content-Type': 'application/json' }, body: JSON.stringify({ personalizations: [{ to: [{ email: to }] }], from: { email: from ? from[1] : E.from, name: fromName || undefined }, subject, content }), signal: timeout() });
        return r.status === 202 ? result('SENT', { provider, id: r.headers.get('x-message-id') }) : result('FAILED', { provider, error: 'HTTP ' + r.status });
      }
      return result('NOT_CONFIGURED', { provider: provider || 'none', error: 'EMAIL_PROVIDER is not set' });
    } catch (e) { log.warn({ err: e, provider }, 'email send failed'); return result('FAILED', { provider, error: String(e && e.message || e).slice(0, 200) }); }
  }

  async function sendSMS({ to, text }) {
    const provider = S.provider;
    if (!to) return result('NOT_CONFIGURED', { provider, error: 'recipient not configured' });
    if (!/^\+[1-9]\d{7,14}$/.test(to)) return result('FAILED', { provider, error: 'invalid phone format (E.164 expected)' });
    try {
      if (provider === 'twilio') {
        if (!(S.twilioSid && S.twilioToken && S.twilioFrom)) return result('NOT_CONFIGURED', { provider, error: 'TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM required' });
        const r = await F(S.twilioBase + '/2010-04-01/Accounts/' + encodeURIComponent(S.twilioSid) + '/Messages.json', { method: 'POST', headers: { Authorization: 'Basic ' + Buffer.from(S.twilioSid + ':' + S.twilioToken).toString('base64'), 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ To: to, From: S.twilioFrom, Body: text }).toString(), signal: timeout() });
        const j = await r.json().catch(() => ({}));
        return (r.status === 201 || r.status === 200) && j.sid && j.status !== 'failed' ? result('SENT', { provider, id: j.sid }) : result('FAILED', { provider, error: 'HTTP ' + r.status + (j.message ? ': ' + String(j.message).slice(0, 200) : '') });
      }
      if (provider === 'smsc') {
        if (!(S.smscLogin && S.smscPassword)) return result('NOT_CONFIGURED', { provider, error: 'SMSC_LOGIN / SMSC_PASSWORD required' });
        const q = new URLSearchParams({ login: S.smscLogin, psw: S.smscPassword, phones: to.replace(/^\+/, ''), mes: text, fmt: '3', charset: 'utf-8' });
        if (S.smscSender) q.set('sender', S.smscSender);
        const r = await F(S.smscBase + '/sys/send.php', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: q.toString(), signal: timeout() });
        const j = await r.json().catch(() => ({}));
        return r.ok && j.id != null && !j.error ? result('SENT', { provider, id: String(j.id) }) : result('FAILED', { provider, error: j.error ? String(j.error) + (j.error_code ? ' (' + j.error_code + ')' : '') : 'HTTP ' + r.status });
      }
      if (provider === 'mobizon') {
        if (!S.mobizonKey) return result('NOT_CONFIGURED', { provider, error: 'MOBIZON_API_KEY required' });
        /* по документации Mobizon: служебные параметры (output, api, apiKey) — в строке запроса, данные сообщения — в теле POST */
        const qs = new URLSearchParams({ output: 'json', api: 'v1', apiKey: S.mobizonKey });
        const q = new URLSearchParams({ recipient: to.replace(/^\+/, ''), text });
        if (S.mobizonFrom) q.set('from', S.mobizonFrom);
        const r = await F('https://' + S.mobizonDomain + '/service/message/sendsmsmessage?' + qs.toString(), { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: q.toString(), signal: timeout() });
        const j = await r.json().catch(() => ({}));
        return r.ok && j.code === 0 && j.data && j.data.messageId ? result('SENT', { provider, id: String(j.data.messageId) }) : result('FAILED', { provider, error: 'code ' + (j.code ?? r.status) + (j.message ? ': ' + String(j.message).slice(0, 200) : '') + (j.data && typeof j.data === 'object' && !j.data.messageId ? ' ' + JSON.stringify(j.data).slice(0, 200) : '') });   // поля с ошибками от Mobizon
      }
      return result('NOT_CONFIGURED', { provider: provider || 'none', error: 'SMS_PROVIDER is not set' });
    } catch (e) { log.warn({ err: e, provider }, 'sms send failed'); return result('FAILED', { provider, error: String(e && e.message || e).slice(0, 200) }); }
  }

  /* Push-уведомление пользователю системы (диспетчеру) через Web Push. SENT — если хотя бы одна подписка приняла сообщение. */
  async function sendPush(userId, payload) {
    if (!notify.pushConfigured()) return result('NOT_CONFIGURED', { provider: 'webpush', error: 'VAPID keys not configured' });
    try { const n = await notify.push(userId, payload); return n > 0 ? result('SENT', { provider: 'webpush', id: String(n) }) : result('FAILED', { provider: 'webpush', error: 'no active push subscriptions' }); }
    catch (e) { return result('FAILED', { provider: 'webpush', error: String(e && e.message || e).slice(0, 200) }); }
  }

  const status = () => ({
    email: { provider: E.provider || 'none', configured: E.provider === 'smtp' ? !!E.smtpUrl : E.provider === 'resend' ? !!E.resendKey : E.provider === 'sendgrid' ? !!E.sendgridKey : false },
    sms: { provider: S.provider || 'none', configured: S.provider === 'twilio' ? !!(S.twilioSid && S.twilioToken && S.twilioFrom) : S.provider === 'smsc' ? !!(S.smscLogin && S.smscPassword) : S.provider === 'mobizon' ? !!S.mobizonKey : false },
    push: { provider: 'webpush', configured: notify.pushConfigured() },
  });
  return { sendEmail, sendSMS, sendPush, status, mask };
}
module.exports = { createNotificationService, mask };


