    repaint() { const side = document.querySelector('#mx-dest-map') && document.querySelector('#mx-dest-map').closest('.mx-grid'); if (!side) return; const col = side.children[1]; const tmp = document.createElement('div'); tmp.innerHTML = this.html(); const nc = tmp.querySelector('.mx-grid').children[1]; col.replaceWith(nc); const q = $('#mxDestQ'); if (q) q.oninput = () => { this.q = q.value; const l = $('#mx-dest-list'); if (l) l.innerHTML = this.listHtml(this.list(), Points.visible().filter(p => p.kind === 'peak').length); }; },
    async build() {
