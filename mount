'use strict';
const C = require('../lib/crypto');
const crypto = require('node:crypto');
const ALPHA = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
const inviteCode = () => Array.from(crypto.randomBytes(10), b => ALPHA[b % 32]).join('');   // 10 символов, 50 бит; вводится без учёта регистра
const { E } = require('../lib/errors');

const ONLINE_MS = 3 * 60 * 1000;

function createGroups({ cfg, db, log, audit, notify, bus }) {
  const G = {};

  async function member(q, groupId, userId) {
    return q.one("SELECT gm.*, g.leader_id, g.name, g.status AS gstatus, g.checkin_interval_min FROM group_members gm JOIN groups g ON g.id=gm.group_id WHERE gm.group_id=$1 AND gm.user_id=$2 AND gm.status='active'", [groupId, userId]);
  }
  /* Единая проверка прав: участник группы. Руководитель определяется по данным БД, не по клиенту. */
  G.requireMember = async (groupId, userId, q = db) => { const m = await member(q, groupId, userId); if (!m) throw E.notFound('Группа не найдена'); return m; };
  G.requireLeader = async (groupId, userId, q = db) => { const m = await G.requireMember(groupId, userId, q); if (m.role !== 'leader') throw E.forbidden('Только руководитель группы может это делать'); return m; };
  const logEvent = (q, groupId, actorId, type, data = {}) => q.query('INSERT INTO group_events(group_id,actor_id,type,data) VALUES($1,$2,$3,$4)', [groupId, actorId, type, JSON.stringify(data)]);
  G.logEvent = logEvent;

  G.create = async (ctx, { name, checkinIntervalMin = 60, mode = 'club' }) => {
    const g = await db.tx(async q => {
      const n = +(await q.one("SELECT count(*)::int n FROM groups WHERE leader_id=$1 AND status='active'", [ctx.user.id])).n;
      if (n >= 10) throw E.conflict('Слишком много активных групп', 'too_many_groups');
      const g = await q.one('INSERT INTO groups(name,leader_id,checkin_interval_min,mode) VALUES($1,$2,$3,$4) RETURNING *', [name, ctx.user.id, checkinIntervalMin, mode]);
      await q.query("INSERT INTO group_members(group_id,user_id,role) VALUES($1,$2,'leader')", [g.id, ctx.user.id]);
      if (ctx.user.role === 'TOURIST') await q.query("UPDATE users SET role='LEADER' WHERE id=$1", [ctx.user.id]);   // роль присваивает сервер
      await logEvent(q, g.id, ctx.user.id, 'group_created', { name });
      return g;
    });
    await bus.refreshUser(ctx.user.id);
    await audit.log(ctx, 'group.created', 'group', g.id);
    return G.view(g);
  };
  G.view = g => ({ id: g.id, name: g.name, mode: g.mode, evac: g.evac, leaderId: g.leader_id, checkinIntervalMin: g.checkin_interval_min, status: g.status, createdAt: g.created_at });

  G.listMine = async (userId) => (await db.all("SELECT g.*, gm.role FROM groups g JOIN group_members gm ON gm.group_id=g.id WHERE gm.user_id=$1 AND gm.status='active' ORDER BY g.created_at DESC", [userId]))
    .map(g => Object.assign(G.view(g), { myRole: g.role }));

  G.detail = async (groupId, userId) => {
    const me = await G.requireMember(groupId, userId);
    const rows = await db.all(`SELECT gm.user_id, gm.role, gm.member_status, gm.joined_at, p.full_name, p.tag, p.photo, p.experience_level,
        d.lat, d.lon, d.accuracy, d.battery, d.gps_status, d.net_quality, d.location_at, d.updated_at,
        t.due_at AS checkin_due, (SELECT max(at) FROM checkins c WHERE c.user_id=gm.user_id) AS last_checkin
      FROM group_members gm JOIN profiles p ON p.user_id=gm.user_id
      LEFT JOIN device_states d ON d.user_id=gm.user_id LEFT JOIN checkin_timers t ON t.user_id=gm.user_id
      WHERE gm.group_id=$1 AND gm.status='active' ORDER BY (gm.role='leader') DESC, p.full_name`, [groupId]);
    const now = Date.now();
    const gr = await db.one('SELECT mode, evac FROM groups WHERE id=$1', [groupId]);
    const rc = await db.one('SELECT id, started_at FROM roll_calls WHERE group_id=$1 ORDER BY started_at DESC LIMIT 1', [groupId]);
    const acks = rc ? new Map((await db.all('SELECT user_id, at FROM roll_call_acks WHERE roll_call_id=$1', [rc.id])).map(a => [a.user_id, a.at])) : new Map();
    const guests = (await db.all('SELECT * FROM group_guests WHERE group_id=$1 ORDER BY created_at', [groupId])).map(g => ({ id: g.id, name: g.name, level: g.level, status: g.status, note: g.note, seenAt: g.seen_at, ackAt: g.ack_at }));
    return {
      group: { id: groupId, name: me.name, mode: gr.mode, evac: gr.evac, leaderId: me.leader_id, checkinIntervalMin: me.checkin_interval_min, status: me.gstatus }, myRole: me.role,
      rollCall: rc ? { id: rc.id, startedAt: rc.started_at } : null, guests,
      members: rows.map(r => ({ ackAt: acks.get(r.user_id) || null,
        userId: r.user_id, name: r.full_name || r.tag, tag: r.tag, photo: r.photo, level: r.experience_level, role: r.role, status: r.member_status, joinedAt: r.joined_at,
        online: !!r.updated_at && now - new Date(r.updated_at) < ONLINE_MS, lastSeen: r.updated_at,
