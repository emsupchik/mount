NAMES="$DOMAIN"; CERTARGS="-d $DOMAIN"
if getent hosts "www.$DOMAIN" >/dev/null; then NAMES="$DOMAIN www.$DOMAIN"; CERTARGS="$CERTARGS -d www.$DOMAIN"; fi
