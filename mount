/* BACKEND: сюда подключается настоящий API спасателей. Сейчас функция ничего не отправляет. */
async function sendEmergencyData(payload) {
  if (GeoCfg.emergencyApi) {
    /* Пример боевой реализации:
       const r = await fetch(GeoCfg.emergencyApi, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
       return { demo: false, delivered: r.ok, message: r.ok ? 'Передано' : 'Ошибка передачи' }; */
  }
  return { demo: true, delivered: false, message: 'Demo: Emergency data prepared. Данные НЕ отправлены спасателям.', payload };
}
const Sync = {
  async enqueue(type, payload) { const x = { id: 'o_' + uid(), type, payload, ts: Date.now(), status: 'pending' }; await Hist.outboxAdd(x); return x; },
  async pending() { return (await Hist.outboxAll()).filter(x => x.status === 'pending'); },
  /* BACKEND: вызывается при восстановлении связи. Сейчас только помечает данные «подготовлены», сервер не подключён. */
  async flush() {
