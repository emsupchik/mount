'use strict';
/* Рабочий режим (сайт работает с сервером, без ?demo): пользователь нигде не видит упоминаний демо/симуляции.
   Без сервера демо остаётся. ?demo включает демо для презентации. */
const { boot, uiLogin } = require('./lib');
const RX = /демо|demo|симуляц|имитац|simulat/i;
async function visibleDemo(p) {
  return p.evaluate((src) => {
    const rx = new RegExp(src, 'i'), out = [], w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); let n;
    while ((n = w.nextNode())) {
      const t = n.textContent.trim(); if (!t || !rx.test(t)) continue;
      const el = n.parentElement; if (!el || el.closest('script,style')) continue;
      const r = el.getBoundingClientRect(); if (!r.width || !r.height) continue;
      let hid = false; for (let e = el; e; e = e.parentElement) { const cs = getComputedStyle(e); if (cs.display === 'none' || cs.visibility === 'hidden') { hid = true; break; } }
      if (!hid) out.push(t.slice(0, 80));
    }
    return out;
  }, RX.source);
}
(async () => {
  const T = await boot({}); const { env, ok } = T;
  try {
    const c = await T.ctx({ realMode: true }); const p = await T.page(c, 'real');
    await p.goto(env.base + '/'); await p.waitForFunction(() => document.body.classList.contains('ms-real'), null, { timeout: 8000 });
    const bad = {};
    const check = async (label) => { const h = await visibleDemo(p); if (h.length) bad[label] = h; };
    await check('home');
    const routes = await p.evaluate(() => TNAV.map(x => x[0]));
    for (const r of routes) { await p.evaluate(h => { location.hash = h; }, '#/' + r); await p.waitForTimeout(700); await check('#/' + r); }
    await p.evaluate(() => { location.hash = '#/demo'; }); await p.waitForTimeout(500);
    ok('real: #/demo redirects home', await p.evaluate(() => location.hash) === '#/');
    await p.evaluate(() => { location.hash = '#/nav'; }); await p.waitForTimeout(1500);
    ok('real: no DEMO route in navigator', (await p.locator('[data-id=demo-alpine]').count()) === 0);
    await p.evaluate(() => { location.hash = '#/'; }); await p.waitForTimeout(500);
    await p.evaluate(() => AuthUI.open('tourist')); await p.waitForTimeout(800); await check('login tourist');
    await p.evaluate(() => Modal.closeAll()); await p.evaluate(() => AuthUI.open('rescuer')); await p.waitForTimeout(800); await check('login rescuer');
    await p.evaluate(() => Modal.closeAll());
    await uiLogin(p, { email: 'admin@test.local', password: 'Admin-pass-12345', role: 'authRescuer' }); await p.waitForTimeout(800);
