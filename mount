'use strict';
/* Вспомогательные сервисы: аудит, почта, уведомления (in-app + Web Push + SSE). */

function createAudit(db, log) {
  return {
    /* Записывается в неизменяемый audit_log. Ошибка аудита не должна ломать операцию, но обязательно логируется. */
    async log(ctx, action, entity, entityId, meta = {}) {
      try {
        const actor = ctx && ctx.user || null;
        await db.query('INSERT INTO audit_log(actor_id,actor_role,action,entity,entity_id,ip,meta) VALUES($1,$2,$3,$4,$5,$6,$7)',
          [actor ? actor.id : (ctx && ctx.actorId) || null, actor ? actor.role : null, action, entity || null, entityId == null ? null : String(entityId), ctx && ctx.ip || null, JSON.stringify(meta)]);
      } catch (e) { log.error({ err: e, action }, 'audit write failed'); }
    },
    async security(kind, { userId = null, ip = null, meta = {} } = {}) {
      try { await db.query('INSERT INTO security_events(kind,user_id,ip,meta) VALUES($1,$2,$3,$4)', [kind, userId, ip, JSON.stringify(meta)]); }
      catch (e) { log.error({ err: e, kind }, 'security event write failed'); }
      log.event('security', kind, { userId, ip });
    },
  };
}

function createMailer(cfg, log) {
  const outbox = [];                     // для тестов и режима log
  let transport = null;
  if (cfg.mail.mode === 'smtp' && cfg.mail.smtpUrl) transport = require('nodemailer').createTransport(cfg.mail.smtpUrl);
  else if (cfg.prod) log.warn('MAIL_MODE=log в production: письма НЕ отправляются. Настройте SMTP_URL.');
  const link = (p) => (cfg.publicUrl || 'http://localhost:' + cfg.port) + '/#/' + p;
  return {
    outbox, mode: transport ? 'smtp' : 'log',
    async send(to, subject, text) {
      const msg = { to, subject, text, at: Date.now() };
      if (transport) { await transport.sendMail({ from: cfg.mail.from, to, subject, text }); log.event('mail', 'sent', { type: subject.slice(0, 40) }); }
      else { outbox.push(msg); if (outbox.length > 200) outbox.shift(); if (!cfg.prod) log.info({ msg: 'MAIL (dev, не отправлено)', subject }); }
    },
    verifyEmail: (to, t) => `Подтвердите email для Mountain Safe:\n${link('verify-email/' + t)}\nСсылка действует 24 часа.`,
    resetPassword: (to, t) => `Сброс пароля Mountain Safe:\n${link('reset-password/' + t)}\nСсылка действует 1 час. Если это были не вы, просто проигнорируйте письмо и убедитесь, что доступ к вашей почте защищён.`,
    changeEmail: (to, t) => `Подтвердите новый email для Mountain Safe:\n${link('confirm-email/' + t)}\nСсылка действует 24 часа.`,
  };
}

function createNotify(cfg, db, bus, log, deps = {}) {
  let sender = deps.pushSender || null;
  if (!sender && cfg.push.publicKey && cfg.push.privateKey) {
    const wp = require('web-push'); wp.setVapidDetails(cfg.push.subject, cfg.push.publicKey, cfg.push.privateKey);
    sender = (sub, payload) => wp.sendNotification({ endpoint: sub.endpoint, keys: { p256dh: sub.p256dh, auth: sub.auth } }, JSON.stringify(payload), { TTL: 3600, urgency: payload.urgent ? 'high' : 'normal' });
  }
  const CATS = ['sos', 'group', 'checkin', 'weather', 'route', 'battery', 'achievement', 'community', 'system'];
  const ALWAYS = new Set(['sos', 'system']);         // критичные категории нельзя отключить полностью для обновлений SOS-статуса
  const api = {
    CATS, pushConfigured: () => !!sender,
    setSender(s) { sender = s; },
    /* Возвращает id уведомления или null, если пользователь отключил категорию. */
    async send(userId, { category, title, body = '', data = {}, urgent = false }) {
      if (!CATS.includes(category)) throw new Error('unknown notification category ' + category);
      const p = await db.one('SELECT notif_prefs FROM profiles WHERE user_id=$1', [userId]);
      const prefs = p ? p.notif_prefs : {};
      if (!ALWAYS.has(category) && prefs[category] === false) return null;
      const n = await db.one('INSERT INTO notifications(user_id,category,title,body,data) VALUES($1,$2,$3,$4,$5) RETURNING id, created_at', [userId, category, title, body, JSON.stringify(data)]);
      bus.publish('user:' + userId, 'notification', { id: n.id, category, title, body, data, at: n.created_at });
      if (sender && prefs.push !== false) api.push(userId, { title, body, data: Object.assign({ id: n.id, category }, data), urgent }).catch(e => log.warn({ err: e }, 'push failed'));
      return n.id;
    },
    async sendMany(userIds, payload) { let n = 0; for (const id of new Set(userIds)) { if (await api.send(id, payload)) n++; } return n; },
    async push(userId, payload) {
      if (!sender) return 0;
      const subs = await db.all('SELECT * FROM push_subscriptions WHERE user_id=$1', [userId]);
      let ok = 0;
      for (const s of subs) {
        try { await sender(s, payload); ok++; await db.query('UPDATE push_subscriptions SET last_ok_at=now(), failures=0 WHERE id=$1', [s.id]); }
        catch (e) {
          if (e && (e.statusCode === 404 || e.statusCode === 410)) await db.query('DELETE FROM push_subscriptions WHERE id=$1', [s.id]);   // подписка отозвана браузером
          else await db.query('UPDATE push_subscriptions SET failures=failures+1 WHERE id=$1', [s.id]);
        }
      }
      return ok;
    },
  };
  return api;
}
module.exports = { createAudit, createMailer, createNotify };


