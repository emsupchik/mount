    if (to) { v.push(to); w.push('a.at<=$' + v.length); }
    v.push(limit, offset);
    return (await db.all(`SELECT a.* FROM audit_log a ${w.length ? 'WHERE ' + w.join(' AND ') : ''} ORDER BY a.at DESC LIMIT $${v.length - 1} OFFSET $${v.length}`, v)).map(a => ({ id: +a.id, at: a.at, actorId: a.actor_id, role: a.actor_role, action: a.action, entity: a.entity, entityId: a.entity_id, ip: a.ip, meta: a.meta }));
  };
  A.suspicious = async () => {
    const byIp = await db.all("SELECT ip, count(*)::int n, count(DISTINCT user_id)::int users FROM security_events WHERE kind IN ('login_failed','account_locked','refresh_reuse','rate_limited','login_locked') AND at>now()-interval '24 hours' AND ip IS NOT NULL GROUP BY ip HAVING count(*)>=10 ORDER BY n DESC LIMIT 20");
    const locked = await db.all("SELECT u.id, u.email, u.failed_logins, u.locked_until FROM users u WHERE u.locked_until>now() ORDER BY u.locked_until DESC LIMIT 20");
    const reuse = await db.all("SELECT user_id, ip, at FROM security_events WHERE kind='refresh_reuse' AND at>now()-interval '7 days' ORDER BY at DESC LIMIT 20");
    const qr = await db.all("SELECT ip, count(*)::int n FROM security_events WHERE kind='emergency_qr_invalid' AND at>now()-interval '24 hours' GROUP BY ip HAVING count(*)>=5 ORDER BY n DESC LIMIT 20");
    const multi = await db.all("SELECT user_id, count(DISTINCT ip)::int ips FROM sessions WHERE created_at>now()-interval '24 hours' GROUP BY user_id HAVING count(DISTINCT ip)>=4 ORDER BY ips DESC LIMIT 20");
    return { failedByIp: byIp, lockedAccounts: locked.map(u => ({ id: u.id, email: u.email, failedLogins: u.failed_logins, lockedUntil: u.locked_until })), refreshTokenReuse: reuse, emergencyQrProbing: qr, sessionsFromManyIps: multi };
  };
  A.overview = async () => {
    const r = await db.one(`SELECT (SELECT count(*)::int FROM users WHERE status='active') users, (SELECT count(*)::int FROM users WHERE created_at>now()-interval '7 days') new_users,
      (SELECT count(*)::int FROM sos_incidents WHERE status IN ('ACTIVE','ACKNOWLEDGED','DISPATCHED','IN_PROGRESS')) open_incidents, (SELECT count(*)::int FROM safety_reports WHERE status='pending') pending_reports,
      (SELECT count(*)::int FROM complaints WHERE status='open') open_complaints, (SELECT count(*)::int FROM groups WHERE status='active') groups, (SELECT count(*)::int FROM trips WHERE status IN ('active','overdue')) active_trips,
      (SELECT count(*)::int FROM client_errors WHERE at>now()-interval '24 hours') client_errors_24h, (SELECT count(*)::int FROM sync_errors WHERE at>now()-interval '24 hours') sync_errors_24h`);
    return { users: r.users, newUsers7d: r.new_users, openIncidents: r.open_incidents, pendingReports: r.pending_reports, openComplaints: r.open_complaints, groups: r.groups, activeTrips: r.active_trips, clientErrors24h: r.client_errors_24h, syncErrors24h: r.sync_errors_24h, realtimeConnections: bus.connections, push: notify.pushConfigured(), mail: 'см. /readyz' };
  };
  A.clientErrors = async (limit = 50) => db.all('SELECT id, at, message, source, line, page FROM client_errors ORDER BY at DESC LIMIT $1', [limit]);
  A.perf = async () => db.all("SELECT metric, count(*)::int n, round(avg(value)::numeric,1)::float avg, round((percentile_cont(0.75) WITHIN GROUP (ORDER BY value))::numeric,1)::float p75 FROM client_perf WHERE at>now()-interval '7 days' GROUP BY metric ORDER BY metric");
