test('спасатель видит только инциденты своей команды и только они ему доступны', async () => {
  const adm = await admin(), d = await staff(env, 'DISPATCHER'); const r1 = await staff(env, 'RESCUER'), r2 = await staff(env, 'RESCUER');
  const t1 = await team(adm, 'Гамма-' + n), t2 = await team(adm, 'Дельта-' + n); await adm.post(`/api/v1/rescue/teams/${t1.id}/members`, { userId: r1.user.id }); await adm.post(`/api/v1/rescue/teams/${t2.id}/members`, { userId: r2.user.id });
  const a = await signup(env), b = await signup(env); const ia = (await a.post('/api/v1/sos', SOS())).body.incident, ib = (await b.post('/api/v1/sos', SOS())).body.incident;
  assert.equal((await r1.get('/api/v1/rescue/incidents/' + ia.id)).status, 404);                                                                  // до назначения не видит
  await d.post(`/api/v1/rescue/incidents/${ia.id}/team`, { teamId: t1.id }); await d.post(`/api/v1/rescue/incidents/${ib.id}/team`, { teamId: t2.id });
  assert.equal((await r1.get('/api/v1/rescue/incidents/' + ia.id)).status, 200);
  assert.equal((await r1.get('/api/v1/rescue/incidents/' + ib.id)).status, 404);
