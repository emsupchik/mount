'use strict';
const R = 6371000;
const rad = d => d * Math.PI / 180;
function haversineM(a, b) {
  const dLat = rad(b.lat - a.lat), dLon = rad(b.lon - a.lon);
  const x = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLon / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(x));
}
/* Дистанция и набор высоты по точкам трека. Шумные скачки отбрасываются:
   точки с погрешностью > 100 м пропускаются, шаг > 2 км за одну запись считается разрывом сигнала,
   набор высоты считается с порогом 3 м, чтобы шум датчика не накапливался. */
function trackStats(points) {
  let dist = 0, gain = 0, movingSec = 0, maxAlt = null, last = null, lastAlt = null;
