/* ── офлайн-карта: честный учёт тайлов, реально сохранённых в кэше ── */
const OfflineMap = {
  tile(x, y, z) { return OSM_TILE.replace('{z}', z).replace('{x}', x).replace('{y}', y); },
  range(b, z) {
