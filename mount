'use strict';
const C = require('../lib/crypto');
const { E } = require('../lib/errors');

const BLOOD = ['unknown', 'O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-'];
const MAX_CONTACTS = 10;

function checkPhoto(s) {
  const m = /^data:image\/(png|jpeg|webp);base64,([A-Za-z0-9+/=]+)$/.exec(s || '');
  if (!m) throw E.validation({ photo: 'допустимы PNG, JPEG или WebP (data URL)' });
  const buf = Buffer.from(m[2], 'base64');
  if (buf.length > 200 * 1024) throw E.validation({ photo: 'файл больше 200 КБ' });
  const sig = buf.subarray(0, 12).toString('latin1');
  const ok = (m[1] === 'png' && buf[0] === 0x89 && sig.slice(1, 4) === 'PNG') || (m[1] === 'jpeg' && buf[0] === 0xff && buf[1] === 0xd8) || (m[1] === 'webp' && sig.slice(0, 4) === 'RIFF' && sig.slice(8, 12) === 'WEBP');
  if (!ok) throw E.validation({ photo: 'содержимое не соответствует формату изображения' });   // защита от подмены типа
  return s;
}

function createProfile({ cfg, db, log, audit, notify, box }) {
  const P = {};
  P.BLOOD = BLOOD;

  P.view = (row, self = true) => ({
    userId: row.user_id, tag: row.tag, fullName: row.full_name, age: row.age, experienceLevel: row.experience_level,
    hikingExperience: row.hiking_experience, bio: row.bio, photo: row.photo, language: row.language,
    notifPrefs: row.notif_prefs, privacy: row.privacy, updatedAt: row.updated_at,
  });
  P.get = async (userId) => { const r = await db.one('SELECT * FROM profiles WHERE user_id=$1', [userId]); if (!r) throw E.notFound('Профиль не найден'); return P.view(r); };
  P.update = async (ctx, d) => {
    const cols = { fullName: 'full_name', age: 'age', experienceLevel: 'experience_level', hikingExperience: 'hiking_experience', bio: 'bio', language: 'language' };
    const sets = [], vals = [ctx.user.id];
    for (const [k, c] of Object.entries(cols)) if (k in d) { vals.push(d[k]); sets.push(c + '=$' + vals.length); }
    if ('photo' in d) { vals.push(d.photo === null ? null : checkPhoto(d.photo)); sets.push('photo=$' + vals.length); }
    if (d.notifPrefs) { vals.push(JSON.stringify(d.notifPrefs)); sets.push("notif_prefs=notif_prefs || $" + vals.length + "::jsonb"); }
    if (d.privacy) { vals.push(JSON.stringify(d.privacy)); sets.push("privacy=privacy || $" + vals.length + "::jsonb"); }
    if (!sets.length) return P.get(ctx.user.id);
    const r = await db.one('UPDATE profiles SET ' + sets.join(',') + ', updated_at=now() WHERE user_id=$1 RETURNING *', vals);
    if (d.privacy) await audit.log(ctx, 'profile.privacy_changed', 'user', ctx.user.id, { keys: Object.keys(d.privacy) });
    return P.view(r);
  };

  /* ── экстренные контакты ── */
  const cview = r => ({ id: r.id, name: r.name, relation: r.relation, phone: r.phone, isPrimary: r.is_primary });
  P.contacts = async (userId) => (await db.all('SELECT * FROM emergency_contacts WHERE user_id=$1 ORDER BY is_primary DESC, created_at', [userId])).map(cview);
  P.addContact = async (ctx, d) => {
    const c = await db.tx(async q => {
      const n = +(await q.one('SELECT count(*)::int n FROM emergency_contacts WHERE user_id=$1', [ctx.user.id])).n;
      if (n >= MAX_CONTACTS) throw E.conflict('Максимум ' + MAX_CONTACTS + ' контактов', 'too_many_contacts');
      const primary = d.isPrimary === true || n === 0;
      if (primary) await q.query('UPDATE emergency_contacts SET is_primary=false WHERE user_id=$1', [ctx.user.id]);
      return q.one('INSERT INTO emergency_contacts(user_id,name,relation,phone,is_primary) VALUES($1,$2,$3,$4,$5) RETURNING *', [ctx.user.id, d.name, d.relation || '', d.phone, primary]);
    });
    return cview(c);
  };
  P.updateContact = async (ctx, id, d) => {
    const r = await db.tx(async q => {
      const cur = await q.one('SELECT * FROM emergency_contacts WHERE id=$1 AND user_id=$2 FOR UPDATE', [id, ctx.user.id]);
      if (!cur) throw E.notFound('Контакт не найден');
      if (d.isPrimary === true && !cur.is_primary) await q.query('UPDATE emergency_contacts SET is_primary=false WHERE user_id=$1', [ctx.user.id]);
      if (d.isPrimary === false && cur.is_primary) throw E.conflict('Выберите другой основной контакт вместо этого', 'primary_required');
      return q.one('UPDATE emergency_contacts SET name=COALESCE($3,name), relation=COALESCE($4,relation), phone=COALESCE($5,phone), is_primary=COALESCE($6,is_primary) WHERE id=$1 AND user_id=$2 RETURNING *',
        [id, ctx.user.id, d.name ?? null, d.relation ?? null, d.phone ?? null, d.isPrimary ?? null]);
    });
    return cview(r);
  };
  P.deleteContact = async (ctx, id) => {
    await db.tx(async q => {
      const cur = await q.one('DELETE FROM emergency_contacts WHERE id=$1 AND user_id=$2 RETURNING is_primary', [id, ctx.user.id]);
      if (!cur) throw E.notFound('Контакт не найден');
      if (cur.is_primary) await q.query('UPDATE emergency_contacts SET is_primary=true WHERE id=(SELECT id FROM emergency_contacts WHERE user_id=$1 ORDER BY created_at LIMIT 1)', [ctx.user.id]);
    });
  };

  /* ── медицинский профиль (шифруется AES-256-GCM; в БД и логах открытого текста нет) ── */
  const emptyMed = () => ({ bloodType: 'unknown', allergies: [], conditions: [], medications: [], notes: '' });
  P.getMedical = async (userId) => { const r = await db.one('SELECT data_enc, updated_at FROM medical_profiles WHERE user_id=$1', [userId]); return r ? Object.assign(emptyMed(), box.open(r.data_enc), { updatedAt: r.updated_at }) : emptyMed(); };
  P.putMedical = async (ctx, d) => {
    const cur = await P.getMedical(ctx.user.id); delete cur.updatedAt;
    const next = Object.assign(cur, d);
    await db.query('INSERT INTO medical_profiles(user_id,data_enc) VALUES($1,$2) ON CONFLICT (user_id) DO UPDATE SET data_enc=EXCLUDED.data_enc, updated_at=now()', [ctx.user.id, box.seal(next)]);
    await audit.log(ctx, 'medical.updated', 'user', ctx.user.id, { fields: Object.keys(d) });   // значения не логируются
    return next;
  };

  /* ── Emergency Card: только необходимое для экстренной ситуации ── */
  P.emergencyCard = async (userId, { medical = true, location = false } = {}) => {
    const p = await db.one('SELECT full_name, tag, age FROM profiles WHERE user_id=$1', [userId]);
    if (!p) throw E.notFound();
    const contacts = (await P.contacts(userId)).map(c => ({ name: c.name, relation: c.relation, phone: c.phone, isPrimary: c.isPrimary }));
    const card = { name: p.full_name || p.tag, tag: p.tag, age: p.age, contacts };
    if (medical) { const m = await P.getMedical(userId); card.medical = { bloodType: m.bloodType, allergies: m.allergies, conditions: m.conditions, medications: m.medications, notes: m.notes }; }
    if (location) {
      const d = await db.one("SELECT lat, lon, accuracy, location_at FROM device_states WHERE user_id=$1 AND location_at > now() - interval '24 hours'", [userId]);
      if (d && d.lat != null) card.lastLocation = { lat: d.lat, lon: d.lon, accuracy: d.accuracy, at: d.location_at };
    }
    return card;
  };

  /* ── экстренный QR: временные отзываемые токены ── */
  P.createQr = async (ctx, { label = '', ttlDays = 90 }) => {
    const t = C.randomToken(24);
    const r = await db.one("INSERT INTO emergency_tokens(user_id,token_hash,label,expires_at) VALUES($1,$2,$3,now()+$4::interval) RETURNING id, expires_at", [ctx.user.id, C.sha256(t), label, ttlDays + ' days']);
    await audit.log(ctx, 'emergency_qr.created', 'emergency_token', r.id);
    const base = cfg.publicUrl || ((cfg.trustProxy && ctx.req && ctx.req.headers['x-forwarded-proto']) || 'http') + '://' + (ctx.req && ctx.req.headers.host || 'localhost');
    return { id: r.id, token: t, url: base + '/e/' + t, expiresAt: r.expires_at, note: 'Токен показывается один раз. Его можно отозвать в любой момент.' };
  };
  P.listQr = async (userId) => (await db.all('SELECT id,label,expires_at,revoked_at,use_count,last_used_at,created_at FROM emergency_tokens WHERE user_id=$1 ORDER BY created_at DESC', [userId]))
    .map(r => ({ id: r.id, label: r.label, expiresAt: r.expires_at, revoked: !!r.revoked_at, useCount: r.use_count, lastUsedAt: r.last_used_at, createdAt: r.created_at }));
  P.revokeQr = async (ctx, id) => { const r = await db.query('UPDATE emergency_tokens SET revoked_at=now() WHERE id=$1 AND user_id=$2 AND revoked_at IS NULL', [id, ctx.user.id]); if (!r.rowCount) throw E.notFound('Токен не найден'); await audit.log(ctx, 'emergency_qr.revoked', 'emergency_token', id); };
  P.openQr = async (ctx, token) => {
    const t = await db.one('UPDATE emergency_tokens SET use_count=use_count+1, last_used_at=now() WHERE token_hash=$1 AND revoked_at IS NULL AND expires_at>now() RETURNING id,user_id', [C.sha256(token || '')]);
    if (!t) { await audit.security('emergency_qr_invalid', { ip: ctx.ip }); throw E.notFound('Ссылка недействительна, отозвана или истекла'); }
    const pr = await db.one('SELECT privacy FROM profiles WHERE user_id=$1', [t.user_id]);
    const card = await P.emergencyCard(t.user_id, { medical: pr.privacy.emergency_qr_medical !== false, location: pr.privacy.emergency_qr_location === true });
    await audit.log({ ip: ctx.ip, actorId: null }, 'emergency_qr.opened', 'emergency_token', t.id, { userId: t.user_id });
    notify.send(t.user_id, { category: 'system', title: 'Открыта ваша экстренная карточка', body: 'Кто-то открыл ссылку из вашего экстренного QR. Если это неожиданно, отзовите QR в профиле.', data: { tokenId: t.id } }).catch(() => {});
    return card;
  };
  return P;
}
module.exports = { createProfile, BLOOD, checkPhoto };


