      try {
        const m = TW.models[e.id] || await X.RouteStore.model(e); TW.models[e.id] = m;
        const c = m.coordinates, a = (m.source && m.source.anchors) || [];
        const first = c[0], last = c[c.length - 1];
        d.route.start = { name: (a[0] && a[0].name) || 'Начало маршрута «' + e.name + '»', lat: +first[0].toFixed(6), lon: +first[1].toFixed(6), source: 'search' };
        d.route.end = { name: (a.length > 1 && a[a.length - 1].name) || (e.landmark && e.landmark.name) || e.name, lat: +last[0].toFixed(6), lon: +last[1].toFixed(6), source: 'search' };
        d.route.waypoints = a.slice(1, -1).filter(x => x.lat != null).map(x => ({ name: x.name, lat: x.lat, lon: x.lon, source: 'search' }));
      } catch (err) { Toast.show(Remote.errText(err), { icon: '⚠️' }); }
    } else {
      d.route.start = null; d.route.waypoints = [];
      d.route.end = e.landmark && e.landmark.lat != null ? { name: e.landmark.name, lat: e.landmark.lat, lon: e.landmark.lon, source: 'search' } : { name: e.name, lat: null, lon: null, source: 'manual' };
    }
    delete TW.errs.end; TW.keepScroll = true; paint(); autoDetect(); loadWeather();
  }

  /* ═════════════ окно выбора дат: календарь (выход → возвращение) и время ═════════════ */
  const MONTHS = ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'];
  const DP = { y: 0, m: 0, s: '', e: '', st: '08:00', et: '18:00', phase: 'start' };
  function datesModal() {
    const sch = TW.d.schedule; Object.assign(DP, { s: sch.startDate || '', e: sch.returnDate || '', st: sch.startTime || '08:00', et: sch.returnTime || '18:00', phase: 'start' });
    const base = new Date((DP.s || ymd(new Date())) + 'T12:00'); DP.y = base.getFullYear(); DP.m = base.getMonth();
    Modal.open({ id: 'twdates', title: '📅 Даты похода', body: '<div id="twdp"></div>' }); dpPaint();
  }
  function dpPaint() {
    const el = $('#twdp'); if (!el) return;
    const first = new Date(DP.y, DP.m, 1), off = (first.getDay() + 6) % 7, days = new Date(DP.y, DP.m + 1, 0).getDate(), today = ymd(new Date());
    let cells = ''; for (let i = 0; i < off; i++) cells += '<span></span>';
    for (let dd = 1; dd <= days; dd++) { const v = ymd(new Date(DP.y, DP.m, dd)), past = v < today, inr = DP.s && DP.e && v > DP.s && v < DP.e;
      cells += `<button type="button" class="tw-day ${v === DP.s ? 'st' : ''} ${v === DP.e ? 'en' : ''} ${inr ? 'in' : ''} ${v === today ? 'today' : ''}" data-date="${v}" ${past ? 'disabled' : ''}>${dd}</button>`; }
    const time = (id, val) => { const [h, mi] = val.split(':'); return `<select id="${id}h" aria-label="часы">${Array.from({ length: 24 }, (_, i) => `<option ${+h === i ? 'selected' : ''}>${pad(i)}</option>`).join('')}</select> : <select id="${id}m" aria-label="минуты">${['00', '15', '30', '45'].map(x => `<option ${mi === x ? 'selected' : ''}>${x}</option>`).join('')}</select>`; };
    const hrs = DP.s && DP.e ? (localMs(DP.e, DP.et) - localMs(DP.s, DP.st)) / 36e5 : null, ins = TW.d.insight;
    el.innerHTML = `<div class="col" style="gap:10px">
      <div class="tw-dp-ph"><button type="button" class="${DP.phase === 'start' ? 'on' : ''}" data-dp="phase" data-v="start"><small>Выход</small><b>${DP.s ? ruDate(DP.s) : 'выберите день'}</b></button><button type="button" class="${DP.phase === 'end' ? 'on' : ''}" data-dp="phase" data-v="end"><small>Возвращение</small><b>${DP.e ? ruDate(DP.e) : 'выберите день'}</b></button></div>
      <div class="row sp"><button type="button" class="btn btn-sm" data-dp="prev" aria-label="предыдущий месяц">‹</button><b>${MONTHS[DP.m]} ${DP.y}</b><button type="button" class="btn btn-sm" data-dp="next" aria-label="следующий месяц">›</button></div>
      <div class="tw-cal"><i>Пн</i><i>Вт</i><i>Ср</i><i>Чт</i><i>Пт</i><i>Сб</i><i>Вс</i>${cells}</div>
      <div class="tw-grid"><div class="field"><label>Время выхода</label><div class="tw-tsel">${time('twdS', DP.st)}</div></div><div class="field"><label>Время возвращения</label><div class="tw-tsel">${time('twdE', DP.et)}</div></div></div>
      <div class="muted-p">${hrs != null ? (hrs > 0 ? 'Продолжительность: <b>' + durText(hrs) + '</b> · ночёвок: <b>' + nightsBetween(DP.s, DP.e) + '</b>' : '<span style="color:#fca5a5">Возвращение раньше выхода</span>') : 'Сначала выберите день выхода, затем день возвращения.'}</div>
      ${ins && DP.s ? `<button type="button" class="btn" data-dp="auto">⏱ По маршруту: ~${ins.totalHours} ч ходьбы (${ins.days} ${plural(ins.days, 'день', 'дня', 'дней')}) — подставить возвращение</button>` : ''}
      <button type="button" class="btn btn-primary" data-dp="ok" style="min-height:52px" ${DP.s && DP.e && hrs > 0 ? '' : 'disabled'}>Готово</button></div>`;
    el.querySelectorAll('[data-date]').forEach(b => { b.onclick = () => { const v = b.dataset.date; if (DP.phase === 'start' || !DP.s || v < DP.s) { DP.s = v; if (DP.e && DP.e < v) DP.e = ''; DP.phase = 'end'; if (!DP.e) DP.e = v; } else { DP.e = v; } dpPaint(); }; });
    const rd = () => { DP.st = $('#twdSh').value + ':' + $('#twdSm').value; DP.et = $('#twdEh').value + ':' + $('#twdEm').value; };
    el.querySelectorAll('select').forEach(x => { x.onchange = () => { rd(); dpPaint(); }; });
    el.querySelectorAll('[data-dp]').forEach(b => { b.onclick = () => { rd(); const a = b.dataset.dp;
      if (a === 'prev') { DP.m--; if (DP.m < 0) { DP.m = 11; DP.y--; } } if (a === 'next') { DP.m++; if (DP.m > 11) { DP.m = 0; DP.y++; } }
      if (a === 'phase') DP.phase = b.dataset.v;
      if (a === 'auto') { const st = new Date(localMs(DP.s, DP.st)); const ins2 = TW.d.insight; let end;
        if (ins2.days <= 1) end = new Date(st.getTime() + Math.ceil(ins2.totalHours * 1.15 + 1) * 36e5); else { end = new Date(st.getTime() + (ins2.days - 1) * 86400e3); end.setHours(18, 0, 0, 0); }
        DP.e = ymd(end); DP.et = pad(end.getHours()) + ':' + (end.getMinutes() < 30 ? '00' : '30'); }
      if (a === 'ok') { const sch = TW.d.schedule; Object.assign(sch, { startDate: DP.s, startTime: DP.st, returnDate: DP.e, returnTime: DP.et }); ['startDate', 'startTime', 'returnDate', 'returnTime'].forEach(k => delete TW.errs[k]); Modal.closeAll(); TW.keepScroll = true; paint(); loadWeather(); if (TW.d.insight && TW.d.routeSel) autoDetect(); return; }
      dpPaint(); }; });
  }

  /* ═════════════ выбор точки: карта / поиск / GPS ═════════════ */
  const getPt = k => { const d = TW.d; if (k === 'start' || k === 'end') return d.route[k]; let m = /^wp(\d+)$/.exec(k); if (m) return d.route.waypoints[+m[1]]; m = /^night(\d+)$/.exec(k); if (m) { const o = d.overnights[+m[1]]; return o.lat != null ? o : null; } return null; };
  const setPt = (k, p) => { const d = TW.d; if (k === 'start' || k === 'end') d.route[k] = p; let m = /^wp(\d+)$/.exec(k); if (m) d.route.waypoints[+m[1]] = p; m = /^night(\d+)$/.exec(k); if (m) { const o = d.overnights[+m[1]]; Object.assign(o, { lat: p.lat, lon: p.lon }); if (!o.name) o.name = p.name; } delete TW.errs[k]; if (k === 'start' || k === 'end' || /^wp/.test(k)) TW.d.routeSel = null; TW.keepScroll = true; paint(); loadWeather(); if (!/^night/.test(k)) autoDetect(); };
  const PICK_LAYERS = [
    { k: 'peaks', ru: 'Вершины', ico: '🏔', c: '#a16207', kinds: ['peak', 'pass'] },
    { k: 'routes', ru: 'Маршруты', ico: '🧭', c: '#8b5cf6' },
    { k: 'rescue', ru: 'Спасатели и укрытия', ico: '🛟', c: '#dc2626', kinds: ['emergency', 'shelter'] },
    { k: 'water', ru: 'Водоёмы', ico: '💧', c: '#2563eb', kinds: ['lake', 'water'] },
    { k: 'camps', ru: 'Стоянки', ico: '⛺', c: '#16a34a', kinds: ['camp', 'rest'] },
  ];
  /* линии всех маршрутов с треком: нажатие — «взять маршрут целиком» */
  async function routeLines(layer) {
    for (const e of (X.RouteStore.list || []).filter(r => r.server && !r.demo && r.geometryStatus === 'available')) {
      try { const mm = TW.models[e.id] || await X.RouteStore.model(e); TW.models[e.id] = mm; if (!layer) return;
        L.polyline(mm.coordinates.map(c => [c[0], c[1]]), { color: '#8b5cf6', weight: 4, opacity: .85 }).bindTooltip('🧭 ' + esc(e.name) + ' — нажмите, чтобы выбрать весь маршрут').on('click', ev => { L.DomEvent.stopPropagation(ev); selectRoute(e.id); }).addTo(layer); }
      catch (err) { /* маршрут без связи — пропускаем */ }
    }
  }
  async function pick(k, mode) {
    if (mode === 'gps') {
      Toast.show('Определяем местоположение…', { icon: '📍' });
      const f = await GeoSvc.requestOnce({ silent: true });
      if (!f) return Toast.show('Не удалось получить GPS. Разрешите доступ к геолокации или выберите точку на карте.', { icon: '⚠️', duration: 7000 });
      const cur = getPt(k);
      return setPt(k, { name: cur && cur.source === 'gps' ? cur.name : 'Моя позиция (±' + Math.round(f.acc) + ' м)', lat: +f.lat.toFixed(6), lon: +f.lon.toFixed(6), source: 'gps' });
    }
    await Promise.all([X.Points.load().catch(() => {}), X.RouteStore.list ? null : X.RouteStore.load().catch(() => {})]);
    const cur = getPt(k);
    Modal.open({ id: 'twpick', title: mode === 'map' ? 'Выберите точку на карте' : 'Поиск точки', body: `<div class="col" style="gap:8px">
      <input id="twq" type="search" placeholder="Название: вершина, маршрут, озеро, спасатели…" autocomplete="off" value="" aria-label="Поиск точки">
      <div class="tw-chips" id="twlay">${PICK_LAYERS.map(l => `<button type="button" class="chip on" data-l="${l.k}">${l.ico} ${l.ru}</button>`).join('')}</div>
      <div class="tw-res" id="twres"></div>
      ${mode === 'map' ? '<div class="muted-p" style="font-size:13px">Нажмите на карту, чтобы поставить точку.</div>' : ''}<div id="twmap" class="tw-map"></div>
      <div class="field"><label for="twpn">Название точки</label><input id="twpn" maxlength="120" value="${esc(cur ? cur.name : '')}"></div>
      <div class="muted-p" id="twpc" style="font-variant-numeric:tabular-nums">${cur && cur.lat != null ? coordTxt(cur) : 'точка не выбрана'}</div>
      <button class="btn btn-primary" id="twpok" style="min-height:50px" ${cur ? '' : 'disabled'}>Выбрать эту точку</button></div>` });
    let sel = cur ? Object.assign({}, cur) : null, mk = null;
    const m = X.mkMap('twmap', sel && sel.lat != null ? [sel.lat, sel.lon] : [43.13, 77.0], sel && sel.lat != null ? 13 : 10);
    const place = (p, src) => { sel = { name: p.name, lat: +(+p.lat).toFixed(6), lon: +(+p.lon).toFixed(6), source: src }; $('#twpn').value = p.name; $('#twpc').textContent = coordTxt(sel); $('#twpok').disabled = false; if (m) { if (mk) mk.setLatLng([sel.lat, sel.lon]); else mk = L.marker([sel.lat, sel.lon]).addTo(m); m.setView([sel.lat, sel.lon], Math.max(m.getZoom(), 13)); } };
    const groups = {};
    if (m) {
      for (const l of PICK_LAYERS) groups[l.k] = L.layerGroup().addTo(m);
      for (const p of X.Points.visible()) { const l = PICK_LAYERS.find(x => x.kinds && x.kinds.includes(p.kind)); if (!l) continue;
        L.circleMarker([p.lat, p.lon], { radius: l.k === 'peaks' ? 6 : 5, color: '#fff', weight: 1.5, fillColor: l.c, fillOpacity: .95 }).bindTooltip(l.ico + ' ' + esc(p.name || '') + (p.ele ? ' · ' + p.ele + ' м' : '')).on('click', ev => { L.DomEvent.stopPropagation(ev); place(p, 'search'); }).addTo(groups[l.k]); }
      routeLines(groups.routes, k);
      $('#twlay').querySelectorAll('[data-l]').forEach(b => { b.onclick = () => { const g = groups[b.dataset.l]; const on = b.classList.toggle('on'); if (on) g.addTo(m); else m.removeLayer(g); }; });
    }
