'use strict';
const { E } = require('../lib/errors');
const { haversineM } = require('../lib/geo');

function createRescue({ db, log, audit, notify, bus, sos }) {
  const R = {};
  const isStaff = u => ['DISPATCHER', 'ADMIN'].includes(u.role);
  const view = (t, members = []) => ({ id: t.id, name: t.name, leaderId: t.leader_id, availability: t.availability, location: t.lat != null ? { lat: t.lat, lon: t.lon, at: t.location_at } : null, speedKmh: t.speed_kmh, equipment: t.equipment, channel: t.channel, active: t.active, members });

  R.list = async (ctx) => {
    if (!['DISPATCHER', 'ADMIN', 'RESCUER'].includes(ctx.user.role)) throw E.forbidden();
    const rows = await db.all(`SELECT t.*, (SELECT count(*)::int FROM sos_incidents i WHERE i.team_id=t.id AND i.status IN ('DISPATCHED','IN_PROGRESS')) AS assigned,
       (SELECT COALESCE(json_agg(json_build_object('userId',u.id,'name',COALESCE(NULLIF(p.full_name,''),p.tag))),'[]') FROM rescue_team_members m JOIN users u ON u.id=m.user_id JOIN profiles p ON p.user_id=u.id WHERE m.team_id=t.id) AS members
       FROM rescue_teams t WHERE t.active ${ctx.user.role === 'RESCUER' ? 'AND t.id IN (SELECT team_id FROM rescue_team_members WHERE user_id=$1)' : ''} ORDER BY t.name`, ctx.user.role === 'RESCUER' ? [ctx.user.id] : []);
    return rows.map(t => Object.assign(view(t, t.members), { assignedIncidents: t.assigned }));
  };
  async function team(id) { const t = await db.one('SELECT * FROM rescue_teams WHERE id=$1', [id]); if (!t) throw E.notFound('Команда не найдена'); return t; }
  async function memberOf(u, teamId) { return !!(await db.one('SELECT 1 FROM rescue_team_members WHERE team_id=$1 AND user_id=$2', [teamId, u.id])); }

  R.create = async (ctx, d) => {
    let t; try { t = await db.one('INSERT INTO rescue_teams(name,leader_id,speed_kmh,equipment,channel) VALUES($1,$2,$3,$4,$5) RETURNING *', [d.name, d.leaderId || null, d.speedKmh || 4, JSON.stringify(d.equipment || []), d.channel || '']); }
    catch (e) { if (e.code === '23505') throw E.conflict('Команда с таким названием уже есть', 'name_taken'); throw e; }
    await audit.log(ctx, 'rescue.team_created', 'team', t.id); return view(t);
  };
  R.update = async (ctx, id, d) => {
    const t = await team(id);
    const dispatcherOnly = Object.keys(d).every(k => ['availability'].includes(k));
    if (ctx.user.role !== 'ADMIN' && !(ctx.user.role === 'DISPATCHER' && dispatcherOnly)) throw E.forbidden('Менять данные команды может администратор');
    if (d.availability && d.availability !== 'busy' && t.availability === 'busy' && await db.one("SELECT 1 FROM sos_incidents WHERE team_id=$1 AND status IN ('DISPATCHED','IN_PROGRESS')", [id])) throw E.conflict('У команды есть активный инцидент', 'team_has_incident');
    const r = await db.one('UPDATE rescue_teams SET name=COALESCE($2,name), leader_id=COALESCE($3,leader_id), availability=COALESCE($4,availability), speed_kmh=COALESCE($5,speed_kmh), equipment=COALESCE($6,equipment), channel=COALESCE($7,channel), active=COALESCE($8,active) WHERE id=$1 RETURNING *',
      [id, d.name ?? null, d.leaderId ?? null, d.availability ?? null, d.speedKmh ?? null, d.equipment ? JSON.stringify(d.equipment) : null, d.channel ?? null, d.active ?? null]);
    await audit.log(ctx, 'rescue.team_updated', 'team', id, { fields: Object.keys(d) });
    bus.publish('staff', 'team.updated', { id });
    return view(r);
  };
  R.addMember = async (ctx, id, userId) => {
    await team(id);
    const u = await db.one("SELECT role FROM users WHERE id=$1 AND status='active'", [userId]);
    if (!u || u.role !== 'RESCUER') throw E.validation({ userId: 'пользователь не имеет роли RESCUER' });
    await db.query('INSERT INTO rescue_team_members(team_id,user_id) VALUES($1,$2) ON CONFLICT DO NOTHING', [id, userId]);
    await bus.refreshUser(userId);
    await audit.log(ctx, 'rescue.team_member_added', 'team', id, { userId });
  };
  R.removeMember = async (ctx, id, userId) => { const r = await db.query('DELETE FROM rescue_team_members WHERE team_id=$1 AND user_id=$2', [id, userId]); if (!r.rowCount) throw E.notFound('Участник не найден'); await bus.refreshUser(userId); await audit.log(ctx, 'rescue.team_member_removed', 'team', id, { userId }); };

  /* Местоположение команды: обновляют участники команды (или диспетчер). ETA всех назначенных инцидентов пересчитывается. */
  R.updateLocation = async (ctx, id, p) => {
    const t = await team(id);
    if (!(isStaff(ctx.user) || (ctx.user.role === 'RESCUER' && await memberOf(ctx.user, id)))) throw E.forbidden();
    await db.query('UPDATE rescue_teams SET lat=$2, lon=$3, location_at=now() WHERE id=$1', [id, p.lat, p.lon]);
    const inc = await db.all("SELECT id, lat, lon FROM sos_incidents WHERE team_id=$1 AND status IN ('DISPATCHED','IN_PROGRESS')", [id]);
    const out = [];
    for (const i of inc) {
      if (i.lat == null) continue;
      const eta = Math.max(1, Math.ceil(haversineM(p, i) / 1000 * 1.3 / t.speed_kmh * 60));
      await db.query('UPDATE sos_incidents SET eta_min=$2, updated_at=now() WHERE id=$1', [i.id, eta]);
      out.push({ id: i.id, etaMin: eta, distanceKm: +(haversineM(p, i) / 1000).toFixed(2) });
    }
    bus.publish(['staff', 'team:' + id], 'team.location', { id, lat: p.lat, lon: p.lon, incidents: out });
    return { updated: out };
  };
  /* Операции команды: назначенные сейчас и история миссий */
  R.missions = async (ctx, id) => {
    await team(id);
    if (!(isStaff(ctx.user) || (ctx.user.role === 'RESCUER' && await memberOf(ctx.user, id)))) throw E.forbidden();
    const rows = await db.all("SELECT id, code, status, priority, situation, received_at, dispatched_at, resolved_at, cancelled_at, resolution FROM sos_incidents WHERE team_id=$1 OR id IN (SELECT incident_id FROM incident_events WHERE type='team_assigned' AND (data->>'teamId')=$2::text) ORDER BY received_at DESC LIMIT 100", [id, id]);
    return rows.map(r => ({ id: r.id, code: r.code, status: r.status, priority: r.priority, situation: r.situation, receivedAt: r.received_at, dispatchedAt: r.dispatched_at, finishedAt: r.resolved_at || r.cancelled_at, resolution: r.resolution, durationSec: r.dispatched_at && (r.resolved_at || r.cancelled_at) ? Math.round((new Date(r.resolved_at || r.cancelled_at) - new Date(r.dispatched_at)) / 1000) : null }));
  };
  return R;
}
module.exports = { createRescue };


