'use strict';
const crypto = require('node:crypto');

/* ── пароли: scrypt (встроенный, устойчивый к GPU), соль на пользователя ── */
const SCRYPT = { N: 16384, r: 8, p: 1, len: 64 };
const scrypt = (pw, salt, o) => new Promise((ok, bad) => crypto.scrypt(pw, salt, o.len, { N: o.N, r: o.r, p: o.p, maxmem: 64 * 1024 * 1024 }, (e, k) => e ? bad(e) : ok(k)));
async function hashPassword(pw) {
  const salt = crypto.randomBytes(16);
  const key = await scrypt(pw.normalize('NFKC'), salt, SCRYPT);
  return ['scrypt', SCRYPT.N, SCRYPT.r, SCRYPT.p, salt.toString('base64'), key.toString('base64')].join('$');
}
async function verifyPassword(pw, stored) {
  try {
    const [alg, N, r, p, salt, hash] = String(stored || '').split('$');
    if (alg !== 'scrypt') return false;
    const want = Buffer.from(hash, 'base64');
    const got = await scrypt(pw.normalize('NFKC'), Buffer.from(salt, 'base64'), { N: +N, r: +r, p: +p, len: want.length });
    return got.length === want.length && crypto.timingSafeEqual(got, want);
  } catch (e) { return false; }
}
/* Фиктивная проверка, чтобы время ответа не выдавало существование email */
const DUMMY = '$scrypt$';
async function fakeVerify(pw) { await scrypt(String(pw).normalize('NFKC'), Buffer.alloc(16), SCRYPT); return false; }

/* ── случайные токены (хранится только SHA-256) ── */
const randomToken = (bytes = 32) => crypto.randomBytes(bytes).toString('base64url');
const sha256 = s => crypto.createHash('sha256').update(String(s)).digest('hex');
const safeEq = (a, b) => { const x = Buffer.from(String(a)), y = Buffer.from(String(b)); return x.length === y.length && crypto.timingSafeEqual(x, y); };

/* ── JWT HS256 (только access-токен; роль в нём НЕ хранится) ── */
const b64 = o => Buffer.from(JSON.stringify(o)).toString('base64url');
function signJwt(payload, secret, ttlSec) {
  const now = Math.floor(Date.now() / 1000);
  const body = Object.assign({}, payload, { iat: now, exp: now + ttlSec });
  const h = b64({ alg: 'HS256', typ: 'JWT' }), p = b64(body);
  const sig = crypto.createHmac('sha256', secret).update(h + '.' + p).digest('base64url');
  return h + '.' + p + '.' + sig;
}
function verifyJwt(token, secret) {
  const parts = String(token || '').split('.');
  if (parts.length !== 3) return null;
  const [h, p, s] = parts;
  try {
    if (JSON.parse(Buffer.from(h, 'base64url').toString()).alg !== 'HS256') return null;
    const want = crypto.createHmac('sha256', secret).update(h + '.' + p).digest('base64url');
    if (!safeEq(s, want)) return null;
    const body = JSON.parse(Buffer.from(p, 'base64url').toString());
    if (!body.exp || body.exp < Math.floor(Date.now() / 1000)) return null;
    return body;
  } catch (e) { return null; }
}

/* ── шифрование медицинских данных на уровне приложения: AES-256-GCM ── */
function makeBox(keyB64) {
  const key = Buffer.from(keyB64, 'base64');
  return {
    seal(obj) {
      const iv = crypto.randomBytes(12), c = crypto.createCipheriv('aes-256-gcm', key, iv);
      const enc = Buffer.concat([c.update(JSON.stringify(obj), 'utf8'), c.final()]);
      return 'v1.' + Buffer.concat([iv, c.getAuthTag(), enc]).toString('base64');
    },
    open(s) {
      if (!s) return null;
      const raw = Buffer.from(String(s).replace(/^v1\./, ''), 'base64');
      const d = crypto.createDecipheriv('aes-256-gcm', key, raw.subarray(0, 12)); d.setAuthTag(raw.subarray(12, 28));
      return JSON.parse(Buffer.concat([d.update(raw.subarray(28)), d.final()]).toString('utf8'));
    },
  };
}
module.exports = { hashPassword, verifyPassword, fakeVerify, randomToken, sha256, safeEq, signJwt, verifyJwt, makeBox };


