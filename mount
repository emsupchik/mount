    <div class="sec-head"><h2>Предупреждения безопасности (${al.length})</h2></div>${al.map(a => `<div class="card"><div class="row sp"><b>${jsq(a.title)}</b><span class="badge ${a.severity === 'CRITICAL' || a.severity === 'DANGER' ? 'red' : ''}">${jsq(a.severity)}</span></div><div class="muted-p">${jsq(a.kind)} · источник: ${jsq(a.source)} · до ${dt(isoMs(a.expiresAt))}</div><button class="btn btn-sm btn-ghost" data-action="alCancel" data-id="${a.id}">Отменить предупреждение</button></div>`).join('') || '<div class="muted-p">Активных предупреждений нет</div>'}
    <div class="card"><div class="sect-t">Новое предупреждение</div><p class="muted-p" style="font-size:12px">Только проверенная информация с указанием источника. Предупреждение получат пользователи с походом по маршруту или находящиеся рядом.</p><form data-rform="newalert"><div class="form-grid"><div class="field"><label>Тип</label><select name="kind">${[['severe_weather', 'Сильная погода'], ['avalanche', 'Лавинная опасность'], ['landslide', 'Оползень'], ['flood', 'Наводнение'], ['route_hazard', 'Опасный участок'], ['route_closed', 'Закрытие маршрута'], ['wildfire', 'Лесной пожар'], ['extreme_temperature', 'Экстремальная температура'], ['river_crossing', 'Опасная переправа']].map(o => `<option value="${o[0]}">${o[1]}</option>`).join('')}</select></div><div class="field"><label>Уровень</label><select name="severity">${['INFO', 'WARNING', 'DANGER', 'CRITICAL'].map(o => `<option>${o}</option>`).join('')}</select></div><div class="field span-2"><label>Заголовок</label><input name="title" maxlength="140"></div><div class="field span-2"><label>Описание</label><input name="body" maxlength="500"></div><div class="field"><label>Широта</label><input name="lat" placeholder="43.05"></div><div class="field"><label>Долгота</label><input name="lon" placeholder="76.98"></div><div class="field"><label>Радиус, км</label><input name="radius" type="number" value="10"></div><div class="field"><label>Действует, часов</label><input name="ttl" type="number" value="24"></div><div class="field span-2"><label>Источник (обязательно)</label><input name="source" placeholder="Кто и откуда сообщил"></div><div class="field span-2"><label>Ссылка на источник</label><input name="url" placeholder="https://"></div></div><button class="btn btn-primary" type="submit">Опубликовать</button></form></div>`;
  },
