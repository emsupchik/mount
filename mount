    const pistes = els.filter(e => e.tags && e.tags['piste:type'] === 'downhill').map(e => ({ ...pos(e), diff: e.tags['piste:difficulty'] || null, name: e.tags.name || null })).filter(x => x.lat != null);
    let n = 0; const need = [];
    for (const e of els) {
      const t = e.tags || {}; const kind = kindOf(t); if (!kind) continue; if (t.aerialway || t['piste:type']) continue;
      const p = pos(e); if (!p) continue;
      const name = t['name:ru'] || t.name || t['name:en'] || t['name:kk'] || KIND_RU[kind];
      const ele = t.ele && /^-?\d+(\.\d+)?$/.test(String(t.ele).trim()) ? Math.round(parseFloat(t.ele)) : null;
      const extra = { osm: true, tags: Object.fromEntries(Object.entries(t).filter(([k]) => /^(name|ele|access|fee|opening_hours|capacity|drinking_water|shelter_type|website|phone|operator|description|seasonal|tower:type)/.test(k))) };
      if (kind === 'ski_resort') {
        const near = (arr) => arr.filter(x => Engine.Geo.dist(p, x) <= 3500);
        const L = near(lifts), Pi = near(pistes);
        extra.lifts = L.length ? { count: L.length, items: L.slice(0, 40) } : null; extra.pistes = Pi.length ? { count: Pi.length, byDifficulty: Pi.reduce((a, x) => { a[x.diff || 'unknown'] = (a[x.diff || 'unknown'] || 0) + 1; return a; }, {}) } : null;
        extra.season = t.seasonal || t.opening_hours || null; extra.status = t.disused ? 'disused' : null;
      }
      const src = { t: 'OpenStreetMap contributors', u: `https://www.openstreetmap.org/${e.type}/${e.id}`, license: 'ODbL 1.0' };
      const row = await db.one(`INSERT INTO mountain_points(kind,name,description,lat,lon,ele_m,access,status,source,osm_type,osm_id,extra,last_updated,fetched_at)
        VALUES($1,$2,$3,$4,$5,$6,$7,'verified',$8,$9,$10,$11,$12,now())
        ON CONFLICT (osm_type, osm_id) WHERE osm_id IS NOT NULL DO UPDATE SET kind=EXCLUDED.kind, name=EXCLUDED.name, description=EXCLUDED.description, lat=EXCLUDED.lat, lon=EXCLUDED.lon,
          ele_m=COALESCE(EXCLUDED.ele_m, CASE WHEN mountain_points.extra->>'eleSource'='dem' THEN mountain_points.ele_m END), access=EXCLUDED.access, source=EXCLUDED.source,
          extra=EXCLUDED.extra || CASE WHEN EXCLUDED.ele_m IS NULL AND mountain_points.extra->>'eleSource'='dem' THEN '{"eleSource":"dem"}'::jsonb ELSE '{}'::jsonb END,
          last_updated=EXCLUDED.last_updated, fetched_at=now() RETURNING id, ele_m`,
      [kind, name.slice(0, 160), (t.description || '').slice(0, 500), p.lat, p.lon, ele, t.access || (t.fee === 'yes' ? 'платно' : null), JSON.stringify(src), e.type, e.id, JSON.stringify(extra), e.timestamp ? new Date(e.timestamp) : null]);
      n++; if (row.ele_m == null) need.push({ id: row.id, ...p });
    }
    /* высоты для точек без тега ele — из DEM, с пометкой */
    let dem = 0;
    if (need.length) { try { const el = await G.elevations(need); for (let i = 0; i < need.length; i++) if (el[i] != null) { await db.query(`UPDATE mountain_points SET ele_m=$2, extra=extra || '{"eleSource":"dem"}'::jsonb WHERE id=$1`, [need[i].id, Math.round(el[i])]); dem++; } } catch (e) { log.warn({ err: e }, 'DEM elevation fill failed'); } }
    await audit.log(ctx, 'geo.points_refreshed', 'mountain_points', null, { count: n, dem, bbox });
    log.event('geo', 'osm_refresh', { count: n, dem });
    return { imported: n, elevationFromDem: dem, lifts: lifts.length, pistes: pistes.length, source: 'OpenStreetMap (Overpass API), ODbL' };
  };

  /* ── маршруты ── */
  const routeRow = async (slugOrId) => {
    const r = /^[0-9a-f-]{36}$/i.test(slugOrId) ? await db.one('SELECT * FROM routes WHERE id=$1', [slugOrId]) : await db.one('SELECT * FROM routes WHERE slug=$1', [slugOrId]);
    if (!r || r.status === 'removed') throw E.notFound('Маршрут не найден'); return r;
  };
  G.routeModel = async (slugOrId, user) => {
    const r = await routeRow(slugOrId);
    if (!r.is_public && (!user || (user.id !== r.owner_id && !['ADMIN', 'DISPATCHER'].includes(user.role)))) throw E.notFound('Маршрут не найден');
    const pts = await db.all('SELECT lat, lon, ele FROM route_points WHERE route_id=$1 ORDER BY seq', [r.id]);
    const model = {
      id: r.id, slug: r.slug, name: r.name, description: r.description, region: r.region,
      coordinates: pts.map(p => [p.lat, p.lon, p.ele == null ? null : Math.round(p.ele)]),
      distance: r.geometry_km != null ? +r.geometry_km : null, elevationGain: r.elevation_gain_m, elevationLoss: r.elevation_loss_m, estimatedDuration: r.estimated_min,
      difficulty: r.difficulty, season: r.seasons, kind: r.route_kind, checkpoints: r.checkpoints, hazards: r.hazards,
      declared: { distanceKm: r.distance_km != null ? +r.distance_km : null, gainM: r.gain_m, maxAltM: r.max_alt_m, sources: r.sources },
      source: r.geometry_source, geometryUpdatedAt: r.geometry_updated_at, landmark: r.landmark, origin: r.origin, insight: r.insight || insightFromCatalog(r),
      geometryStatus: pts.length >= 2 ? 'available' : 'pending',
