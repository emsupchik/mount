/* Web Push: подписка через Service Worker, публичный ключ отдаёт сервер */
const Push = {
  supported: () => 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window,
  b64: s => { const p = '='.repeat((4 - s.length % 4) % 4), b = (s + p).replace(/-/g, '+').replace(/_/g, '/'), r = atob(b); return Uint8Array.from([...r].map(c => c.charCodeAt(0))); },
  async describe() {
    if (!this.supported()) return 'Этот браузер не поддерживает push-уведомления.';
    const cfg = await Remote.get('/push/config', { noAuth: true }).catch(() => null); if (!cfg || !cfg.enabled) return 'На сервере не настроен Web Push (нужны ключи VAPID). Уведомления работают внутри приложения.';
    if (Notification.permission === 'denied') return 'Уведомления запрещены в настройках браузера.';
    try { const reg = await navigator.serviceWorker.ready, sub = await reg.pushManager.getSubscription(); return sub ? 'Push включён на этом устройстве.' : 'Push выключен на этом устройстве.'; } catch (e) { return 'Service Worker не активен (нужен https и установленное приложение).'; }
  },
  async enable() {
    if (!this.supported()) throw new Error('Браузер не поддерживает push');
    const cfg = await Remote.get('/push/config', { noAuth: true }); if (!cfg.enabled) throw new Error('На сервере не настроен Web Push (VAPID)');
    const perm = await Notification.requestPermission(); if (perm !== 'granted') throw new Error('Разрешение на уведомления не выдано');
    const reg = await navigator.serviceWorker.ready; let sub = await reg.pushManager.getSubscription();
    if (!sub) sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.b64(cfg.publicKey) });
    const j = sub.toJSON(); await Remote.post('/push/subscribe', { endpoint: j.endpoint, keys: j.keys });
  },
  async disable() { const reg = await navigator.serviceWorker.ready, sub = await reg.pushManager.getSubscription(); if (sub) { await Remote.del('/push/subscribe', { endpoint: sub.endpoint }).catch(() => {}); await sub.unsubscribe(); } },
};

