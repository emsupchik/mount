  async function overpass(q) {
    let r; try { r = await F(cfg.geo.overpassUrl, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'User-Agent': 'MountainSafe/3 (+' + (cfg.publicUrl || 'localhost') + ')' }, body: 'data=' + encodeURIComponent(q), signal: AbortSignal.timeout(90000) }); }
    catch (e) { throw E.unavailable('OpenStreetMap (Overpass) недоступен: ' + (e.message || e), 'overpass_unreachable'); }
