.sim-sources small{color:var(--ink-2)}
.sim-src{font:700 10.5px var(--label);letter-spacing:.1em;padding:3px 8px;border-radius:6px;text-align:center}
.sim-src.demo{background:rgba(245,197,66,.12);color:#f5c542;border:1px solid #7a6420}.sim-src.real{background:rgba(52,211,153,.12);color:var(--ok);border:1px solid #2a7a4c}.sim-src.est{background:rgba(167,139,250,.12);color:#c4b5fd;border:1px solid #5b4a9a}
@media(max-width:700px){.sim-sources li{grid-template-columns:1fr auto}.sim-sources li small{grid-column:1/-1}}

/* сцена: карта + колонка риска */
.sim-stage{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr);gap:16px;align-items:stretch}
@media(max-width:959px){.sim-stage{grid-template-columns:1fr}}
.sim-mapwrap{position:relative;isolation:isolate;z-index:0;border-radius:18px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow-sm);min-height:440px;background:#0f1a16}
.sim-map.map{height:100%;min-height:440px;border:0;border-radius:0}
.sim-hud{position:absolute;left:12px;top:12px;right:12px;z-index:500;display:flex;justify-content:space-between;align-items:flex-start;gap:10px;pointer-events:none;flex-wrap:wrap}
.sim-clock{background:rgba(10,19,16,.86);backdrop-filter:blur(8px);border:1px solid var(--line-2);border-radius:12px;padding:8px 12px;display:flex;flex-direction:column;line-height:1.15}
