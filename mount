test('админ-панель недоступна не-администраторам (включая диспетчеров и спасателей) на всех эндпоинтах', async () => {
  const roles = [await signup(env), await staff(env, 'DISPATCHER'), await staff(env, 'RESCUER')]; const lead = await signup(env); await lead.post('/api/v1/groups', { name: 'Лидер' }); roles.push(lead);
  const routes = [['get', '/api/v1/admin/overview'], ['get', '/api/v1/admin/users'], ['get', '/api/v1/admin/audit'], ['get', '/api/v1/admin/security'], ['get', '/api/v1/admin/metrics'], ['get', '/api/v1/admin/settings'], ['get', '/api/v1/admin/routes'], ['get', '/api/v1/admin/client-errors'],
    ['post', '/api/v1/admin/users', { email: 'x@test.local', password: 'Xxxxx-pass-123', fullName: 'X', role: 'ADMIN' }], ['post', '/api/v1/admin/broadcast', { title: 'abc', body: 'abc' }], ['put', '/api/v1/admin/settings/registration_open', { value: false }]];
  for (const c of roles) for (const [m, p, b] of routes) { const r = await c[m](p, b); assert.equal(r.status, 403, `${c.user.role} ${m} ${p} → ${r.status}`); }
  const anon = client(env); for (const [m, p, b] of routes) assert.equal((await anon[m](p, b)).status, 401, p);
});

