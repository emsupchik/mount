const VideoBg = {
  URL: 'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260329_050842_be71947f-f16e-4a14-810c-06e83d23ddb5.mp4',
  FADE_MS: 250, FADE_OUT_BEFORE_END: 0.55,
  mount(video) {
    if (!video) return;
    let rafId = null, fadingOut = false, restart = null;                 // fadingOutRef
    const alive = () => video.isConnected;
    const cancel = () => { if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; } };
    /* плавно от ТЕКУЩЕЙ opacity к target; каждая новая анимация отменяет предыдущую */
    const fadeTo = (target, ms) => {
      cancel(); const from = parseFloat(video.style.opacity || '0') || 0; if (from === target) return;
      const t0 = performance.now();
      const step = now => { if (!alive()) return; const k = Math.min(1, (now - t0) / ms); video.style.opacity = String(from + (target - from) * k); rafId = k < 1 ? requestAnimationFrame(step) : null; };
      step(t0);
    };
    const fadeIn = () => fadeTo(1, this.FADE_MS), fadeOut = () => fadeTo(0, this.FADE_MS);
    video.style.opacity = '0';
    video.addEventListener('loadeddata', () => { fadingOut = false; fadeIn(); });
    video.addEventListener('playing', () => { if (!fadingOut) fadeIn(); });
    video.addEventListener('timeupdate', () => { const d = video.duration; if (!isFinite(d) || d <= 0) return; if (!fadingOut && d - video.currentTime <= this.FADE_OUT_BEFORE_END) { fadingOut = true; fadeOut(); } });
    video.addEventListener('ended', () => {
      cancel(); video.style.opacity = '0'; clearTimeout(restart);
      restart = setTimeout(() => { if (!alive()) return; video.currentTime = 0; fadingOut = false; const p = video.play(); if (p && p.catch) p.catch(() => {}); fadeIn(); }, 100);
    });
    video.addEventListener('error', () => { video.style.opacity = '0'; });        // нет сети или видео недоступно: остаётся белый фон
    const p = video.play(); if (p && p.catch) p.catch(() => window.addEventListener('pointerdown', () => video.play().catch(() => {}), { once: true }));
    this.api = { fadeIn, fadeOut };
  },
};
