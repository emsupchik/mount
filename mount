.sim-fin-lv{font:700 clamp(24px,3vw,34px) var(--display);margin-top:6px}.sim-fin-lv b{color:var(--lv)}.sim-fin-lv .mono{font-size:.6em;color:var(--ink-3)}
.sim-fin-p{color:var(--ink-2);font-size:16px;margin-top:4px}
.sim-check{display:flex;flex-direction:column;gap:7px;margin-top:8px}
