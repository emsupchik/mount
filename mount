'use strict';
const { E } = require('../lib/errors');
/* Twilio Verify: код генерирует, отправляет и проверяет провайдер. Ключи только на сервере. */
function createSms(cfg, log) {
  const T = cfg.twilio, live = () => !!(T.sid && T.token && T.service);
  async function call(path, form) {
    const r = await fetch(T.base + '/v2/Services/' + encodeURIComponent(T.service) + path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', Authorization: 'Basic ' + Buffer.from(T.sid + ':' + T.token).toString('base64') }, body: new URLSearchParams(form).toString(), signal: AbortSignal.timeout(10000) });
    return { ok: r.ok, status: r.status, body: await r.json().catch(() => ({})) };
  }
  return {
    live, length: cfg.smsCodeLength,
    status: () => ({ mode: live() ? 'live' : 'demo', length: cfg.smsCodeLength }),
    async start(phone) {
      if (!live()) throw E.unavailable('SMS-провайдер не настроен на сервере', 'sms_not_configured');
      try { const r = await call('/Verifications', { To: phone, Channel: 'sms', Locale: 'ru' }); if (!r.ok) { log.warn({ status: r.status, code: r.body && r.body.code, msg: 'twilio start failed' }); throw E.unavailable('Не удалось отправить SMS. Проверьте номер и попробуйте позже', 'sms_failed'); } return true; }
      catch (e) { if (e.status) throw e; throw E.unavailable('SMS-провайдер не отвечает', 'sms_failed'); }
    },
    async check(phone, code) {
      if (!live()) throw E.unavailable('SMS-провайдер не настроен на сервере', 'sms_not_configured');
      try { const r = await call('/VerificationCheck', { To: phone, Code: code }); if (r.status === 404) return false; if (!r.ok) throw E.unavailable('Не удалось проверить код', 'sms_failed'); return r.body.status === 'approved'; }
      catch (e) { if (e.status) throw e; throw E.unavailable('SMS-провайдер не отвечает', 'sms_failed'); }
    },
  };
}
module.exports = { createSms };


