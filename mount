.sim-why-l li:nth-child(2){animation-delay:.08s}.sim-why-l li:nth-child(3){animation-delay:.16s}.sim-why-l li:nth-child(4){animation-delay:.24s}.sim-why-l li:nth-child(5){animation-delay:.32s}
.sim-why-l b{min-width:40px;font-size:15px}
.sim-why-l li.up b{color:var(--crit)}.sim-why-l li.down b{color:var(--ok)}
.sim-why-t{font:500 14px var(--label);color:var(--ink-2);padding-top:4px;border-top:1px solid var(--line)}.sim-why-t b{color:var(--ink);font-size:16px}

/* таймлайн */
.sim-tl{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;position:relative}
.sim-tl::before{content:"";position:absolute;left:8px;right:8px;top:21px;height:2px;background:linear-gradient(90deg,var(--line-2),var(--line-2));z-index:0}
@media(max-width:1100px){.sim-tl{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(230px,1fr);overflow-x:auto;padding-bottom:6px;scroll-snap-type:x mandatory}.sim-step{scroll-snap-align:start}}
