'use strict';
/* Тексты согласий на обработку персональных данных.
   Текст по умолчанию — черновик для юридической проверки, а НЕ подтверждённо соответствующий законодательству РК текст.
   Администратор меняет его в «Диспетчерская → Согласие ПДн»; каждая правка сохраняется новой версией,
   а в походе хранится номер версии, с которой согласился пользователь. */
const { E } = require('../lib/errors');

const KEYS = ['trip_pd'];

function defaultText(cfg) {
  const operator = cfg.pd.operator || 'владелец и администратор сервиса Mountain Safe' + (cfg.publicUrl ? ' (' + cfg.publicUrl.replace(/^https?:\/\//, '') + ')' : '');
  const contact = cfg.pd.contact || cfg.adminEmail || 'адрес электронной почты администратора сервиса';
  const hosting = cfg.pd.hosting || 'сервер сервиса Mountain Safe (место размещения указывает администратор)';
  const mail = cfg.email && cfg.email.provider && cfg.email.provider !== 'none' ? cfg.email.provider : null;
  return {
    title: 'Согласие на сбор и обработку персональных данных',
    body: [
      '1. Какие данные собираются. Фамилия, имя, отчество (если указано) и номер телефона ответственного за группу; фамилия, имя, отчество (если указано) и, при желании, номер телефона каждого участника; отметка о согласии участника. Также маршрут похода, даты, места ночёвок и, во время похода, геопозиция ответственного, если он включил отслеживание. ИИН, паспортные данные и адрес проживания не собираются.',
      '2. Цель обработки. Подготовка и сопровождение похода: связь с группой, контроль времени возвращения и передача сведений о группе диспетчеру Mountain Safe и экстренным службам, если включён SOS или группа не вернулась в срок.',
      '3. Оператор и ответственный за обработку: ' + operator + '. Обращения по персональным данным: ' + contact + '.',
      '4. Срок обработки. Данные участников хранятся на время похода и 90 дней после его завершения или отмены, после чего удаляются автоматически. Ответственный может удалить данные раньше, удалив поход в приложении.',
      '5. Передача третьим лицам. Только диспетчеру Mountain Safe и экстренным службам — при SOS или просрочке возвращения, а также поставщикам технической инфраструктуры (хостинг, отправка email/SMS) в объёме, необходимом для доставки уведомления. Данные не продаются и не используются для рекламы.',
      '6. Трансграничная передача. Данные хранятся: ' + hosting + '. ' + (mail ? 'Экстренные уведомления по email отправляются через сервис «' + mail + '», серверы которого могут находиться за пределами Республики Казахстан.' : 'Если администратор подключит внешний сервис отправки уведомлений, сведения о нём будут указаны здесь.'),
      '7. Отзыв согласия. Согласие можно отозвать в случаях, предусмотренных законодательством, направив обращение оператору или удалив поход в приложении.',
      '8. Ответственный за группу подтверждает, что каждый участник, чьи данные он вносит, ознакомлен с этим текстом и дал согласие (отметка у каждого участника).',
    ].join('\n\n'),
  };
}

function createConsent({ cfg, db, audit }) {
  const C = {};
  C.current = async (key = 'trip_pd') => {
    if (!KEYS.includes(key)) throw E.notFound('Нет такого текста согласия');
    const r = await db.one('SELECT version, title, body, created_at FROM consent_texts WHERE key=$1 ORDER BY version DESC LIMIT 1', [key]);
    if (r) return { key, version: r.version, title: r.title, body: r.body, updatedAt: r.created_at, isDefault: false };
    return Object.assign({ key, version: 0, updatedAt: null, isDefault: true }, defaultText(cfg));
  };
  C.save = async (ctx, key, { title, body }) => {
    if (!KEYS.includes(key)) throw E.notFound('Нет такого текста согласия');
    const cur = await C.current(key);
    const r = await db.one('INSERT INTO consent_texts(key,version,title,body,created_by) VALUES($1,$2,$3,$4,$5) RETURNING version, created_at', [key, cur.version + 1, title, body, ctx.user.id]);
    await audit.log(ctx, 'consent.updated', 'consent', key, { version: r.version });
    return C.current(key);
  };
  C.history = async (key = 'trip_pd') => db.all('SELECT version, title, created_at FROM consent_texts WHERE key=$1 ORDER BY version DESC LIMIT 50', [key]);
  return C;
}
module.exports = { createConsent, defaultText };


