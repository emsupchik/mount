const Bus = {
  h: {},
  on(e, f) { (this.h[e] || (this.h[e] = [])).push(f); return () => this.off(e, f); },
  off(e, f) { this.h[e] = (this.h[e] || []).filter(x => x !== f); },
  emit(e, p) { (this.h[e] || []).slice().forEach(f => { try { f(p); } catch (err) { console.error(err); } }); },
};

