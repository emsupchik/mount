  assert.equal((await r1.post(`/api/v1/rescue/incidents/${ia.id}/priority`, { priority: 'LOW' })).status, 403);
  assert.equal((await r1.get('/api/v1/rescue/log')).status, 403);
  assert.equal((await r1.get(`/api/v1/rescue/teams/${t2.id}/missions`)).status, 403);
