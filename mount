'use strict';
/* Real-time: Server-Sent Events. Клиент подписывается на темы (user:<id>, group:<id>, staff),
   события доставляются мгновенно. Для нескольких экземпляров сервера события пересылаются через Postgres LISTEN/NOTIFY.
   SSE выбран вместо WebSocket: работает через обычный HTTP/прокси, сам переподключается, экономнее по батарее на мобильных. */
const crypto = require('node:crypto');

function createBus(db, log) {
  const inst = crypto.randomBytes(6).toString('hex');
  const conns = new Map();           // connId -> {res, userId, topics:Set, role}
  let seq = 0, listener = null, closed = false;

  function dispatchLocal(topics, type, data, id) {
    const payload = 'id: ' + id + '\nevent: ' + type + '\ndata: ' + JSON.stringify(data) + '\n\n';
    let n = 0;
    for (const c of conns.values()) {
      if (topics.some(t => c.topics.has(t))) { try { c.res.write(payload); n++; } catch (e) { /* закрыто */ } }
    }
    return n;
  }
  const bus = {
    inst,
    get connections() { return conns.size; },
    publish(topics, type, data = {}) {
      topics = [].concat(topics); const id = ++seq;
      dispatchLocal(topics, type, data, id);
      if (listener) {
        let msg = JSON.stringify({ i: inst, t: topics, y: type, d: data });
        if (msg.length > 7500) msg = JSON.stringify({ i: inst, t: topics, y: type, d: { truncated: true, id: data.id } });
        db.query('SELECT pg_notify($1,$2)', ['ms_events', msg]).catch(e => log.warn({ err: e }, 'notify failed'));
      }
    },
    /* topics пользователя определяются на сервере по его реальным правам, а не по запросу клиента */
    async topicsFor(userId, role) {
      const t = new Set(['user:' + userId]);
      const g = await db.all("SELECT group_id FROM group_members WHERE user_id=$1 AND status='active'", [userId]);
      g.forEach(r => t.add('group:' + r.group_id));
      if (['DISPATCHER', 'ADMIN'].includes(role)) t.add('staff');            // весь поток инцидентов — только диспетчерам и админам
      if (role === 'RESCUER') (await db.all('SELECT team_id FROM rescue_team_members WHERE user_id=$1', [userId])).forEach(r => t.add('team:' + r.team_id));   // спасатель — только события своей команды
      return t;
    },
    async attach(res, user) {
      const id = crypto.randomBytes(6).toString('hex');
      const c = { res, userId: user.id, role: user.role, topics: await bus.topicsFor(user.id, user.role) };
      // не более 5 одновременных потоков на пользователя: самый старый закрываем (защита от утечки соединений и злоупотребления)
      const mine = [...conns.entries()].filter(([, x]) => x.userId === user.id);
      while (mine.length >= 5) { const [oid, o] = mine.shift(); try { o.res.write('event: superseded\ndata: {}\n\n'); o.res.end(); } catch (e) { /* ignore */ } conns.delete(oid); }
      conns.set(id, c);
      res.on('close', () => conns.delete(id));
      return id;
    },
    async refreshUser(userId) {
      for (const c of conns.values()) if (c.userId === userId) c.topics = await bus.topicsFor(userId, c.role);
    },
    async startListener() {
      try {
        const c = await db.pool.connect(); listener = c;
        c.on('notification', m => {
          try { const p = JSON.parse(m.payload); if (p.i === inst) return; dispatchLocal(p.t, p.y, p.d, ++seq); } catch (e) { /* ignore */ }
        });
        c.on('error', () => { listener = null; if (!closed) setTimeout(() => bus.startListener(), 2000).unref(); });
        await c.query('LISTEN ms_events');
      } catch (e) { log.warn({ err: e }, 'bus listener not started'); listener = null; }
    },
    heartbeat() { for (const c of conns.values()) { try { c.res.write(': hb\n\n'); } catch (e) { /* ignore */ } } },
    async close() { closed = true; for (const c of conns.values()) { try { c.res.end(); } catch (e) { /* ignore */ } } conns.clear(); if (listener) { try { listener.release(true); } catch (e) { /* ignore */ } listener = null; } },
  };
  return bus;
}
module.exports = { createBus };


