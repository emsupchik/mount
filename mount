'use strict';
/* Фоновые задачи. Выполняются под advisory-lock: при нескольких экземплярах сервера каждая задача идёт ровно на одном. */
function createJobs({ cfg, db, log, audit, notify, bus, auth, admin }) {
  const J = { timer: null };

  /* Поход просрочен: активный поход, время возвращения + льготный период прошло → статус overdue, уведомляем участников и руководителя. */
  J.overdueTrips = async () => {
    const grace = +(await admin.setting('overdue_grace_min', 30));
    /* активный поход или подтверждённый план из мастера; статус мог уже стать overdue при чтении — уведомляем один раз (overdue_alerted_at) */
    const rows = await db.all(`UPDATE trips SET status='overdue', overdue_alerted_at=now() WHERE overdue_alerted_at IS NULL
      AND (status='active' OR status='overdue' OR (status='planned' AND confirmed_at IS NOT NULL)) AND expected_return + ($1||' minutes')::interval < now() RETURNING id, name, owner_id, group_id`, [String(grace)]);
    for (const t of rows) {
      const parts = (await db.all('SELECT user_id FROM trip_participants WHERE trip_id=$1', [t.id])).map(r => r.user_id);
      const leaders = t.group_id ? (await db.all('SELECT leader_id FROM groups WHERE id=$1', [t.group_id])).map(r => r.leader_id) : [];
      await notify.sendMany([...parts, ...leaders], { category: 'checkin', title: 'Поход просрочен: ' + t.name, body: 'Ожидаемое время возвращения прошло. Отметьтесь (check-in) или завершите поход. Если нужна помощь, нажмите SOS.', urgent: true, data: { tripId: t.id } });
      if (t.group_id) { await db.query("INSERT INTO group_events(group_id,type,data) VALUES($1,'trip_overdue',$2)", [t.group_id, JSON.stringify({ tripId: t.id })]); bus.publish('group:' + t.group_id, 'trip.overdue', { tripId: t.id }); }
      await audit.log({ actorId: null }, 'trip.overdue', 'trip', t.id);
      log.event('job', 'trip_overdue', { count: 1 });
    }
    // второй этап: долго просрочен — уведомляем диспетчеров (SOS автоматически НЕ создаётся)
    const staffAfter = +(await admin.setting('overdue_staff_alert_min', 120));
    const long = await db.all("UPDATE trips SET overdue_notified_at=now() WHERE status='overdue' AND overdue_notified_at IS NULL AND expected_return + ($1||' minutes')::interval < now() RETURNING id, name", [String(staffAfter)]);
    if (long.length) {
      const staff = (await db.all("SELECT id FROM users WHERE role IN ('DISPATCHER','ADMIN') AND status='active'")).map(r => r.id);
      for (const t of long) { bus.publish('staff', 'trip.overdue_long', { tripId: t.id, name: t.name }); await notify.sendMany(staff, { category: 'sos', title: 'Долго просроченный поход', body: t.name + ': участники не вышли на связь. SOS не создан; при необходимости свяжитесь с ними.', data: { tripId: t.id } }); }
    }
    return rows.length + long.length;
  };

  /* Таймеры check-in: напоминание в срок, предупреждение руководителю через 10 минут */
  J.checkinTimers = async () => {
    let n = 0;
    const remind = await db.all("UPDATE checkin_timers SET reminded_at=now() WHERE due_at<=now() AND reminded_at IS NULL RETURNING user_id, trip_id", []);
    for (const r of remind) { await notify.send(r.user_id, { category: 'checkin', title: 'Пора отметиться', body: 'Нажмите «Всё хорошо», чтобы группа знала, что вы на связи.', data: { tripId: r.trip_id } }); bus.publish('user:' + r.user_id, 'checkin.due', {}); n++; }
    const warn = await db.all("UPDATE checkin_timers SET warned_at=now() WHERE due_at + interval '10 minutes' <= now() AND warned_at IS NULL RETURNING user_id, group_id, trip_id", []);
    for (const w of warn) {
      const p = await db.one("SELECT COALESCE(NULLIF(full_name,''),tag) name FROM profiles WHERE user_id=$1", [w.user_id]);
      const groups = w.group_id ? [w.group_id] : (await db.all("SELECT group_id FROM group_members WHERE user_id=$1 AND status='active'", [w.user_id])).map(r => r.group_id);
      const leaders = groups.length ? (await db.all('SELECT DISTINCT leader_id FROM groups WHERE id = ANY($1::uuid[]) AND leader_id<>$2', [groups, w.user_id])).map(r => r.leader_id) : [];
      const t = w.trip_id ? await db.one('SELECT leader_id, owner_id FROM trips WHERE id=$1', [w.trip_id]) : null;
      const to = new Set(leaders); if (t && t.leader_id && t.leader_id !== w.user_id) to.add(t.leader_id);
      await notify.sendMany([...to], { category: 'checkin', title: 'Пропущен check-in: ' + p.name, body: 'Участник не отмечался дольше срока. Свяжитесь с ним. Если не отвечает, действуйте по плану группы или запустите SOS.', urgent: true, data: { userId: w.user_id } });
      for (const g of groups) { await db.query("INSERT INTO group_events(group_id,actor_id,type) VALUES($1,$2,'checkin_missed')", [g, w.user_id]); bus.publish('group:' + g, 'member.checkin_missed', { userId: w.user_id }); }
      log.event('job', 'checkin_missed', { userId: w.user_id }); n++;
    }
    return n;
  };

  J.cleanup = async () => {
    const purged = await auth.purgeDeleted();
    await db.query("DELETE FROM email_tokens WHERE expires_at < now() - interval '7 days'");
    await db.query("DELETE FROM sessions WHERE (expires_at < now() - interval '30 days') OR (revoked_at < now() - interval '30 days')");
    await db.query("DELETE FROM notifications WHERE created_at < now() - interval '180 days'");
    await db.query("DELETE FROM client_errors WHERE at < now() - interval '30 days'");
    await db.query("DELETE FROM client_perf WHERE at < now() - interval '30 days'");
    await db.query("DELETE FROM security_events WHERE at < now() - interval '90 days'");
    await db.query("DELETE FROM push_subscriptions WHERE failures >= 5");
    await db.query("UPDATE emergency_tokens SET revoked_at=now() WHERE revoked_at IS NULL AND expires_at < now() - interval '30 days'");
    return purged;
  };

  J.runOnce = async () => {
    const c = await db.pool.connect();
    try {
      const { rows } = await c.query('SELECT pg_try_advisory_lock(727002) ok'); if (!rows[0].ok) return { skipped: true };
      const out = {};
      for (const [k, f] of [['overdue', J.overdueTrips], ['checkins', J.checkinTimers]]) { try { out[k] = await f(); } catch (e) { log.error({ err: e, job: k }, 'job failed'); out[k] = 'error'; } }
      J.tick = (J.tick || 0) + 1; if (J.tick % 20 === 1) { try { out.cleanup = await J.cleanup(); } catch (e) { log.error({ err: e }, 'cleanup failed'); } try { if (J.purgeTripPeople) out.tripPeople = await J.purgeTripPeople(); } catch (e) { log.error({ err: e }, 'trip people purge failed'); } }
      await c.query('SELECT pg_advisory_unlock(727002)');
      return out;
    } finally { c.release(); }
  };
  J.start = () => { if (!cfg.jobsEnabled || J.timer) return; J.timer = setInterval(() => J.runOnce().catch(e => log.error({ err: e }, 'jobs failed')), cfg.jobsIntervalSec * 1000); J.timer.unref(); };
  J.stop = () => { clearInterval(J.timer); J.timer = null; };
  return J;
}
module.exports = { createJobs };


