/* Поддельные внешние провайдеры: запоминают запросы и отвечают как настоящие API */
function fakeNet() {
  const calls = []; const st = { smsFail: false, emailFail: false };
  const json = (status, body, headers = {}) => new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json', ...headers } });
  const f = async (url, o = {}) => {
    url = String(url); const body = o.body ? String(o.body) : ''; calls.push({ url, body, headers: o.headers || {} });
    if (url.startsWith('https://api.resend.com/emails')) return st.emailFail ? json(500, { message: 'boom' }) : json(200, { id: 'em_' + calls.length });
    if (url.includes('/service/message/sendsmsmessage')) return st.smsFail ? json(200, { code: 1, message: 'insufficient balance' }) : json(200, { code: 0, data: { messageId: 'sm_' + calls.length } });
    if (url.startsWith('https://overpass.test/')) return json(200, OSM);
    if (url.startsWith('https://valhalla.test/route')) return json(200, { trip: { legs: [{ shape: enc6([[43.0, 77.0], [43.05, 77.05], [43.1, 77.1]]) }], summary: { length: 14.2, time: 12000 } } });
    if (url.startsWith('https://elev.test/')) { const n = new URL(url).searchParams.get('latitude').split(',').length; return json(200, { elevation: new Array(n).fill(2222) }); }
    return json(404, {});
  };
  return { f, calls, st };
}
/* кодирование polyline6 (формат Valhalla) для поддельного ответа */
function enc6(pts) { let out = '', pl = 0, pn = 0; const e = v => { v = v < 0 ? ~(v << 1) : v << 1; let s = ''; while (v >= 0x20) { s += String.fromCharCode((0x20 | (v & 0x1f)) + 63); v >>= 5; } return s + String.fromCharCode(v + 63); }; for (const [la, lo] of pts) { const a = Math.round(la * 1e6), b = Math.round(lo * 1e6); out += e(a - pl) + e(b - pn); pl = a; pn = b; } return out; }
const OSM = { elements: [
