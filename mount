    <div class="scroll-x"><table class="tbl"><thead><tr><th>Имя</th><th>Тег</th><th>Роль</th><th>Телефон</th><th>Уровень</th></tr></thead><tbody>${us.map(u => `<tr><td>${esc(u.name)}</td><td class="mono">${esc(u.tag)}</td><td>${ROLE_NAME[u.role]}</td><td class="mono">${u.phone ? fmtPhone(u.phone) : '—'}</td><td>${u.prefs ? lvName(u.prefs.level) : '—'}</td></tr>`).join('')}</tbody></table></div>`;
  },
  v_chat() {
