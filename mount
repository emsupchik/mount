/* ── слежение за интернетом отдельно от GPS ── */
const NetWatch = {
  prev: null, pingOk: null, timer: null,
  start() {
    this.prev = Conn.state(); const chk = () => this.check(); window.addEventListener('online', chk); window.addEventListener('offline', chk);
