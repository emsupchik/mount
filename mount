      if (this.model) { const ll = this.model.coordinates.map(c => [c[0], c[1]]); L.polyline(ll, { color: this.straight ? '#f5c542' : '#6ee7b7', weight: 5, dashArray: this.straight ? '8 8' : null }).addTo(this.lay); if (fit !== false) m.fitBounds(L.latLngBounds(ll).pad(.15)); }
