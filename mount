    const members = (await db.all('SELECT user_id FROM rescue_team_members WHERE team_id=$1', [teamId])).map(m => m.user_id);
    notify.sendMany(members, { category: 'sos', title: 'Назначен инцидент ' + out.r.code, body: 'Приоритет ' + out.r.priority + '. Откройте карточку инцидента.', urgent: true, data: { incidentId: id } }).catch(() => {});
    if (out.r.user_id) notify.send(out.r.user_id, { category: 'sos', title: 'SOS ' + out.r.code + ': спасательная команда направлена', body: 'Команда «' + out.t.name + '» направлена к вам.' + (out.r.eta_min ? ' Ориентировочное время прибытия ~' + out.r.eta_min + ' мин (оценка, не гарантия).' : ''), urgent: true, data: { incidentId: id, status: 'DISPATCHED' } }).catch(() => {});
