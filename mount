  ACTIVE: ['ACKNOWLEDGED', 'CANCELLED'],
  ACKNOWLEDGED: ['DISPATCHED', 'RESOLVED', 'CANCELLED'],
  DISPATCHED: ['IN_PROGRESS', 'ACKNOWLEDGED', 'RESOLVED', 'CANCELLED'],
