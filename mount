/* OSM-теги → категории Mountain Points */
function kindOf(t) {
  if (t.landuse === 'winter_sports' || t.leisure === 'ski_resort' || t['site'] === 'piste') return 'ski_resort';
  if (t.tourism === 'camp_site') return 'campsite';
  if (t.tourism === 'camp_pitch') return 'camp';
  if (t.tourism === 'alpine_hut' || t.tourism === 'wilderness_hut' || t.amenity === 'shelter') return 'shelter';
  if (t.natural === 'peak' || t.natural === 'volcano') return 'peak';
  if (t.mountain_pass === 'yes' || t.natural === 'saddle') return 'pass';
  if (t.natural === 'water' && (t.water === 'lake' || t.water === 'reservoir' || !t.water) && t.name) return 'lake';
  if (t.amenity === 'drinking_water' || t.natural === 'spring' || t.man_made === 'water_tap') return 'water';
  if (t.emergency === 'mountain_rescue' || t.emergency === 'phone' || t.emergency === 'ambulance_station' || t.amenity === 'ranger_station') return 'emergency';
  if (t.tourism === 'picnic_site' || t.leisure === 'picnic_table') return 'rest';
  if ((t.man_made === 'mast' || t.man_made === 'tower') && /communication/.test(t['tower:type'] || t['communication:mobile_phone'] || '')) return 'connectivity';
