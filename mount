  /* Обновление точек из OpenStreetMap для области MOUNTAIN_BBOX (по умолчанию окрестности Алматы) */
  G.refreshFromOSM = async (ctx, bbox = cfg.geo.bbox) => {
    const b = bbox.join(',');
    const q = `[out:json][timeout:80];(
      nwr["tourism"~"^(camp_site|camp_pitch|alpine_hut|wilderness_hut|picnic_site)$"](${b});
      nwr["amenity"~"^(shelter|drinking_water|ranger_station)$"](${b});
      node["natural"="spring"](${b}); node["man_made"="water_tap"](${b});
      node["natural"~"^(peak|volcano|saddle)$"]["name"](${b}); node["mountain_pass"="yes"]["name"](${b});
      nwr["natural"="water"]["name"](${b});
      nwr["emergency"~"^(mountain_rescue|phone|ambulance_station)$"](${b});
      nwr["landuse"="winter_sports"](${b});
      node["man_made"~"^(mast|tower)$"]["tower:type"="communication"](${b});
    );out center meta tags;
    (way["aerialway"](${b}););out center tags;
