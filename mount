    const cid = 'rep-' + uid() + uid();
    try { await Remote.post('/safety-reports', { ...b, clientId: cid }); toast('Отчёт отправлен на проверку'); }
    catch (er) { if (er.net) { await Outbox.add({ opId: cid, type: 'safety_report', payload: b }); toast('Нет связи: отчёт сохранён и отправится позже', '⏳'); } else throw er; }
    preload('myReports'); f.reset(); Bus.emit('db');
  } catch (er) { perr(er); } finally { setBusy(btn, false); }
});

