    return { x0: tx(b.getWest()), x1: tx(b.getEast()), y0: Math.max(0, ty(b.getNorth())), y1: Math.min(n - 1, ty(b.getSouth())), n };
  },
  urls(b, z) { const r = this.range(b, z), u = []; for (let x = r.x0; x <= r.x1; x++) for (let y = r.y0; y <= r.y1; y++) u.push(this.tile(((x % r.n) + r.n) % r.n, y, z)); return u; },
  async status(b, z) {
