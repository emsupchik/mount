    else if (was === 'offline') { GeoSvc.st.restoredAt = Date.now(); Toast.show('Связь восстановлена', { icon: '🟢', title: 'CONNECTION RESTORED', duration: 5000 }); Sync.flush().then(() => Bus.emit('geo')); }
    Bus.emit('geo'); const v = Views[App.view]; if (v && v.head) v.head();
  },
};


/* ── карта (Leaflet + OpenStreetMap, бесплатно). Показывает ТОЛЬКО реально полученные точки ── */
