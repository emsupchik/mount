/* Mountain Safe: service worker. Оболочка приложения работает без интернета, тайлы карты берутся из локального кэша. */
const BUILD = '56f6d4450e';
const SHELL_CACHE = 'ms-shell-' + BUILD;
const TILE_CACHE = 'ms-tiles-v2';          // общий с приложением: туда кладёт плитки кнопка «Сохранить область офлайн»
const FONT_CACHE = 'ms-fonts-v1';
const TILE_HOST = 'tile.openstreetmap.org';
const SHELL = ['./', 'index.html', 'js/ms-engine.js', 'js/ms-geo.js', 'js/ms-app.js', 'js/ms-trip.js', 'js/ms-scenarios.js', 'js/ms-help.js', 'js/ms-friends.js', 'manifest.webmanifest', 'icons/icon-192.png', 'icons/icon-512.png', 'icons/maskable-512.png', 'icons/apple-touch-icon.png', 'img/bg-chimb.jpg', 'img/bg-mobile.jpg'];

self.addEventListener('install', e => {
  e.waitUntil(caches.open(SHELL_CACHE).then(c => Promise.all(SHELL.map(u => c.add(u).catch(() => null)))));
});
self.addEventListener('activate', e => {
  e.waitUntil((async () => {
    for (const k of await caches.keys()) if (k.startsWith('ms-shell-') && k !== SHELL_CACHE) await caches.delete(k);
    await self.clients.claim();
  })());
});
self.addEventListener('message', e => { if (e.data === 'SKIP_WAITING') self.skipWaiting(); });

async function trim(name, max) { const c = await caches.open(name), ks = await c.keys(); for (let i = 0; i < ks.length - max; i++) await c.delete(ks[i]); }

self.addEventListener('fetch', e => {
  const req = e.request, url = new URL(req.url);
  if (req.method !== 'GET' && req.method !== 'HEAD') return;
  /* реальная проверка связи: только сеть, без кэша */
  if (url.origin === location.origin && url.searchParams.has('ping')) { e.respondWith(fetch(req, { cache: 'no-store' })); return; }
  /* плитки карты: сначала локальный кэш */
  if (url.hostname.endsWith(TILE_HOST)) {
    e.respondWith((async () => {
      const c = await caches.open(TILE_CACHE), hit = await c.match(req.url);
      if (hit) return hit;
      try { const r = await fetch(req); if (r.ok) { c.put(req.url, r.clone()); trim(TILE_CACHE, 900); } return r; } catch (err) { return new Response('', { status: 504 }); }
    })());
    return;
  }
  /* шрифты Google: сохраняем после первого визита */
  if (url.hostname === 'fonts.googleapis.com' || url.hostname === 'fonts.gstatic.com') {
    e.respondWith((async () => {
      const c = await caches.open(FONT_CACHE), hit = await c.match(req);
      const net = fetch(req).then(r => { if (r.ok || r.type === 'opaque') c.put(req, r.clone()); return r; }).catch(() => null);
      return hit || (await net) || new Response('', { status: 504 });
    })());
    return;
  }
  /* API, серверные страницы (SEO, экстренная карточка, проверки) не перехватываем: они всегда идут в сеть */
  if (url.origin !== location.origin || /^\/(api\/|e\/|routes(\/|$)|u\/|readyz|healthz|robots\.txt|sitemap\.xml)/.test(url.pathname)) return;
  /* оболочка: сначала кэш, параллельно обновляем; без сети всегда отдаём сохранённую страницу (offline fallback) */
  e.respondWith((async () => {
    const c = await caches.open(SHELL_CACHE), key = req.mode === 'navigate' ? './' : req;
    const hit = await c.match(key, { ignoreSearch: true });
    const net = fetch(req).then(r => { if (r.ok) c.put(req.mode === 'navigate' ? './' : req, r.clone()); return r; }).catch(() => null);
    if (hit) { e.waitUntil(net); return hit; }
    const r = await net; if (r) return r;
    const fb = await c.match('./'); return fb || new Response('Офлайн', { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
  })());
});

/* ── Web Push: показываем уведомление от сервера ── */
self.addEventListener('push', e => {
  let d = {}; try { d = e.data ? e.data.json() : {}; } catch (err) { d = { title: 'Mountain Safe', body: e.data ? e.data.text() : '' }; }
  const cat = (d.data && d.data.category) || 'ms';
  e.waitUntil(self.registration.showNotification(d.title || 'Mountain Safe', { body: d.body || '', icon: 'icons/icon-192.png', badge: 'icons/icon-192.png', tag: cat + ((d.data && (d.data.incidentId || d.data.groupId)) || ''), requireInteraction: !!d.urgent, data: d.data || {} }));
});
self.addEventListener('notificationclick', e => {
  e.notification.close(); const d = e.notification.data || {};
  const target = d.incidentId ? './#/sos' : d.groupId ? './#/group' : './';
  e.waitUntil(self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then(cs => { for (const c of cs) if ('focus' in c) { c.focus(); return; } return self.clients.openWindow(target); }));
});


