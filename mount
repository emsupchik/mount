    const at = p.at ? new Date(p.at) : new Date();
    if (i.position_at && at <= new Date(i.position_at)) return { accepted: false, reason: 'stale' };
    await db.query('UPDATE sos_incidents SET lat=$2, lon=$3, accuracy=$4, position_at=$5, battery=COALESCE($6,battery), connection=COALESCE($7,connection), updated_at=now() WHERE id=$1', [id, p.lat, p.lon, p.accuracy ?? null, at, p.battery ?? null, p.connection || null]);
    const last = await db.one("SELECT max(at) a FROM incident_events WHERE incident_id=$1 AND type='position'", [id]);
    if (!last.a || Date.now() - new Date(last.a) > 60000) await event(db, id, ctx.user, 'position', { lat: p.lat, lon: p.lon, accuracy: p.accuracy ?? null });
    bus.publish(tp({ user_id: null, team_id: i.team_id }), 'sos.position', { id, code: i.code, lat: p.lat, lon: p.lon, accuracy: p.accuracy ?? null, at, battery: p.battery ?? null });
    return { accepted: true };
  };

  /* Журнал действий диспетчеров */
  S.dispatcherLog = async (ctx, { limit = 100, actorId }) => {
    if (!isStaff(ctx.user)) throw E.forbidden();
    return (await db.all("SELECT a.id, a.at, a.action, a.entity_id, a.actor_id, a.actor_role, a.meta, COALESCE(NULLIF(p.full_name,''),p.tag) actor FROM audit_log a LEFT JOIN profiles p ON p.user_id=a.actor_id WHERE (a.action LIKE 'sos.%' OR a.action LIKE 'rescue.%') AND ($2::uuid IS NULL OR a.actor_id=$2) ORDER BY a.at DESC LIMIT $1", [limit, actorId || null]))
      .map(a => ({ id: a.id, at: a.at, action: a.action, incidentId: a.entity_id, actor: a.actor, role: a.actor_role, meta: a.meta }));
  };
  S.staffStats = async () => {
    const r = await db.one(`SELECT count(*) FILTER (WHERE status IN ('ACTIVE'))::int active, count(*) FILTER (WHERE status='ACKNOWLEDGED')::int acknowledged, count(*) FILTER (WHERE status='DISPATCHED')::int dispatched,
