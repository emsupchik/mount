    else if (kind === 'chem') { await Remote.post('/auth/change-email', { newEmail: v('newEmail'), password: raw('password') }); toast('Письмо отправлено на новый адрес', '✉️'); f.reset(); }
    else if (kind === 'del') { const pw = raw('password'); if (!confirm_('Удалить аккаунт? Его можно будет восстановить в течение 30 дней.')) return setBusy(btn, false); await Remote.del('/account', { password: pw }); Remote.leave('Аккаунт удалён. Восстановить его можно в течение 30 дней'); }
    else if (kind === 'trip') {
      const g = Db.data.groups.find(x => x.id === v('groupId')), P = Prefs.get(), body = { name: v('name'), plannedStart: new Date(raw('plannedStart')).toISOString(), expectedReturn: new Date(raw('expectedReturn')).toISOString(), backupPlan: v('backup'), checkinIntervalMin: +v('interval') || 60,
        startPoint: v('start') ? { text: v('start') } : undefined, destination: v('dest') ? { text: v('dest') } : undefined, checklist: lines('checklist').map(item => ({ item, done: false })) };
      if (v('routeId')) body.routeId = v('routeId'); if (g) body.groupId = g.id;
