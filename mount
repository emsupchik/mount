body.sim-present .sim{position:fixed;inset:0;z-index:90;background:radial-gradient(90% 70% at 70% 0%,#12241d,#070d0b 70%);padding:18px 22px;display:grid;gap:14px;grid-template-columns:minmax(0,1.55fr) minmax(380px,.95fr);grid-template-rows:auto minmax(0,1fr) auto;grid-template-areas:"top top" "stage stage" "tl tl";overflow:hidden;animation:fade .35s}
