## Важное

Mountain Safe помогает принять решение и не заменяет профессиональную медицинскую или спасательную помощь. «SOS сохранён на сервере» означает только это: статус «диспетчер подтвердил» и «команда направлена» появляются исключительно после реальных действий диспетчера в системе. Чтобы система спасала людей, нужна организация, которая ведёт дежурство диспетчеров и имеет спасательные команды; само приложение спасателей не вызывает.


==================== deploy-to-server.bat ====================

@echo off
rem Mountain Safe: upload this project to the VPS and install/update it with one double-click.
rem Needs Windows 10/11 (built-in ssh, scp, tar). You will be asked for the server IP and the root password (twice).
setlocal
set SERVER=YOUR_SERVER_IP
set DOMAIN=mountaintracker.online
echo Server: %SERVER%   Domain: %DOMAIN%
echo.
echo [1/3] Packing project...
tar -czf "%TEMP%\mountainsafe.tgz" --exclude=node_modules --exclude=.env --exclude=.git -C "%~dp0." .
if errorlevel 1 (echo Packing failed & pause & exit /b 1)
echo [2/3] Uploading to %SERVER% (enter root password)...
scp -o StrictHostKeyChecking=accept-new "%TEMP%\mountainsafe.tgz" root@%SERVER%:/root/mountainsafe.tgz
if errorlevel 1 (echo Upload failed: check IP and password & pause & exit /b 1)
echo [3/3] Installing on server (enter root password again)...
ssh -t -o StrictHostKeyChecking=accept-new root@%SERVER% "rm -rf /root/ms-upload && mkdir -p /root/ms-upload && tar -xzf /root/mountainsafe.tgz -C /root/ms-upload && NEW_DOMAIN=%DOMAIN% bash /root/ms-upload/deploy/install.sh"
echo.
pause


==================== deploy/install.sh ====================

#!/usr/bin/env bash
# Mountain Safe — установка и обновление на VPS (Ubuntu/Debian) одной командой.
#   Первый запуск: ставит Node.js 22, PostgreSQL, nginx, pm2, HTTPS (Let's Encrypt), создаёт базу и .env (секреты генерирует сам).
#   Повторный запуск: обновляет код, сохраняет .env, делает резервную копию базы, применяет миграции и перезапускает сайт.
# Запуск (из распакованной папки проекта, под root):  bash deploy/install.sh
set -euo pipefail

APP=/opt/mountainsafe
SRC="$(cd "$(dirname "$0")/.." && pwd)"
NAME=mountainsafe
say() { printf '\n\033[1;32m==> %s\033[0m\n' "$*"; }
warn() { printf '\n\033[1;33m[!] %s\033[0m\n' "$*"; }
[ "$(id -u)" = 0 ] || { echo "Запустите под root: sudo bash deploy/install.sh"; exit 1; }
[ -f "$SRC/server.js" ] || { echo "Не найден server.js рядом со скриптом ($SRC)"; exit 1; }

say "1/7 Системные пакеты"
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq curl ca-certificates rsync postgresql nginx certbot python3-certbot-nginx >/dev/null
if ! command -v node >/dev/null || [ "$(node -p 'process.versions.node.split(".")[0]')" -lt 20 ]; then
  curl -fsSL https://deb.nodesource.com/setup_22.x | bash - >/dev/null && apt-get install -y -qq nodejs >/dev/null
fi
command -v pm2 >/dev/null || npm i -g pm2 >/dev/null
systemctl enable --now postgresql >/dev/null 2>&1 || true
echo "node $(node -v), pm2 $(pm2 -v)"

FIRST=0
if [ ! -f "$APP/.env" ]; then
  FIRST=1
  say "2/7 Первая установка: настройки (Enter — оставить значение в скобках)"
  read -rp "Домен сайта [mountain-tracker.ru]: " DOMAIN; DOMAIN=${DOMAIN:-mountain-tracker.ru}
  read -rp "Email администратора сайта: " ADMIN_EMAIL; ADMIN_EMAIL=${ADMIN_EMAIL}
  while :; do read -rsp "Пароль администратора сайта (10+ символов, буквы и цифры): " ADMIN_PASSWORD; echo
    [[ ${#ADMIN_PASSWORD} -ge 10 && "$ADMIN_PASSWORD" =~ [A-Za-z] && "$ADMIN_PASSWORD" =~ [0-9] ]] && break; echo "Слишком простой пароль, ещё раз."; done
  read -rp "Resend API key (re_..., можно пусто): " RESEND_KEY
  read -rp "Email диспетчера: " DISPATCH_EMAIL; DISPATCH_EMAIL=${DISPATCH_EMAIL}
  read -rp "Телефон диспетчера [+77778212160]: " DISPATCH_PHONE; DISPATCH_PHONE=${DISPATCH_PHONE:-+77778212160}
  read -rp "Домен уже подтверждён в Resend? (y/N): " RVER
  if [[ "$RVER" =~ ^[Yy] ]]; then MAIL_FROM="Mountain Safe <sos@$DOMAIN>"; else MAIL_FROM="Mountain Safe <onboarding@resend.dev>"; fi

  DBPASS=$(openssl rand -hex 16)
  say "Создаю базу данных"
  sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='mountainsafe'" | grep -q 1 \
    && sudo -u postgres psql -qc "ALTER USER mountainsafe WITH PASSWORD '$DBPASS';" \
    || sudo -u postgres psql -qc "CREATE USER mountainsafe WITH PASSWORD '$DBPASS';"
  sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='mountainsafe'" | grep -q 1 \
    || sudo -u postgres psql -qc "CREATE DATABASE mountainsafe OWNER mountainsafe ENCODING 'UTF8' LC_COLLATE 'C.UTF-8' LC_CTYPE 'C.UTF-8' TEMPLATE template0;"

  mkdir -p "$APP"
  cat > "$APP/.env" <<EOF
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://$DOMAIN
DATABASE_URL=postgres://mountainsafe:$DBPASS@localhost:5432/mountainsafe
JWT_SECRET=$(openssl rand -hex 32)
MEDICAL_ENC_KEY=$(openssl rand -base64 32)
ADMIN_EMAIL=$ADMIN_EMAIL
ADMIN_PASSWORD="$ADMIN_PASSWORD"
TRUST_PROXY=true
COOKIE_SECURE=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=$RESEND_KEY
MAIL_FROM="$MAIL_FROM"
DISPATCH_EMAIL=$DISPATCH_EMAIL
DISPATCH_PHONE=$DISPATCH_PHONE
SMS_PROVIDER=none
JOBS_ENABLED=true
LOG_LEVEL=info
EOF
  chmod 600 "$APP/.env"
