  A.hideContent = async (ctx, type, id) => { if (!HIDE[type]) throw E.validation({ type: 'неверный тип' }); const r = await db.query(HIDE[type], [id]); if (!r.rowCount) throw E.notFound('Объект не найден'); await audit.log(ctx, 'admin.content_hidden', type, id); };
