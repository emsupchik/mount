          <div class="field" style="margin:0"><label for="mxDestQ">Поиск: вершина, озеро, укрытие…</label><input id="mxDestQ" type="search" value="${esc(this.q)}" placeholder="Например: Талгар, озеро, пик" autocomplete="off"></div>
