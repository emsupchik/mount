/* HTTP-клиент с cookie-jar (refresh-токен приходит в httpOnly cookie) */
function client(env) {
  const jar = {};
  const c = {
    token: null, jar,
    async raw(method, path, { body, token, headers = {}, cookie = true, csrf = false } = {}) {
      const h = Object.assign({}, headers);
      if (body !== undefined) h['Content-Type'] = 'application/json';
      const t = token === undefined ? c.token : token; if (t) h.Authorization = 'Bearer ' + t;
      if (cookie && Object.keys(jar).length) h.Cookie = Object.entries(jar).map(([k, v]) => k + '=' + v).join('; ');
      if (csrf) h['X-Requested-With'] = 'mountain-safe';
      const r = await fetch(env.base + path, { method, headers: h, body: body !== undefined ? JSON.stringify(body) : undefined, redirect: 'manual' });
      const sc = r.headers.getSetCookie ? r.headers.getSetCookie() : [];
      for (const s of sc) { const [kv] = s.split(';'); const i = kv.indexOf('='); const k = kv.slice(0, i), v = kv.slice(i + 1); if (/Max-Age=0/i.test(s) || v === '') delete jar[k]; else jar[k] = v; }
      const text = await r.text(); let json = null; try { json = JSON.parse(text); } catch (e) { /* html/text */ }
      return { status: r.status, body: json, text, headers: r.headers };
    },
    get: (p, o) => c.raw('GET', p, o), post: (p, body, o) => c.raw('POST', p, Object.assign({ body: body || {} }, o)), patch: (p, body, o) => c.raw('PATCH', p, Object.assign({ body }, o)),
    put: (p, body, o) => c.raw('PUT', p, Object.assign({ body }, o)), del: (p, body, o) => c.raw('DELETE', p, Object.assign({ body }, o)),
  };
  return c;
}
