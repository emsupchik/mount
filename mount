'use strict';
/* Структурированные JSON-логи. Чувствительные поля вырезаются на выходе. */
const LEVELS = { debug: 10, info: 20, warn: 30, error: 40 };
const SENSITIVE = /pass|token|secret|authorization|cookie|medical|allerg|blood|condition|medication|photo|body|message|phone|email|lat|lon|coords|key|code/i;
const ALLOW = new Set(['status', 'path', 'method', 'ms', 'reqId', 'userId', 'role', 'event', 'category', 'incidentId', 'incident', 'code', 'count', 'sid', 'ip', 'msg', 'level', 'ts', 'err', 'stack', 'jobs', 'name', 'type']);

function redact(v, depth = 0) {
  if (v == null || depth > 4) return v;
  if (Array.isArray(v)) return v.slice(0, 20).map(x => redact(x, depth + 1));
  if (typeof v === 'object') {
    const o = {};
    for (const [k, x] of Object.entries(v)) o[k] = (SENSITIVE.test(k) && !ALLOW.has(k)) ? '[redacted]' : redact(x, depth + 1);
    return o;
  }
  if (typeof v === 'string' && v.length > 300) return v.slice(0, 300) + '…';
  return v;
}

function make(cfg, sink) {
  const min = LEVELS[cfg.logLevel] || 20;
  const out = sink || (l => process.stdout.write(l + '\n'));
  const emit = (level, base) => (fields, msg) => {
    if (cfg.logSilent || LEVELS[level] < min) return;
    if (typeof fields === 'string') { msg = fields; fields = {}; }
    const rec = Object.assign({ ts: new Date().toISOString(), level }, base, redact(fields || {}), msg ? { msg } : {});
    if (fields && fields.err instanceof Error) { rec.err = fields.err.message; if (level === 'error') rec.stack = String(fields.err.stack || '').split('\n').slice(0, 4).join(' | '); }
    out(JSON.stringify(rec));
  };
  const build = base => ({
    debug: emit('debug', base), info: emit('info', base), warn: emit('warn', base), error: emit('error', base),
    child: extra => build(Object.assign({}, base, extra)),
    /* Категории событий: auth, sos, rescue, sync, http, security, job */
    event: (category, event, fields) => emit('info', base)(Object.assign({ category, event }, fields)),
  });
  return build({});
}
module.exports = { make, redact };


