test('очередь диспетчера: фильтры, поиск, сортировка, пагинация', async () => {
  const d = await staff(env, 'DISPATCHER'); const us = []; for (let k = 0; k < 4; k++) us.push(await signup(env, { fullName: 'Иванов' + k }));
  const sit = ['bruise', 'unconscious', 'storm', 'fracture'];
  const ids = []; for (let k = 0; k < 4; k++) ids.push((await us[k].post('/api/v1/sos', SOS({ situation: sit[k] }))).body.incident.id);
  let q = (await d.get('/api/v1/rescue/incidents?limit=100')).body; assert.ok(q.total >= 4);
  const mine = q.items.filter(x => ids.includes(x.id)); assert.deepEqual(mine.map(x => x.priority), ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW']);      // по умолчанию приоритетные сверху
  q = (await d.get('/api/v1/rescue/incidents?priority=CRITICAL,HIGH&limit=100')).body; assert.ok(q.items.every(x => ['CRITICAL', 'HIGH'].includes(x.priority)));
  q = (await d.get('/api/v1/rescue/incidents?q=Иванов2')).body; assert.equal(q.items.length, 1); assert.equal(q.items[0].reporter, 'Иванов2');
  q = (await d.get('/api/v1/rescue/incidents?q=' + encodeURIComponent('%'))).body; assert.equal(q.items.length, 0);                                    // % не превращается в wildcard
  q = (await d.get('/api/v1/rescue/incidents?sort=received&dir=asc&limit=2&offset=0')).body; assert.equal(q.items.length, 2); assert.ok(new Date(q.items[0].receivedAt) <= new Date(q.items[1].receivedAt));
  assert.equal((await d.get("/api/v1/rescue/incidents?sort=id;drop table users")).status, 422);
  assert.equal((await d.get("/api/v1/rescue/incidents?status=ACTIVE'--")).status, 200);                                                                // инъекция в параметры безвредна
});

test('полный цикл: ACTIVE → ACKNOWLEDGED → DISPATCHED (команда) → IN_PROGRESS → RESOLVED, владелец видит честные стадии', async () => {
  const adm = await admin(), d = await staff(env, 'DISPATCHER'), rs = await staff(env, 'RESCUER'); const u = await signup(env);
  const t = await team(adm, 'Альфа-' + n); await adm.post(`/api/v1/rescue/teams/${t.id}/members`, { userId: rs.user.id });
  const su = await sse(env, u);
  const i = (await u.post('/api/v1/sos', SOS())).body.incident;
  const ack = await d.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'ACKNOWLEDGED' }); assert.equal(ack.status, 200); assert.equal(ack.body.incident.status, 'ACKNOWLEDGED'); assert.equal(ack.body.incident.stages.acknowledgedByDispatcher, true);
  await su.wait('sos.status', x => x.status === 'ACKNOWLEDGED');
  let own = (await u.get('/api/v1/sos/' + i.id)).body.incident; assert.equal(own.stages.acknowledgedByDispatcher, true); assert.equal(own.stages.rescueTeamDispatched, false);         // «принят» ≠ «выехали»
  assert.equal((await d.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'DISPATCHED' })).status, 409);                                                                    // нельзя без команды
  await adm.patch(`/api/v1/rescue/teams/${t.id}`, {}); await env.db.query('UPDATE rescue_teams SET lat=43.1, lon=77.0 WHERE id=$1', [t.id]);
  const as = await d.post(`/api/v1/rescue/incidents/${i.id}/team`, { teamId: t.id }); assert.equal(as.status, 200); assert.equal(as.body.incident.status, 'DISPATCHED'); assert.ok(as.body.incident.etaMin > 0);
  await su.wait('sos.status', x => x.status === 'DISPATCHED');
  own = (await u.get('/api/v1/sos/' + i.id)).body.incident; assert.equal(own.stages.rescueTeamDispatched, true); assert.equal(own.stages.operationInProgress, false); assert.equal(own.team.name, t.name); assert.ok(own.etaMin > 0);
  assert.ok((await u.get('/api/v1/notifications')).body.notifications.some(x => /спасательная команда направлена/i.test(x.title)));
  assert.ok((await rs.get('/api/v1/notifications')).body.notifications.some(x => /Назначен инцидент/.test(x.title)));
  assert.equal((await d.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'ACKNOWLEDGED' })).status, 200);       // диспетчер вернул в ACKNOWLEDGED (команда осталась)
  await d.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'DISPATCHED' });
  const ip = await rs.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'IN_PROGRESS' }); assert.equal(ip.status, 200);
  assert.equal((await rs.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'RESOLVED' })).status, 422);                                   // итог обязателен
  const done = await rs.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'RESOLVED', note: 'Пострадавший эвакуирован' }); assert.equal(done.status, 200);
  own = (await u.get('/api/v1/sos/' + i.id)).body.incident; assert.equal(own.stages.operationFinished, true); assert.equal(own.status, 'RESOLVED');
  assert.equal((await env.db.one('SELECT availability FROM rescue_teams WHERE id=$1', [t.id])).availability, 'available');                        // команда освобождена
  assert.equal((await d.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'ACTIVE' })).status, 422);
  assert.equal((await d.post(`/api/v1/rescue/incidents/${i.id}/status`, { status: 'IN_PROGRESS' })).status, 409);                                 // из RESOLVED переходов нет
  const ev = (await d.get('/api/v1/rescue/incidents/' + i.id)).body.incident.events.map(e => e.type); for (const x of ['created', 'status', 'team_assigned']) assert.ok(ev.includes(x));
  su.close();
});

test('конечный автомат: недопустимые переходы отклоняются', async () => {
