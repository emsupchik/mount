'use strict';
const C = require('../lib/crypto');
const { E } = require('../lib/errors');

const MAX_FAILS = 8, LOCK_MIN = 15;

function slugTag(s) { return String(s || 'user').toLowerCase().replace(/[^a-z0-9а-яё]+/gi, '_').replace(/^_+|_+$/g, '').slice(0, 20) || 'user'; }

function createAuth({ cfg, db, log, audit, mailer, bus }) {
  const A = {};

  A.publicUser = (u, p) => ({
    id: u.id, email: u.email, emailVerified: !!u.email_verified_at, phone: u.phone || null, phoneVerified: !!u.phone_verified_at,
    role: u.role, status: u.status, createdAt: u.created_at,
    tag: p && p.tag, fullName: p && p.full_name,
  });

  A.newTag = async (q, base) => {
    for (let i = 0; i < 8; i++) {
      const tag = '@' + slugTag(base) + '_' + (1000 + Math.floor(Math.random() * 9000));
      if (!(await q.one('SELECT 1 FROM profiles WHERE lower(tag)=lower($1)', [tag]))) return tag;
    }
    return '@u_' + C.randomToken(6);
  };

  async function issueEmailToken(q, userId, kind, ttlMs, newEmail) {
    await q.query("UPDATE email_tokens SET used_at=now() WHERE user_id=$1 AND kind=$2 AND used_at IS NULL", [userId, kind]);   // старые ссылки того же типа недействительны
    const t = C.randomToken(32);
    await q.query('INSERT INTO email_tokens(user_id,kind,token_hash,new_email,expires_at) VALUES($1,$2,$3,$4,now()+$5::interval)', [userId, kind, C.sha256(t), newEmail || null, Math.round(ttlMs / 1000) + ' seconds']);
    return t;
  }
  async function consumeEmailToken(q, token, kind) {
    const row = await q.one("UPDATE email_tokens SET used_at=now() WHERE token_hash=$1 AND kind=$2 AND used_at IS NULL AND expires_at>now() RETURNING *", [C.sha256(token || ''), kind]);
    if (!row) throw E.badRequest('Ссылка недействительна или устарела');
    return row;
  }

  /* Создание пользователя. role != TOURIST разрешено только вызовам из admin-сервиса. */
  A.createUser = async (q, { email, password, fullName, phone, role = 'TOURIST', emailVerified = false }) => {
    const hash = await C.hashPassword(password);
    let u;
    try {
      u = await q.one('INSERT INTO users(email,password_hash,phone,role,email_verified_at) VALUES($1,$2,$3,$4,$5) RETURNING *', [email, hash, phone || null, role, emailVerified ? new Date() : null]);
    } catch (e) { if (e.code === '23505') throw E.conflict('Этот email уже зарегистрирован', 'email_taken'); throw e; }
    const tag = await A.newTag(q, fullName || email.split('@')[0]);
    const p = await q.one('INSERT INTO profiles(user_id,tag,full_name) VALUES($1,$2,$3) RETURNING *', [u.id, tag, fullName || '']);
    return { u, p };
  };

  A.sendVerification = async (user) => {
    const t = await issueEmailToken(db, user.id, 'verify_email', 24 * 3600e3);
    await mailer.send(user.email, 'Подтверждение email — Mountain Safe', mailer.verifyEmail(user.email, t));
  };
  A.registerFull = async (ctx, input) => {
    const created = await db.tx(async q => A.createUser(q, input));
    await A.sendVerification(created.u).catch(e => log.error({ err: e }, 'verification mail failed'));
    await audit.log({ ip: ctx.ip, actorId: created.u.id }, 'auth.register', 'user', created.u.id);
    log.event('auth', 'register', { userId: created.u.id });
    return created;
  };

  A.verifyEmail = async (token) => {
    const row = await db.tx(async q => {
      const r = await consumeEmailToken(q, token, 'verify_email');
      await q.query('UPDATE users SET email_verified_at=now() WHERE id=$1 AND email_verified_at IS NULL', [r.user_id]);
      return r;
    });
    await audit.log({ actorId: row.user_id }, 'auth.email_verified', 'user', row.user_id);
    return true;
  };

  /* ── сессии ── */
  A.startSession = async (user, ctx) => {
    const refresh = C.randomToken(48);
    const s = await db.one("INSERT INTO sessions(user_id,refresh_hash,user_agent,ip,expires_at) VALUES($1,$2,$3,$4,now()+$5::interval) RETURNING id, expires_at",
      [user.id, C.sha256(refresh), String(ctx.ua || '').slice(0, 200), ctx.ip, cfg.refreshTtlSec + ' seconds']);
    return { refresh, sessionId: s.id, access: A.signAccess(user.id, s.id), refreshExpires: s.expires_at };
  };
  A.signAccess = (userId, sid) => C.signJwt({ sub: userId, sid }, cfg.jwtSecret, cfg.accessTtlSec);

  A.login = async (ctx, { email, password }) => {
    const u = await db.one('SELECT * FROM users WHERE lower(email)=lower($1)', [email]);
    if (!u) { await C.fakeVerify(password); await audit.security('login_failed', { ip: ctx.ip, meta: { reason: 'no_user' } }); throw E.unauthorized('Неверный email или пароль'); }
    if (u.locked_until && u.locked_until > new Date()) { await audit.security('login_locked', { userId: u.id, ip: ctx.ip }); throw Object.assign(E.tooMany(Math.ceil((u.locked_until - Date.now()) / 1000)), { message: 'Аккаунт временно заблокирован из-за неудачных попыток входа. Попробуйте позже' }); }
    const ok = await C.verifyPassword(password, u.password_hash);
    if (!ok) {
      const r = await db.one('UPDATE users SET failed_logins=failed_logins+1, locked_until=CASE WHEN failed_logins+1>=$2 THEN now()+$3::interval ELSE locked_until END WHERE id=$1 RETURNING failed_logins', [u.id, MAX_FAILS, LOCK_MIN + ' minutes']);
      await audit.security(r.failed_logins >= MAX_FAILS ? 'account_locked' : 'login_failed', { userId: u.id, ip: ctx.ip });
      throw E.unauthorized('Неверный email или пароль');
    }
    if (u.status === 'deleted') throw Object.assign(E.forbidden('Аккаунт удалён. Его можно восстановить в течение ' + cfg.accountGraceDays + ' дней'), { code: 'account_deleted' });
    if (u.status === 'blocked') { await audit.security('blocked_login', { userId: u.id, ip: ctx.ip }); throw Object.assign(E.forbidden('Аккаунт заблокирован администратором'), { code: 'account_blocked' }); }
    await db.query('UPDATE users SET failed_logins=0, locked_until=NULL, last_login_at=now() WHERE id=$1', [u.id]);
    const s = await A.startSession(u, ctx);
    const p = await db.one('SELECT * FROM profiles WHERE user_id=$1', [u.id]);
    await audit.log({ actorId: u.id, ip: ctx.ip }, 'auth.login', 'session', s.sessionId);
    log.event('auth', 'login', { userId: u.id, sid: s.sessionId });
    return Object.assign(s, { user: A.publicUser(u, p) });
  };

  A.refresh = async (ctx, token) => {
    if (!token) throw E.unauthorized('Нет сессии');
    const h = C.sha256(token);
    const s = await db.one('SELECT s.*, u.status FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.refresh_hash=$1', [h]);
    if (!s) {
      const old = await db.one('SELECT id, user_id, family_id, last_used_at FROM sessions WHERE prev_hash=$1', [h]);
      if (old) {
        if (Date.now() - new Date(old.last_used_at) < 10000) throw Object.assign(E.conflict('Сессия только что обновлена, повторите запрос', 'refresh_conflict'));
        await db.query("UPDATE sessions SET revoked_at=now(), revoked_reason='refresh_reuse' WHERE family_id=$1 AND revoked_at IS NULL", [old.family_id]);
        await audit.security('refresh_reuse', { userId: old.user_id, ip: ctx.ip });
      }
      throw E.unauthorized('Сессия недействительна');
    }
    if (s.revoked_at || s.expires_at < new Date() || s.status !== 'active') throw E.unauthorized('Сессия недействительна');
    const next = C.randomToken(48);
    const r = await db.one('UPDATE sessions SET prev_hash=refresh_hash, refresh_hash=$2, last_used_at=now(), ip=$3 WHERE id=$1 AND refresh_hash=$4 RETURNING id',
      [s.id, C.sha256(next), ctx.ip, h]);
    if (!r) throw E.conflict('Сессия только что обновлена, повторите запрос', 'refresh_conflict');
    const u = await db.one('SELECT * FROM users WHERE id=$1', [s.user_id]);
    const p = await db.one('SELECT * FROM profiles WHERE user_id=$1', [s.user_id]);
    return { access: A.signAccess(s.user_id, s.id), refresh: next, sessionId: s.id, refreshExpires: s.expires_at, user: A.publicUser(u, p) };
  };

  A.logout = async (sid) => { await db.query("UPDATE sessions SET revoked_at=now(), revoked_reason='logout' WHERE id=$1 AND revoked_at IS NULL", [sid]); };
  A.logoutAll = async (userId, exceptSid = null, reason = 'logout_all') => {
    const r = await db.query("UPDATE sessions SET revoked_at=now(), revoked_reason=$3 WHERE user_id=$1 AND revoked_at IS NULL AND ($2::uuid IS NULL OR id<>$2)", [userId, exceptSid, reason]);
    return r.rowCount;
  };
  A.listSessions = async (userId, currentSid) => (await db.all('SELECT id, user_agent, ip, created_at, last_used_at, expires_at FROM sessions WHERE user_id=$1 AND revoked_at IS NULL AND expires_at>now() ORDER BY last_used_at DESC', [userId]))
    .map(s => ({ id: s.id, userAgent: s.user_agent, ip: s.ip, createdAt: s.created_at, lastUsedAt: s.last_used_at, expiresAt: s.expires_at, current: s.id === currentSid }));
  A.revokeSession = async (userId, sid) => { const r = await db.query("UPDATE sessions SET revoked_at=now(), revoked_reason='revoked_by_user' WHERE id=$1 AND user_id=$2 AND revoked_at IS NULL", [sid, userId]); if (!r.rowCount) throw E.notFound('Сессия не найдена'); };

  /* Проверка access-токена: роль и статус ВСЕГДА читаются из БД, а не из токена */
  A.byClaims = async (p) => {
    if (!p || !p.sid || !p.sub) return null;
    return db.one("SELECT u.*, s.id AS sid FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.id=$1 AND s.user_id=$2 AND s.revoked_at IS NULL AND s.expires_at>now() AND u.status='active'", [p.sid, p.sub]);
  };
  A.authenticate = async (token) => { const p = C.verifyJwt(token, cfg.jwtSecret); if (!p || p.typ) return null; return A.byClaims(p); };   // typ задан только у одноразовых SSE-билетов, их как access не принимаем

  /* ── пароль ── */
  A.forgotPassword = async (ctx, email) => {
    const u = await db.one("SELECT * FROM users WHERE lower(email)=lower($1) AND status='active'", [email]);
    if (u) {
      const t = await issueEmailToken(db, u.id, 'reset_password', 3600e3);
      await mailer.send(u.email, 'Сброс пароля — Mountain Safe', mailer.resetPassword(u.email, t)).catch(e => log.error({ err: e }, 'reset mail failed'));
      await audit.log({ actorId: u.id, ip: ctx.ip }, 'auth.password_reset_requested', 'user', u.id);
    }
    return true;   // ответ одинаков всегда, чтобы нельзя было перебирать email
  };
  A.resetPassword = async (ctx, { token, password }) => {
    const hash = await C.hashPassword(password);
    const row = await db.tx(async q => {
      const r = await consumeEmailToken(q, token, 'reset_password');
      await q.query('UPDATE users SET password_hash=$2, failed_logins=0, locked_until=NULL WHERE id=$1', [r.user_id, hash]);
      return r;
    });
    const n = await A.logoutAll(row.user_id, null, 'password_reset');
    await audit.log({ actorId: row.user_id, ip: ctx.ip }, 'auth.password_reset', 'user', row.user_id, { revoked: n });
    return true;
  };
  A.changePassword = async (ctx, { current, password }) => {
    const u = ctx.user;
    if (!(await C.verifyPassword(current, u.password_hash))) { await audit.security('change_password_failed', { userId: u.id, ip: ctx.ip }); throw E.unauthorized('Текущий пароль неверный'); }
    if (await C.verifyPassword(password, u.password_hash)) throw E.validation({ password: 'новый пароль совпадает с текущим' });
    await db.query('UPDATE users SET password_hash=$2 WHERE id=$1', [u.id, await C.hashPassword(password)]);
    const n = await A.logoutAll(u.id, u.sid, 'password_changed');
    await audit.log(ctx, 'auth.password_changed', 'user', u.id, { revoked: n });
    mailer.send(u.email, 'Пароль изменён — Mountain Safe', 'Пароль вашего аккаунта был изменён. Если это были не вы, сбросите пароль и завершите все сеансы.').catch(() => {});
    return { revokedSessions: n };
  };

  /* ── email ── */
  A.requestEmailChange = async (ctx, { newEmail, password }) => {
    const u = ctx.user;
    if (!(await C.verifyPassword(password, u.password_hash))) throw E.unauthorized('Пароль неверный');
    if (newEmail === u.email.toLowerCase()) throw E.validation({ newEmail: 'это ваш текущий email' });
    if (await db.one('SELECT 1 FROM users WHERE lower(email)=$1', [newEmail])) throw E.conflict('Этот email уже используется', 'email_taken');
    const t = await issueEmailToken(db, u.id, 'change_email', 24 * 3600e3, newEmail);
    await mailer.send(newEmail, 'Подтверждение нового email — Mountain Safe', mailer.changeEmail(newEmail, t));
    await audit.log(ctx, 'auth.email_change_requested', 'user', u.id);
    return true;
  };
  A.confirmEmailChange = async (ctx, token) => {
    const row = await db.tx(async q => {
      const r = await consumeEmailToken(q, token, 'change_email');
      try { await q.query('UPDATE users SET email=$2, email_verified_at=now() WHERE id=$1', [r.user_id, r.new_email]); }
      catch (e) { if (e.code === '23505') throw E.conflict('Этот email уже используется', 'email_taken'); throw e; }
      return r;
    });
    await audit.log({ actorId: row.user_id, ip: ctx.ip }, 'auth.email_changed', 'user', row.user_id);
    return true;
  };

  /* ── удаление / восстановление ── */
  A.deleteAccount = async (ctx, { password }) => {
    const u = ctx.user;
    if (!(await C.verifyPassword(password, u.password_hash))) throw E.unauthorized('Пароль неверный');
    if (await db.one("SELECT 1 FROM sos_incidents WHERE user_id=$1 AND status IN ('ACTIVE','ACKNOWLEDGED','DISPATCHED','IN_PROGRESS')", [u.id])) throw E.conflict('Есть активный SOS. Отмените его или дождитесь завершения', 'active_sos');
    await db.tx(async q => {
      await q.query("UPDATE users SET status='deleted', deleted_at=now() WHERE id=$1", [u.id]);
      await q.query("UPDATE sessions SET revoked_at=now(), revoked_reason='account_deleted' WHERE user_id=$1 AND revoked_at IS NULL", [u.id]);
      await q.query("UPDATE group_members SET status='left', left_at=now() WHERE user_id=$1 AND status='active'", [u.id]);
      await q.query("UPDATE emergency_tokens SET revoked_at=now() WHERE user_id=$1 AND revoked_at IS NULL", [u.id]);
      await q.query("DELETE FROM push_subscriptions WHERE user_id=$1", [u.id]);
      await q.query("DELETE FROM device_states WHERE user_id=$1", [u.id]);
    });
    await audit.log(ctx, 'account.deleted', 'user', u.id, { graceDays: cfg.accountGraceDays });
    return { restorableUntil: new Date(Date.now() + cfg.accountGraceDays * 86400e3).toISOString() };
  };
  A.restoreAccount = async (ctx, { email, password }) => {
    const u = await db.one("SELECT * FROM users WHERE lower(email)=lower($1) AND status='deleted'", [email]);
    if (!u || !(await C.verifyPassword(password, u.password_hash))) { if (!u) await C.fakeVerify(password); throw E.unauthorized('Неверный email или пароль'); }
    if (new Date(u.deleted_at).getTime() + cfg.accountGraceDays * 86400e3 < Date.now()) throw E.conflict('Срок восстановления истёк', 'grace_expired');
    await db.query("UPDATE users SET status='active', deleted_at=NULL WHERE id=$1", [u.id]);
    await audit.log({ actorId: u.id, ip: ctx.ip }, 'account.restored', 'user', u.id);
    return true;
  };
  /* Окончательное удаление после льготного срока. Инциденты SOS обезличиваются, но остаются как операционная запись. */
  A.purgeDeleted = async () => {
    const rows = await db.all("SELECT id FROM users WHERE status='deleted' AND deleted_at < now() - $1::interval", [cfg.accountGraceDays + ' days']);
    for (const r of rows) {
      await db.tx(async q => {
        await q.query("UPDATE sos_incidents SET reporter_name='Удалённый пользователь', reporter_phone=NULL, medical_enc=NULL, contacts='[]' WHERE user_id=$1", [r.id]);
        await q.query("DELETE FROM users WHERE id=$1", [r.id]);
      });
      await audit.log({ actorId: null }, 'account.purged', 'user', r.id);
    }
    return rows.length;
  };
  return A;
}
module.exports = { createAuth };


