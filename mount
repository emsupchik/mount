  /* ═════════════ Season ═════════════ */
  const SEASONS = {
    winter: { ru: 'Зима', en: 'Winter', speed: 0.75, highSpeed: 0.62, daylight: 'short', notes: ['Снег и лёд: скорость ниже, нужны кошки/ледоступы', 'Короткий световой день', 'Возможны закрытия троп и лавинная опасность — проверьте бюллетень'] },
    spring: { ru: 'Весна', en: 'Spring', speed: 0.9, highSpeed: 0.72, daylight: 'medium', notes: ['Снег выше ~2500 м, раскисшие тропы', 'Весенние лавины и сели, высокий уровень воды в реках', 'Резкие перепады погоды'] },
    summer: { ru: 'Лето', en: 'Summer', speed: 1.0, highSpeed: 0.95, daylight: 'long', notes: ['Жара в нижней части маршрута: вода и защита от солнца', 'Послеобеденные грозы: выходите рано', 'Длинный световой день'] },
    autumn: { ru: 'Осень', en: 'Autumn', speed: 0.95, highSpeed: 0.8, daylight: 'medium', notes: ['Ранние сумерки', 'Первый снег и обледенение на высоте', 'Холодные ночи'] },
  };
