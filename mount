'use strict';
/* v3: навигация (маршруты с геометрией, GPX), Mountain Points, Predictive Safety Engine, уведомления диспетчеру, статус интеграций. */
const { v } = require('../lib/validate');
const { E } = require('../lib/errors');
const Engine = require('../../public/js/ms-engine.js');

module.exports = (r, S) => {
  const { geodata, dispatch } = S;
  const staff = ['DISPATCHER', 'ADMIN'];
  const pt = v.obj({ lat: v.lat(), lon: v.lon() });
  const KINDS = ['campsite', 'camp', 'rest', 'water', 'emergency', 'shelter', 'connectivity', 'ski_resort', 'landmark', 'peak', 'lake', 'pass'];

  /* Что реально подключено на сервере — интерфейс показывает NOT CONFIGURED вместо имитации */
  r.get('/api/v1/system/capabilities', { auth: 'none' }, async () => ({
    otp: S.otp.status(), dispatch: dispatch.config(), routing: geodata.status(), push: { configured: S.notify.pushConfigured() },
    ai: { configured: !!S.cfg.ai.key }, predictor: { id: Engine.Predictor.model.id, ml: !!Engine.Predictor.model.ml },
  }));

  /* ── Mountain Points ── */
  r.get('/api/v1/mountain-points', { auth: 'none', query: v.obj({ kinds: v.str({ max: 200 }).optional(), bbox: v.str({ max: 80 }).optional(), pending: v.bool().optional() }) }, async ctx => {
    const kinds = ctx.query.kinds ? String(ctx.query.kinds).split(',').filter(k => KINDS.includes(k)) : null;
    let bbox = null; if (ctx.query.bbox) { bbox = String(ctx.query.bbox).split(',').map(Number); if (bbox.length !== 4 || bbox.some(x => !isFinite(x))) throw E.badRequest('bbox: south,west,north,east'); }
    ctx.headers['Cache-Control'] = 'public, max-age=300';
    return geodata.list({ kinds, bbox, includePending: !!ctx.query.pending });
  });
  r.post('/api/v1/mountain-points/refresh', { roles: staff, rate: [{ name: 'osmrefresh', max: 6, windowMs: 3600e3, by: 'user' }] }, async ctx => geodata.refreshFromOSM(ctx));

  /* ── маршруты для навигатора ── */
  r.get('/api/v1/nav/routes', { auth: 'optional' }, async ctx => ({ routes: await geodata.listForNav(ctx.user) }));
  r.get('/api/v1/nav/routes/:slug', { auth: 'optional' }, async ctx => ({ route: await geodata.routeModel(ctx.params.slug, ctx.user) }));
  r.get('/api/v1/nav/routes/:slug/gpx', { auth: 'optional' }, async ctx => {
    const m = await geodata.routeModel(ctx.params.slug, ctx.user);
    if (m.geometryStatus !== 'available') throw E.notFound('Для этого маршрута ещё нет проверенной геометрии (data pending)');
    ctx.raw = { status: 200, headers: { 'Content-Type': 'application/gpx+xml; charset=utf-8', 'Content-Disposition': `attachment; filename="${m.slug}.gpx"`, 'Cache-Control': 'no-store' }, body: Engine.Routes.toGPX(m) };
  });
  r.put('/api/v1/nav/routes/:slug/geometry', { rate: [{ name: 'geomset', max: 30, windowMs: 3600e3, by: 'user' }], bodyLimit: 4 * 1024 * 1024, body: v.obj({
    coordinates: v.arr(v.any(200), { max: 20000 }).optional(), gpx: v.rawStr(4 * 1024 * 1024).optional(), fillElevation: v.bool().optional(), kind: v.enum(['one-way', 'round', 'loop']).optional(),
    checkpoints: v.arr(v.obj({ lat: v.lat(), lon: v.lon(), name: v.str({ max: 80 }), type: v.str({ max: 30 }).optional() }), { max: 200 }).optional(),
    hazards: v.arr(v.obj({ fromKm: v.num({ min: 0, max: 500 }), toKm: v.num({ min: 0, max: 500 }), kind: v.str({ max: 40 }), note: v.str({ max: 300 }).optional() }), { max: 100 }).optional(),
    source: v.obj({ t: v.str({ min: 3, max: 200 }), u: v.str({ max: 500 }).optional(), license: v.str({ max: 80 }).optional() }) }, { strict: true }) },
  async ctx => ({ route: await geodata.setGeometry(ctx, ctx.params.slug, ctx.body) }));
  r.post('/api/v1/nav/import-osm', { roles: ['ADMIN'], rate: [{ name: 'osmimport', max: 4, windowMs: 3600e3, by: 'user' }] }, async ctx => geodata.importOsmHiking(ctx));
  r.post('/api/v1/routing/foot', { auth: 'optional', rate: [{ name: 'routing', max: 60, windowMs: 3600e3 }], body: v.obj({ from: pt, to: pt, via: v.arr(pt, { max: 10 }).optional() }, { strict: true }) }, async ctx => ({ route: await geodata.routeFoot(ctx, ctx.body) }));

  /* ── Predictive Safety Engine: тот же модуль, что в браузере (public/js/ms-engine.js) ── */
  r.post('/api/v1/predict', { auth: 'optional', rate: [{ name: 'predict', max: 120, windowMs: 60e3 }], bodyLimit: 1024 * 1024, body: v.obj({ input: v.any(1024 * 1024) }) }, async ctx => {
    const input = ctx.body.input;
    if (!input || typeof input !== 'object' || !input.currentPosition) throw E.validation({ input: 'нужен currentPosition' });
    try { return { prediction: await Engine.Predictor.predictAsync(input) }; } catch (e) { throw E.badRequest('Некорректный вход прогноза: ' + String(e.message || e).slice(0, 200)); }
  });

  /* ── уведомления диспетчеру по инциденту (только персонал) ── */
  r.get('/api/v1/rescue/notify-config', { roles: staff }, async () => dispatch.config());
  r.get('/api/v1/rescue/incidents/:id/notifications', { params: { id: 'uuid' }, roles: staff }, async ctx => { await S.sos.load(ctx.params.id); return { notifications: await dispatch.list(ctx.params.id) }; });
  r.post('/api/v1/rescue/notifications/:id/retry', { params: { id: 'uuid' }, roles: staff, rate: [{ name: 'nretry', max: 20, windowMs: 600e3, by: 'user' }] }, async ctx => ({ notification: await dispatch.retry(ctx, ctx.params.id) }));
};


