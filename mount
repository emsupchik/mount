'use strict';
const { monitorEventLoopDelay } = require('node:perf_hooks');
function createMetrics() {
  const h = monitorEventLoopDelay({ resolution: 20 }); h.enable();
  const started = Date.now(); const routes = new Map(); const counters = { requests: 0, s2xx: 0, s3xx: 0, s4xx: 0, s5xx: 0, authFailures: 0, rateLimited: 0 };
  const q = (a, p) => a.length ? a.slice().sort((x, y) => x - y)[Math.min(a.length - 1, Math.floor(a.length * p))] : 0;
  return {
    observe(key, ms, status) {
      counters.requests++; counters['s' + Math.floor(status / 100) + 'xx']++; if (status === 401) counters.authFailures++; if (status === 429) counters.rateLimited++;
      let r = routes.get(key); if (!r) { r = { n: 0, err: 0, samples: [] }; routes.set(key, r); }
      r.n++; if (status >= 500) r.err++; r.samples.push(ms); if (r.samples.length > 300) r.samples.shift();
    },
    snapshot() {
      const mem = process.memoryUsage();
      return { uptimeSec: Math.round((Date.now() - started) / 1000), counters: Object.assign({}, counters), memoryMb: { rss: Math.round(mem.rss / 1048576), heapUsed: Math.round(mem.heapUsed / 1048576) }, eventLoopLagMs: { mean: +(h.mean / 1e6).toFixed(2), p99: +(h.percentile(99) / 1e6).toFixed(2) },
        routes: [...routes.entries()].map(([k, r]) => ({ route: k, count: r.n, errors: r.err, p50Ms: +q(r.samples, 0.5).toFixed(1), p95Ms: +q(r.samples, 0.95).toFixed(1) })).sort((a, b) => b.count - a.count).slice(0, 40) };
    },
    stop() { h.disable(); },
  };
}
module.exports = { createMetrics };


