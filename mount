# ══ v3: уведомления дежурному диспетчеру о SOS (email + SMS) ═══════════════════
# Адреса только здесь — не во фронтенде. Статус SENT в журнале появляется только после успешного ответа провайдера.
DISPATCH_EMAIL=                      # email дежурного диспетчера (задайте в .env на сервере, не коммитьте)
DISPATCH_PHONE=                      # телефон дежурного в формате +77001234567

# ── Подготовка похода: оператор персональных данных для текста согласия (текст меняет администратор в «Диспетчерская → Согласие ПДн») ──
PD_OPERATOR=                         # наименование оператора (ИП/ТОО/организация) и адрес
PD_CONTACT=                          # email для обращений по персональным данным (по умолчанию ADMIN_EMAIL)
PD_HOSTING=                          # где хранятся данные, например: «VPS Timeweb, г. Алматы, Казахстан»
# EMAIL_PROVIDER: smtp (SMTP_URL выше) | resend | sendgrid | none   (по умолчанию: smtp, если задан SMTP_URL)
EMAIL_PROVIDER=resend
RESEND_API_KEY=                     # https://resend.com → API Keys; MAIL_FROM должен быть на подтверждённом домене
SENDGRID_API_KEY=                   # если EMAIL_PROVIDER=sendgrid
# SMS_PROVIDER: twilio | smsc | mobizon | none
SMS_PROVIDER=mobizon
MOBIZON_API_KEY=                    # mobizon.kz → Настройки → API; домен API для Казахстана:
MOBIZON_DOMAIN=api.mobizon.kz
MOBIZON_FROM=                       # зарегистрированное имя отправителя (необязательно)
SMSC_LOGIN=                         # если SMS_PROVIDER=smsc (smsc.kz)
SMSC_PASSWORD=
SMSC_SENDER=
SMSC_BASE=https://smsc.kz
TWILIO_FROM=                        # если SMS_PROVIDER=twilio: номер отправителя Twilio (+1...). Использует TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN выше

# ══ v3: вход по номеру телефона (OTP) ═════════════════════════════════════════
# Код генерирует и проверяет сервер (в БД — только HMAC). Отправка: Twilio Verify (TWILIO_VERIFY_SID) или SMS_PROVIDER.
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SEC=60
OTP_DEV_ECHO=false                  # true — ТОЛЬКО для локальной разработки без SMS: код показывается на экране. В production игнорируется.

# ══ v3: карта, маршруты, точки ═══════════════════════════════════════════════
VALHALLA_URL=https://valhalla1.openstreetmap.de   # пешие маршруты по тропам OSM без ключа (off — отключить)
ORS_API_KEY=                        # OpenRouteService (если задан — используется вместо Valhalla) (пешая маршрутизация foot-hiking, «Маршрут до точки»): https://openrouteservice.org/dev/#/signup
OVERPASS_URL=https://overpass-api.de/api/interpreter   # OpenStreetMap Overpass для Mountain Points и импорта троп (ключ не нужен)
ELEVATION_URL=https://api.open-meteo.com/v1/elevation  # высоты из DEM для точек/треков без высот
MOUNTAIN_BBOX=42.95,76.70,43.30,77.40                   # область импорта (юг,запад,север,восток): горы у Алматы


