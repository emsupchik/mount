    return model;
  };
  G.listForNav = async (user) => {
    const rows = await db.all(`SELECT r.id, r.slug, r.name, r.region, r.difficulty, r.seasons, r.distance_km, r.gain_m, r.max_alt_m, r.geometry_km, r.elevation_gain_m, r.estimated_min, r.route_kind, r.origin, r.landmark, r.geometry_source, r.insight,
        (SELECT count(*)::int FROM route_points p WHERE p.route_id=r.id) npts
      FROM routes r WHERE r.status='published' AND (r.is_public OR r.owner_id=$1) ORDER BY (SELECT count(*) FROM route_points p WHERE p.route_id=r.id) > 1 DESC, r.name LIMIT 300`, [user ? user.id : null]);
    return rows.map(r => ({ id: r.id, slug: r.slug, name: r.name, region: r.region, difficulty: r.difficulty, season: r.seasons, kind: r.route_kind, origin: r.origin,
      distance: r.geometry_km != null ? +r.geometry_km : null, elevationGain: r.elevation_gain_m, estimatedDuration: r.estimated_min,
      declared: { distanceKm: r.distance_km != null ? +r.distance_km : null, gainM: r.gain_m }, geometryStatus: r.npts >= 2 ? 'available' : 'pending', source: r.geometry_source, landmark: r.landmark, insight: r.npts >= 2 && r.insight ? r.insight : insightFromCatalog(r) }));
  };

  /* Для маршрутов без геометрии — оценка по данным каталога (длина, набор высоты, сложность), с пометкой об этом */
  const insightFromCatalog = r => r.distance_km == null ? null : Engine.RouteInsight.analyze({ name: r.name, difficulty: r.difficulty, landmark: r.landmark, declared: { distanceKm: +r.distance_km, gainM: r.gain_m, maxAltM: r.max_alt_m } });
  /* Сохранение геометрии. Источник обязателен: без него координаты нельзя выдавать за реальный маршрут. */
  G.setGeometry = async (ctx, slugOrId, d) => {
    const r = await routeRow(slugOrId);
    if (ctx.user.role !== 'ADMIN' && r.owner_id !== ctx.user.id) throw E.forbidden('Менять геометрию может владелец маршрута или администратор');
    let src = d.gpx ? Engine.Routes.parseGPX(d.gpx) : { coordinates: d.coordinates, checkpoints: d.checkpoints || [] };
    if (!src.coordinates || src.coordinates.length < 2) throw E.validation({ coordinates: 'нужно минимум 2 точки' });
    if (src.coordinates.length > 20000) throw E.validation({ coordinates: 'не больше 20000 точек' });
    let coords = src.coordinates.map(c => Array.isArray(c) ? c : [c.lat, c.lon, c.ele]);
    let demUsed = false;
    if (d.fillElevation && coords.filter(c => c[2] == null).length > coords.length * 0.4) {
      const step = Math.max(1, Math.ceil(coords.length / 1000)); const sample = coords.filter((c, i) => i % step === 0 || i === coords.length - 1);
      const el = await G.elevations(sample.map(c => ({ lat: c[0], lon: c[1] }))); const map = new Map(sample.map((c, i) => [c, el[i]]));
      let last = null; coords = coords.map(c => { if (map.has(c)) last = map.get(c); return [c[0], c[1], c[2] != null ? c[2] : last]; }); demUsed = true;
    }
    const model = Engine.Routes.build({ name: r.name, coordinates: coords, checkpoints: src.checkpoints || [], difficulty: r.difficulty, kind: d.kind || r.route_kind });
    const source = { ...d.source, elevation: demUsed ? 'Open-Meteo Elevation API (Copernicus DEM 90 m)' : (d.source && d.source.elevation) || null };
    await db.tx(async q => {
      await q.query('DELETE FROM route_points WHERE route_id=$1', [r.id]);
      const C = model.coordinates;
      for (let i = 0; i < C.length; i += 1000) {
        const part = C.slice(i, i + 1000), vals = [], args = [r.id];
        part.forEach((c, k) => { args.push(i + k, c[0], c[1], c[2]); const b = args.length; vals.push(`($1,$${b - 3},$${b - 2},$${b - 1},$${b})`); });
        await q.query('INSERT INTO route_points(route_id,seq,lat,lon,ele) VALUES ' + vals.join(','), args);
      }
      const insight = Engine.RouteInsight.analyze(Object.assign({}, model, { name: r.name, difficulty: r.difficulty, landmark: r.landmark, source, declared: { distanceKm: r.distance_km != null ? +r.distance_km : null, gainM: r.gain_m, maxAltM: r.max_alt_m } }));
      await q.query(`UPDATE routes SET geometry_km=$2, elevation_gain_m=$3, elevation_loss_m=$4, estimated_min=$5, route_kind=COALESCE($6, route_kind), checkpoints=$7, hazards=COALESCE($8, hazards), geometry_source=$9, geometry_updated_at=now(), insight=$10 WHERE id=$1`,
        [r.id, model.distance, model.elevationGain, model.elevationLoss, model.estimatedDuration, d.kind || null, JSON.stringify(model.checkpoints), d.hazards ? JSON.stringify(d.hazards) : null, JSON.stringify(source), insight ? JSON.stringify(insight) : null]);
    });
    await audit.log(ctx, 'route.geometry_set', 'route', r.id, { points: model.coordinates.length, source: source.t });
    return G.routeModel(r.id, ctx.user);
  };

  /* Импорт размеченных в OSM пеших маршрутов (relation route=hiking) области — с реальной геометрией и ссылкой на relation */
  G.importOsmHiking = async (ctx, bbox = cfg.geo.bbox) => {
    const j = await overpass(`[out:json][timeout:80];relation["route"="hiking"](${bbox.join(',')});out geom tags meta;`);
    let n = 0; const out = [];
    for (const rel of (j.elements || []).filter(e => e.type === 'relation')) {
      const t = rel.tags || {}; const name = t['name:ru'] || t.name || t['name:en']; if (!name) continue;
      const segs = (rel.members || []).filter(m => m.type === 'way' && Array.isArray(m.geometry) && m.geometry.length >= 2 && !/^(stop|platform)/.test(m.role || '')).map(m => m.geometry.map(g => [g.lat, g.lon]));
      const line = chain(segs); if (line.length < 2) continue;
      const slug = 'osm-' + rel.id;
      const diff = Engine.Routes.SAC_TO_DIFF[t.sac_scale] || null;
      const route = await db.one(`INSERT INTO routes(slug,name,description,region,difficulty,is_public,origin,sources) VALUES($1,$2,$3,$4,$5,true,'osm',$6)
        ON CONFLICT (slug) DO UPDATE SET name=EXCLUDED.name, description=EXCLUDED.description, difficulty=COALESCE(EXCLUDED.difficulty, routes.difficulty), sources=EXCLUDED.sources RETURNING id, owner_id`,
        [slug, name.slice(0, 160), (t.description || t.note || '').slice(0, 1000), 'OSM · ' + bbox.join(','), diff, JSON.stringify([{ t: 'OpenStreetMap relation ' + rel.id, u: 'https://www.openstreetmap.org/relation/' + rel.id }])]);
      await G.setGeometry({ ...ctx, user: { ...ctx.user, role: 'ADMIN' } }, route.id, { coordinates: line, fillElevation: true, kind: t.roundtrip === 'yes' ? 'loop' : null,
        source: { t: 'OpenStreetMap contributors (relation ' + rel.id + ')', u: 'https://www.openstreetmap.org/relation/' + rel.id, license: 'ODbL 1.0', osmTimestamp: rel.timestamp || null } }).catch(e => log.warn({ err: e, rel: rel.id }, 'osm route geometry failed'));
      n++; out.push({ slug, name });
    }
    await audit.log(ctx, 'route.osm_import', 'routes', null, { count: n });
    return { imported: n, routes: out.slice(0, 50) };
  };
  /* Склейка отрезков relation в одну линию (жадно, по ближайшим концам; при разрыве > 200 м — остановка, чтобы не рисовать «прыжки») */
  function chain(segs) {
    if (!segs.length) return []; const rest = segs.slice(1); let line = segs[0].slice();
    const d = (a, b) => Engine.Geo.dist({ lat: a[0], lon: a[1] }, { lat: b[0], lon: b[1] });
    while (rest.length) {
      const end = line[line.length - 1], start = line[0]; let best = null;
      rest.forEach((s, i) => { const c = [[d(end, s[0]), i, 'ee'], [d(end, s[s.length - 1]), i, 'er'], [d(start, s[s.length - 1]), i, 'se'], [d(start, s[0]), i, 'sr']]; for (const x of c) if (!best || x[0] < best[0]) best = x; });
      if (!best || best[0] > 200) break;
      const s = rest.splice(best[1], 1)[0];
      if (best[2] === 'ee') line = line.concat(s.slice(1)); else if (best[2] === 'er') line = line.concat(s.slice().reverse().slice(1));
      else if (best[2] === 'se') line = s.concat(line.slice(1)); else line = s.slice().reverse().concat(line.slice(1));
    }
    return line;
  }

  /* Пеший маршрут между точками через OpenRouteService (профиль foot-hiking, с высотами). Ключ только на сервере. */
  /* Пеший маршрут между точками по реальным тропам и дорогам OpenStreetMap.
     1) OpenRouteService foot-hiking (если задан ORS_API_KEY), иначе
     2) Valhalla (публичный сервер FOSSGIS, ключ не нужен; VALHALLA_URL=off — отключить), профиль pedestrian с допуском горных троп (max_hiking_difficulty=6).
     Высоты — из ответа ORS или из цифровой модели рельефа (Open-Meteo). Если маршрут не найден — честная ошибка, никакой выдуманной линии. */
  const decode6 = (str) => { let i = 0, lat = 0, lon = 0; const out = []; while (i < str.length) { let b, sh = 0, r = 0; do { b = str.charCodeAt(i++) - 63; r |= (b & 31) << sh; sh += 5; } while (b >= 32); lat += (r & 1) ? ~(r >> 1) : (r >> 1); sh = 0; r = 0; do { b = str.charCodeAt(i++) - 63; r |= (b & 31) << sh; sh += 5; } while (b >= 32); lon += (r & 1) ? ~(r >> 1) : (r >> 1); out.push([lat / 1e6, lon / 1e6]); } return out; };
  async function withElevation(coords) {
    if (coords.every(c => c[2] != null)) return { coords, dem: false };
    const step = Math.max(1, Math.ceil(coords.length / 300)); const idx = coords.map((c, i) => i).filter(i => i % step === 0 || i === coords.length - 1);
    try { const el = await G.elevations(idx.map(i => ({ lat: coords[i][0], lon: coords[i][1] }))); let last = null; const map = new Map(idx.map((x, n) => [x, el[n]])); return { coords: coords.map((c, i) => { if (map.has(i) && map.get(i) != null) last = map.get(i); return [c[0], c[1], c[2] != null ? c[2] : last]; }), dem: true }; }
    catch (e) { log.warn({ err: e }, 'route elevation failed'); return { coords, dem: false }; }
  }
  G.routeFoot = async (ctx, { from, to, via = [] }) => {
    const pts = [from, ...via, to];
    if (cfg.geo.orsKey) {
      let r; try { r = await F(cfg.geo.orsBase + '/v2/directions/foot-hiking/geojson', { method: 'POST', headers: { Authorization: cfg.geo.orsKey, 'Content-Type': 'application/json', Accept: 'application/geo+json' }, body: JSON.stringify({ coordinates: pts.map(p => [p.lon, p.lat]), elevation: true, instructions: false }), signal: AbortSignal.timeout(25000) }); }
      catch (e) { throw E.unavailable('OpenRouteService недоступен', 'routing_failed'); }
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.features || !j.features[0]) throw E.unavailable('OpenRouteService: ' + ((j.error && (j.error.message || j.error)) || ('HTTP ' + r.status)), 'routing_failed');
      const f = j.features[0]; const c = f.geometry.coordinates.map(x => [x[1], x[0], x[2] != null ? x[2] : null]);
      const model = Engine.Routes.build({ name: 'Пеший маршрут (OpenRouteService)', coordinates: c, kind: 'one-way', source: { t: 'OpenRouteService foot-hiking · © OpenStreetMap contributors', u: 'https://openrouteservice.org', license: 'ODbL' } });
      model.provider = { name: 'openrouteservice', distanceM: f.properties && f.properties.summary && f.properties.summary.distance, durationSec: f.properties && f.properties.summary && f.properties.summary.duration };
      return model;
    }
    if (cfg.geo.valhallaUrl === 'off') throw E.unavailable('Маршрутизация не настроена: задайте ORS_API_KEY или VALHALLA_URL', 'routing_not_configured');
    let r; try { r = await F(cfg.geo.valhallaUrl.replace(/\/$/, '') + '/route', { method: 'POST', headers: { 'Content-Type': 'application/json', 'User-Agent': 'MountainSafe/3' }, body: JSON.stringify({ locations: pts.map(p => ({ lat: p.lat, lon: p.lon })), costing: 'pedestrian', costing_options: { pedestrian: { max_hiking_difficulty: 6, use_hills: 1 } }, directions_options: { units: 'kilometers' } }), signal: AbortSignal.timeout(30000) }); }
    catch (e) { throw E.unavailable('Сервис маршрутов (Valhalla) недоступен', 'routing_failed'); }
    const j = await r.json().catch(() => ({}));
    if (!r.ok || !j.trip || !j.trip.legs) throw E.unavailable('Маршрут по тропам не найден: ' + (j.error || ('HTTP ' + r.status)) + '. Возможно, до этой точки в OpenStreetMap нет тропы', 'routing_failed');
    let c = []; j.trip.legs.forEach((leg, n) => { const d = decode6(leg.shape); c = c.concat(n ? d.slice(1) : d); });
    const el = await withElevation(c.map(x => [x[0], x[1], null]));
    const model = Engine.Routes.build({ name: 'Пеший маршрут по тропам OSM', coordinates: el.coords, kind: 'one-way', source: { t: 'Valhalla (FOSSGIS) pedestrian · © OpenStreetMap contributors' + (el.dem ? ' · высоты: Copernicus DEM (Open-Meteo)' : ''), u: 'https://valhalla1.openstreetmap.de', license: 'ODbL' } });
    model.provider = { name: 'valhalla', distanceM: Math.round((j.trip.summary.length || 0) * 1000), durationSec: Math.round(j.trip.summary.time || 0) };
    return model;
  };

  G.status = () => ({ overpass: cfg.geo.overpassUrl, routing: cfg.geo.orsKey ? 'configured' : cfg.geo.valhallaUrl !== 'off' ? 'configured' : 'not_configured', routingProvider: cfg.geo.orsKey ? 'openrouteservice' : cfg.geo.valhallaUrl !== 'off' ? 'valhalla' : null, elevation: cfg.geo.elevationUrl, bbox: cfg.geo.bbox });
  return G;
}
