    SEASONS,
    of(ms, lat = 43) { const m = new Date(ms).getUTCMonth() + 1; const north = lat >= 0; const s = [12, 1, 2].includes(m) ? 'winter' : [3, 4, 5].includes(m) ? 'spring' : [6, 7, 8].includes(m) ? 'summer' : 'autumn'; if (north) return s; return { winter: 'summer', summer: 'winter', spring: 'autumn', autumn: 'spring' }[s]; },
    /* Коэффициент скорости для высоты: зимой/весной выше «снеговой» отметки идём медленнее */
