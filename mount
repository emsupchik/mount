test('OTP: провайдер отказал → 503 и статус не SENT; без провайдера — честный DEV_ECHO только вне production', async () => {
  net.st.smsFail = true; const p = phone();
  const r = await client(env).post('/api/v1/auth/otp/send', { phone: p }); assert.equal(r.status, 503); assert.equal(r.body.error.code, 'sms_failed');
