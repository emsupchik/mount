      else if (k === 'where') body += `<div class="st-h">Где вы находитесь?</div><p class="muted-p">Введите координаты или ориентиры, либо определите по GPS. Последние сохранённые координаты подставлены заранее.</p><div class="field"><input id="stWhere" value="${esc(S.a.where)}" placeholder="43.12345, 77.12345 или «у озера, 3 ч от старта»"></div><div class="ans"><button class="btn" data-action="stGps">Определить по GPS</button><button class="btn btn-primary" data-action="stWhere">Дальше</button><button class="btn btn-ghost" data-action="stWhere" data-v="0">Не знаю, где я</button></div>`;
