writeconf() {   # $1 — папка сертификата (пусто → только http)
  {
    echo "server { listen 80 default_server; server_name _; client_max_body_size 5m;"
    echo "  location / { proxy_pass http://127.0.0.1:3000; $PROXY proxy_set_header X-Forwarded-Proto \$scheme; } }"
    if [ -n "$1" ]; then
      echo "server { listen 80; server_name $NAMES; location /.well-known/ { root /var/www/html; } location / { return 301 https://\$host\$request_uri; } }"
      echo "server { listen 443 ssl; server_name $NAMES; client_max_body_size 5m;"
      echo "  ssl_certificate $1/fullchain.pem; ssl_certificate_key $1/privkey.pem;"
      echo "  location /api/v1/stream { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Connection \"\"; proxy_buffering off; proxy_cache off; proxy_read_timeout 1h; $PROXY proxy_set_header X-Forwarded-Proto https; }"
      echo "  location / { proxy_pass http://127.0.0.1:3000; $PROXY proxy_set_header X-Forwarded-Proto https; } }"
    else
      echo "server { listen 80; server_name $NAMES; client_max_body_size 5m; location /.well-known/ { root /var/www/html; }"
      echo "  location / { proxy_pass http://127.0.0.1:3000; $PROXY proxy_set_header X-Forwarded-Proto \$scheme; } }"
    fi
  } > "$CONF"
  ln -sf "$CONF" /etc/nginx/sites-enabled/mountainsafe; rm -f /etc/nginx/sites-enabled/default
