        id: src.id || src.slug || null, name: src.name || 'Маршрут', description: src.description || '',
        coordinates: P.pts.map(p => [round(p.lat, 6), round(p.lon, 6), p.ele == null ? null : Math.round(p.ele)]),
        distance: round(P.totalKm, 2), elevationGain: el.gain, elevationLoss: el.loss, minEle: el.min, maxEle: el.max, elevationCoverage: round(el.coverage, 2),
        estimatedDuration: dur.minutes, durationMethod: dur.method,
