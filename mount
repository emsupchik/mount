.sim-warns li.warn{background:rgba(245,197,66,.08);border:1px solid #7a6420}.sim-warns li.warn .ic{color:var(--warn)}
.sim-warns li.crit{background:rgba(239,68,68,.09);border:1px solid #7a3437}.sim-warns li.crit .ic{color:var(--crit)}
