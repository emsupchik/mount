'use strict';
/* Ограничитель запросов (скользящее окно в памяти процесса).
   Для нескольких экземпляров сервера: перенесите в Redis/Postgres (интерфейс hit(key,max,windowMs) тот же). */
class RateLimiter {
  constructor(enabled = true) { this.enabled = enabled; this.b = new Map(); this.timer = setInterval(() => this.gc(), 60000); this.timer.unref(); }
  hit(key, max, windowMs) {
    if (!this.enabled) return { ok: true, retry: 0 };
    const now = Date.now(); let a = this.b.get(key);
    if (!a) { a = []; this.b.set(key, a); }
    while (a.length && now - a[0] > windowMs) a.shift();
    if (a.length >= max) return { ok: false, retry: Math.ceil((windowMs - (now - a[0])) / 1000) };
    a.push(now); a.w = windowMs; return { ok: true, retry: 0 };
  }
  gc() { const now = Date.now(); for (const [k, a] of this.b) { if (!a.length || now - a[a.length - 1] > (a.w || 60000)) this.b.delete(k); } if (this.b.size > 100000) this.b.clear(); }
  reset() { this.b.clear(); }
  stop() { clearInterval(this.timer); }
}
module.exports = { RateLimiter };


