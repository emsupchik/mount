'use strict';
/* Браузерные сценарии: запускают настоящий сервер + PostgreSQL и Chromium. Нужны: npm i (devDependencies), PostgreSQL (TEST_DATABASE_URL),
   Chromium (Playwright сам скачает: npx playwright install chromium; либо CHROMIUM_PATH=/путь/к/chromium). */
const {chromium}=require('playwright');
const {makeEnv,client,signup,staff,login}=require('../test/helpers');
const STATIC=require('path').join(__dirname,'..','public');
async function boot(extra={}){
  const env=await makeEnv({env:{STATIC_DIR:STATIC,...(extra.env||{})},pushSender:extra.pushSender});
  const b=await chromium.launch(process.env.CHROMIUM_PATH?{executablePath:process.env.CHROMIUM_PATH}:{});
  const res=[],errs=[];
  const ok=(n,v,x='')=>{res.push((v?'PASS ':'FAIL ')+n+(v?'':'  ← '+x));};
  const ctx=async(o={})=>{const{realMode,...oo}=o;const c=await b.newContext({viewport:{width:1200,height:850},geolocation:{latitude:43.05,longitude:76.98,accuracy:12},permissions:['geolocation'],...oo});
    /* старые проверки демо-сценариев работают с ?demo; realMode — как у обычного пользователя */
    if(!realMode)await c.addInitScript(()=>{try{sessionStorage.setItem('ms_show_demo','1')}catch(e){}});
    await c.route('**/fonts.g*/**',r=>r.abort());await c.route('**/*.mp4',r=>r.abort());await c.route('**/tile.openstreetmap.org/**',r=>r.abort());await c.route('**/api.open-meteo.com/**',r=>r.fulfill({json:{elevation:1600,current:{temperature_2m:8,precipitation:0,wind_speed_10m:12,weather_code:1},hourly:{time:[],temperature_2m:[],precipitation:[],wind_speed_10m:[],visibility:[],weather_code:[],cape:[]}}}));return c};
  const page=async(c,name)=>{const p=await c.newPage();p.on('pageerror',e=>errs.push(name+' PAGEERR '+e.message+' '+String(e.stack).split('\n').slice(1,4).join(' | ')));p.on('console',m=>{if(m.type()==='error'&&!/Failed to load|ERR_|net::|favicon|Content Security/.test(m.text()))errs.push(name+' CONSOLE '+m.text())});p.on('dialog',d=>d.accept());await p.goto(env.base+'/');await p.waitForFunction(()=>window.Remote&&(Remote.available||Remote.available===false),null,{timeout:8000}).catch(()=>{});await p.waitForTimeout(500);return p};
  return {env,b,res,errs,ok,ctx,page,async close(){await b.close();await env.close()},report(){console.log(res.join('\n'));console.log('ERRS',errs.length?errs:'none');const f=res.filter(x=>x.startsWith('FAIL')).length;console.log(f+' failed of '+res.length);if(f||errs.length)process.exitCode=1}};
}
async function uiRegister(p,{name,email,phone='+77011234567',password='Sup3r-secret-pass',role='authTourist'}){
  await p.click(`[data-action=${role}]`);await p.waitForSelector('[data-action=authTab][data-tab=register]');await p.click('[data-action=authTab][data-tab=register]');
  await p.fill('[name=name]',name);await p.fill('[name=login]',email);await p.fill('[name=phone]',phone.replace('+7',''));await p.fill('[name=password]',password);await p.fill('[name=password2]',password);
  await p.click('form[data-form=register] button[type=submit]');await p.waitForFunction(()=>Remote.active,null,{timeout:8000});await p.waitForTimeout(400);
}
async function uiLogin(p,{email,password,role='authTourist'}){
  await p.locator(`[data-action=${role}]:visible`).first().click();await p.waitForSelector("form[data-form=login]");await p.fill('[name=login]',email);await p.fill('[name=password]',password);await p.click('form[data-form=login] button[type=submit]');await p.waitForFunction(()=>Remote.active,null,{timeout:8000});await p.waitForTimeout(500);
}
module.exports={boot,uiRegister,uiLogin,client,signup,staff,login};


