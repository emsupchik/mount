        <div class="field" data-field="level"><label for="f-level">Уровень подготовки</label><select id="f-level" name="level">${LEVELS.map((l, i) => `<option value="${i}" ${(r === 'leader' && i === 2) ? 'selected' : ''}>${l.k} · ${esc(l.ru)}</option>`).join('')}</select></div>
        ${r === 'leader' ? fld({ name: 'org', label: 'Организация / класс', ph: 'Школа, турклуб' }) : ''}
        ${fld({ name: 'password', label: 'Пароль', type: 'password', ac: 'new-password' })}${fld({ name: 'password2', label: 'Повторите пароль', type: 'password', ac: 'new-password' })}</div>
        <button class="btn btn-primary btn-block" type="submit">Получить SMS-код</button><p class="muted-p" style="margin-top:10px;font-size:12px">${Sms.mode === 'live' ? 'Мы отправим код по SMS на этот номер.' : 'ДЕМО-режим: сервер SMS не подключён, код покажем на экране и на телефон он не придёт.'}</p></form>`;
    }
    body.innerHTML = html;
    const ph = $('[name="phone"]', body); if (ph) phoneMask(ph);
  },
  smsHtml() {
    const p = Api._pending ? fmtPhone(Api._pending.f.phone) : '';
    return `<div style="text-align:center"><h3 class="sms-h" style="font-size:26px">Введите код</h3><p class="muted-p">${Sms.mode === 'live' ? `Мы отправили SMS с кодом на ${esc(p)}. Обычно оно приходит за несколько секунд.` : `ДЕМО-режим: SMS на телефон не отправляется. Код: <b class="mono">${CONFIG.smsCode}</b>`}</p>
      <div class="otp-row" id="otp-row">${Array.from({ length: Sms.len }, (_, i) => i).map(i => `<input class="otp" inputmode="numeric" maxlength="1" data-i="${i}" aria-label="Цифра ${i + 1}" autocomplete="one-time-code">`).join('')}</div>
      <p class="muted-p" id="otp-msg" style="min-height:22px"></p>
      <div class="row" style="justify-content:center"><button class="btn btn-ghost btn-sm" data-action="smsBack">← Назад</button><button class="btn btn-ghost btn-sm" id="resend" data-action="resendSms" disabled>Повторить через ${CONFIG.smsResendSeconds} с</button></div></div>`;
  },
  bindOtp() {
    const ins = $$('.otp'); ins.forEach((el, i) => {
      el.addEventListener('input', () => { el.value = digits(el.value).slice(-1); el.classList.toggle('filled', !!el.value); if (el.value && ins[i + 1]) ins[i + 1].focus(); if (ins.every(x => x.value)) this.verify(ins.map(x => x.value).join('')); });
      el.addEventListener('keydown', e => { if (e.key === 'Backspace' && !el.value && ins[i - 1]) ins[i - 1].focus(); });
      el.addEventListener('paste', e => { const t = digits((e.clipboardData || window.clipboardData).getData('text')).slice(0, ins.length); if (t.length === ins.length) { e.preventDefault(); ins.forEach((x, k) => { x.value = t[k]; x.classList.add('filled'); }); this.verify(t); } });
    }); if (ins[0]) ins[0].focus();
  },
  busy: false,
  async verify(code) {
    if (this.busy) return; this.busy = true;
    try { await Api.auth.verifySms(code); Modal.closeAll(); Toast.show('Добро пожаловать!', { icon: '⛰' }); Router.go('#/' + Views.homeRoute(Sel.me())); }
    catch (e) { const row = $('#otp-row'); if (row) { row.classList.add('bad'); setTimeout(() => row.classList.remove('bad'), 450); $$('.otp').forEach(x => { x.value = ''; x.classList.remove('filled'); }); $$('.otp')[0].focus(); } const m = $('#otp-msg'); if (m) m.textContent = e.message; }
    finally { this.busy = false; }
  },
  startTimer() { this.stopTimer(); this.left = CONFIG.smsResendSeconds; this.timer = setInterval(() => { this.left--; const b = $('#resend'); if (!b) return this.stopTimer(); if (this.left <= 0) { b.disabled = false; b.textContent = 'Отправить снова'; this.stopTimer(); } else b.textContent = `Повторить через ${this.left} с`; }, 1000); },
  stopTimer() { if (this.timer) { clearInterval(this.timer); this.timer = null; } },
  async login(form, btn) {
    const errors = {}, login = val(form, 'login').trim(), pass = val(form, 'password');
    if (!login) errors.login = 'Введите логин'; if (!pass) errors.password = 'Введите пароль';
    if (Object.keys(errors).length) return showErrors(form, errors);
    setBusy(btn, true, 'Входим…');
    try { const u = await Api.auth.login({ role: this.role, login, password: pass }); Modal.closeAll(); Toast.show(`Здравствуйте, ${u.name}!`, { icon: '⛰' }); Router.go('#/' + Views.homeRoute(u)); }
    catch (e) { setBusy(btn, false); showErrors(form, { password: e.message }); }
  },
  async register(form, btn) {
    const v = n => val(form, n).trim(), errors = {};
    if (v('name').length < 2) errors.name = 'Введите имя'; if (digits(v('phone')).length < 11) errors.phone = 'Введите номер полностью';
    if (!/^[\wа-яё.-]{3,}$/i.test(v('login'))) errors.login = 'От 3 символов, без пробелов'; if (val(form, 'password').length < 6) errors.password = 'Минимум 6 символов';
    if (val(form, 'password2') !== val(form, 'password')) errors.password2 = 'Пароли не совпадают';
    if (Object.keys(errors).length) return showErrors(form, errors);
    setBusy(btn, true, 'Отправляем…');
    try { await Api.auth.register(this.role, { name: v('name'), phone: v('phone'), login: v('login'), password: val(form, 'password'), level: v('level'), org: v('org') }); this.step = 'sms'; Modal.setTitle('auth', 'Подтверждение'); this.paint(); }
    catch (e) { setBusy(btn, false); showErrors(form, /SMS|сервер|связ|код/i.test(e.message) ? { phone: e.message } : { login: e.message }); }
  },
};


/* ════════════════════════════════════════════════════════════════
   5. TOURIST — SOS, Stress Mode, подготовка, маршрут, погода, памятки, обучение, группа, карточка
