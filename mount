    if (step === 1) { if (!d.route.end || !d.route.end.name) e.end = 'Укажите конечную точку'; if (d.route.distanceKm != null && (d.route.distanceKm < 0 || d.route.distanceKm > 2000)) e.distance = 'Проверьте протяжённость'; }
    if (step === 2) {
      const s = d.schedule; if (!s.startDate) e.startDate = 'Укажите дату начала'; if (!s.startTime) e.startTime = 'Укажите время начала'; if (!s.returnDate) e.returnDate = 'Укажите дату возвращения'; if (!s.returnTime) e.returnTime = 'Укажите время возвращения';
      const a = localMs(s.startDate, s.startTime), b = localMs(s.returnDate, s.returnTime);
      if (a && b && b <= a) e.returnDate = 'Дата возвращения не может быть раньше даты начала'; else if (b && b < Date.now()) e.returnDate = 'Время возвращения уже прошло';
      d.overnights.forEach((o, i) => { if (o.arriveDate && o.leaveDate && o.leaveDate < o.arriveDate) e['night' + i] = 'Дата ухода раньше даты прибытия'; });
    }
    if (step === 3) {
      const L = d.leader;
      if (!L.lastName.trim()) e.leaderLast = 'Укажите фамилию'; else if (!NAME.test(L.lastName.trim())) e.leaderLast = 'Только буквы';
      if (!L.firstName.trim()) e.leaderFirst = 'Укажите имя'; else if (!NAME.test(L.firstName.trim())) e.leaderFirst = 'Только буквы';
      if (!L.phone.trim()) e.leaderPhone = 'Укажите номер телефона'; else if (!PHONE.test(phoneNorm(L.phone))) e.leaderPhone = 'Формат: +77001234567';
      if (!L.consent) e.leaderConsent = 'Нужно согласие ответственного';
      d.participants.forEach((p, i) => {
        if (!p.lastName.trim()) e['pl' + i] = 'Фамилия'; if (!p.firstName.trim()) e['pf' + i] = 'Имя';
        if (p.phone && p.phone.trim() && !PHONE.test(phoneNorm(p.phone))) e['pp' + i] = 'Формат: +77001234567';
        if (!p.consent) e['pc' + i] = 'Отметьте согласие участника или уберите его из списка';
      });
    }
    if (step === 6) for (const k of ['route', 'people', 'warnings', 'consent']) if (!d.confirmations[k]) e['c_' + k] = 'Отметьте пункт';
    return e;
  }

  /* ═════════════ отрисовка мастера ═════════════ */
  const err = k => TW.errs[k] ? `<div class="tw-err" role="alert">${esc(TW.errs[k])}</div>` : '';
  const fld = (label, name, val, o = {}) => `<div class="field" ${o.span ? 'style="grid-column:1/-1"' : ''}><label for="tw-${name}">${esc(label)}${o.req ? ' <span class="rq">*</span>' : ''}</label>${o.area ? `<textarea id="tw-${name}" data-tw="${name}" rows="${o.rows || 3}" maxlength="${o.max || 1500}">${esc(val || '')}</textarea>` : `<input id="tw-${name}" data-tw="${name}" type="${o.type || 'text'}" value="${esc(val ?? '')}" ${o.attr || ''} ${o.max ? `maxlength="${o.max}"` : ''} autocomplete="${o.ac || 'off'}">`}${err(o.err || name)}</div>`;
  const ck = (label, key, on, o = {}) => `<label class="tw-ck"><input type="checkbox" data-twck="${key}" ${on ? 'checked' : ''}><span>${esc(label)}${o.req ? ' <span class="rq" style="color:var(--crit,#ef4444)">*</span>' : ''}</span></label>`;
  const chips = (key, opts, cur, multi) => `<div class="tw-chips" role="${multi ? 'group' : 'radiogroup'}">${opts.map(([v, l]) => { const on = multi ? cur.includes(v) : cur === v; return `<button type="button" class="chip ${on ? 'on' : ''}" data-action="twChip" data-k="${key}" data-v="${v}" ${multi ? '' : 'role="radio"'} aria-${multi ? 'pressed' : 'checked'}="${on}">${esc(l)}</button>`; }).join('')}</div>`;
  const ptBox = (label, key, p, o = {}) => `<div class="tw-pt"><div class="row sp"><b>${esc(label)}${o.req ? ' <span class="rq" style="color:var(--crit,#ef4444)">*</span>' : ''}</b>${o.rm ? `<button type="button" class="btn btn-sm" data-action="twPtRemove" data-k="${key}">${t('remove')}</button>` : ''}</div>
    <div class="tw-pv">${p ? esc(p.name) + (p.lat != null ? `<small>${coordTxt(p)} · ${({ map: 'с карты', search: 'из поиска', gps: 'по GPS', manual: 'вручную' })[p.source] || ''}</small>` : '<small>без координат</small>') : `<span class="muted">${t('notSet')}</span>`}</div>
    <div class="tw-pb"><button type="button" class="btn btn-sm" data-action="twPick" data-k="${key}" data-mode="map">🗺 ${t('pickMap')}</button><button type="button" class="btn btn-sm" data-action="twPick" data-k="${key}" data-mode="search">🔎 ${t('pickSearch')}</button><button type="button" class="btn btn-sm" data-action="twPick" data-k="${key}" data-mode="gps">📍 ${t('pickGps')}</button></div>${err(o.err || key)}</div>`;

  function stepHtml(n) {
    const d = TW.d;
    if (n === 1) return `<h2>${t('s1')}</h2>
      <div class="tw-sec">Готовый маршрут</div>
      ${d.routeSel ? `<div class="tw-pt"><div class="row sp"><b>🧭 ${esc(d.routeSel.name)}</b><button type="button" class="btn btn-sm" data-action="twRouteClear">${t('remove')}</button></div><div class="muted-p" style="font-size:13px">Точки начала и конца взяты из маршрута. Тип, длина, сложность, удалённость и опасные участки посчитаны по нему.</div></div>`
        : `<button type="button" class="btn btn-block" data-action="twRouteList" style="min-height:52px;justify-content:flex-start">📚 Выбрать маршрут из «Горы Алматы» (с треками и сводкой)</button>`}
      <div class="tw-sec req">${t('required')}</div>
      ${ptBox(t('end'), 'end', d.route.end, { req: true })}
      <div class="tw-sec">${t('recommended')}</div>
      <div class="col" style="gap:10px">${fld(t('tripName'), 'name', d.name, { max: 120 })}
      ${ptBox(t('start'), 'start', d.route.start)}
      ${d.route.waypoints.map((w, i) => ptBox('Промежуточная точка ' + (i + 1), 'wp' + i, w, { rm: true })).join('')}
      <div><button type="button" class="btn btn-sm" data-action="twAddWp">${t('addWaypoint')}</button></div>
      <div id="tw-auto">${autoHtml()}</div>
      ${fld(t('routeDesc'), 'routeDesc', d.route.description, { area: 1, span: 1 })}</div>`;
    if (n === 2) {
      const h = durationHours(d), nights = nightsBetween(d.schedule.startDate, d.schedule.returnDate), ins = d.insight;
      const dayOpts = (cur) => { const out = []; if (!d.schedule.startDate || !d.schedule.returnDate) return ''; for (let x = new Date(d.schedule.startDate + 'T12:00'); ymd(x) <= d.schedule.returnDate; x = new Date(x.getTime() + 86400e3)) out.push(`<option value="${ymd(x)}" ${ymd(x) === cur ? 'selected' : ''}>${ruDate(ymd(x))}</option>`); return '<option value="">—</option>' + out.join(''); };
      return `<h2>${t('s2')}</h2><div class="tw-sec req">${t('required')}</div>
      <button type="button" class="tw-dates" data-action="twDates" id="tw-dates">
        <span><small>Выход в поход</small><b>${ruDate(d.schedule.startDate)}, ${esc(d.schedule.startTime || '—')}</b></span>
        <span><small>Возвращение</small><b>${ruDate(d.schedule.returnDate)}, ${esc(d.schedule.returnTime || '—')}</b></span>
        <span class="btn btn-primary" style="pointer-events:none">📅 Выбрать даты</span></button>
      ${err('startDate')}${err('startTime')}${err('returnDate')}${err('returnTime')}
      <div class="card" style="margin-top:12px"><div class="tw-sum"><span>${t('duration')}</span><b id="tw-dur">${durText(h)}</b><span>${t('nights')}</span><b id="tw-nights">${nights}</b>
      ${ins ? `<span>По маршруту</span><b>${X.km(ins.distanceKm)} · ходьбы ~${ins.totalHours} ч · ${ins.days} ${plural(ins.days, 'день', 'дня', 'дней')}</b>` : ''}</div>
      ${ins && h != null && h < ins.totalHours ? `<div class="warnbox" style="margin-top:10px">По маршруту нужно около ${ins.totalHours} ч ходьбы, а запланировано ${durText(h)}. <button type="button" class="btn btn-sm" data-action="twDatesAuto">Подставить по маршруту</button></div>` : ''}</div>
      ${nights >= 1 ? `<div class="tw-sec">${t('nightPlaces')} · ${t('recommended').toLowerCase()}</div>
      <div class="col" style="gap:10px">${d.overnights.map((o, i) => `<div class="tw-person"><div class="tw-ph"><b>Ночёвка ${i + 1}</b><button type="button" class="btn btn-sm" data-action="twNightRm" data-i="${i}">${t('remove')}</button></div>
        ${fld(t('nightName'), 'nName' + i, o.name, { max: 120 })}<div class="tw-pv"><small style="font-variant-numeric:tabular-nums">${o.lat != null ? coordTxt(o) : 'координаты не выбраны'}</small></div>
        <div class="tw-pb row" style="gap:6px;flex-wrap:wrap"><button type="button" class="btn btn-sm" data-action="twPick" data-k="night${i}" data-mode="map">🗺 ${t('pickMap')}</button><button type="button" class="btn btn-sm" data-action="twPick" data-k="night${i}" data-mode="search">🔎 ${t('pickSearch')}</button><button type="button" class="btn btn-sm" data-action="twPick" data-k="night${i}" data-mode="gps">📍 ${t('pickGps')}</button></div>
        <div class="tw-grid"><div class="field"><label>${t('arrive')}</label><select data-twsel="nArr${i}">${dayOpts(o.arriveDate)}</select></div><div class="field"><label>${t('leave')}</label><select data-twsel="nLeave${i}">${dayOpts(o.leaveDate)}</select>${err('night' + i)}</div></div></div>`).join('')}
      <div><button type="button" class="btn" data-action="twNightAdd">${t('addNight')}</button></div></div>` : ''}`;
    }
    if (n === 3) {
      const L = d.leader, c = TW.consent;
      return `<h2>${t('s3')}</h2><div class="tw-sec req">${t('leader')}</div>
      <div class="tw-grid">${fld(t('last'), 'lLast', L.lastName, { req: 1, max: 60, err: 'leaderLast', ac: 'family-name' })}${fld(t('first'), 'lFirst', L.firstName, { req: 1, max: 60, err: 'leaderFirst', ac: 'given-name' })}
      ${fld(t('middle'), 'lMiddle', L.middleName, { max: 60, ac: 'additional-name' })}${fld(t('phone'), 'lPhone', L.phone, { req: 1, type: 'tel', attr: 'placeholder="+77001234567" inputmode="tel"', err: 'leaderPhone', ac: 'tel' })}</div>
      <div class="tw-sec">${t('members')} · <span id="tw-count">${t('count', { n: count(d) })}</span></div>
      <div class="col" style="gap:10px">${d.participants.map((p, i) => `<div class="tw-person"><div class="tw-ph"><b>№ ${i + 2}</b><button type="button" class="btn btn-sm" data-action="twMemberRm" data-i="${i}" aria-label="Убрать участника ${i + 2}">${t('remove')}</button></div>
        <div class="tw-grid">${fld(t('last'), 'pLast' + i, p.lastName, { req: 1, max: 60, err: 'pl' + i })}${fld(t('first'), 'pFirst' + i, p.firstName, { req: 1, max: 60, err: 'pf' + i })}${fld(t('middle'), 'pMiddle' + i, p.middleName, { max: 60 })}${fld(t('phoneOpt'), 'pPhone' + i, p.phone, { type: 'tel', attr: 'placeholder="+77001234567" inputmode="tel"', err: 'pp' + i })}</div>
        ${ck(t('consentGiven'), 'pc' + i, p.consent, { req: 1 })}${err('pc' + i)}</div>`).join('')}
      <div><button type="button" class="btn" data-action="twMemberAdd">${t('addMember')}</button></div></div>
      <div class="tw-sec req">${t('consentTitle')}</div>
      <div class="card"><div id="tw-ctext">${consentHtml(c)}</div>
      ${ck(t('leaderConsent'), 'leaderConsent', L.consent, { req: 1 })}${err('leaderConsent')}
      <div class="muted-p" style="font-size:13px">Собираем только ФИО и телефоны. ИИН, паспорт и адрес не нужны и не запрашиваются.</div></div>`;
    }
    if (n === 4) {
      const r = riskOf(d);
      return `<h2>${t('s4')}</h2>${d.insight ? `<div class="card"><b>🎒 Снаряжение для этого маршрута</b><ul style="margin:6px 0 0 18px">${d.insight.equipment.map(x => `<li>${esc(x)}</li>`).join('')}</ul></div>` : ''}<div class="tw-sec">Что у вас есть · ${t('recommended').toLowerCase()}</div>
      <div class="tw-eq">${EQUIP_GROUPS.map(([g, items]) => `<div class="tw-eqg"><b>${esc(g)}</b>${items.map(([k, l]) => ck(l, 'eq_' + k, !!d.equipment[k])).join('')}</div>`).join('')}</div>
      <div id="tw-riskbox" style="margin-top:14px">${riskHtml(r)}</div>`;
    }
    if (n === 5) return `<h2>${t('s5')}</h2>${summaryHtml(d)}<div style="margin-top:12px">${riskHtml(riskOf(d))}</div><div class="muted-p" style="margin-top:12px">${t('official')}</div>`;
    if (n === 6) {
      const c = d.confirmations;
      return `<h2>${t('s6')}</h2><div class="card col">${ck(t('c1'), 'c_route', c.route, { req: 1 })}${err('c_route')}${ck(t('c2'), 'c_people', c.people, { req: 1 })}${err('c_people')}${ck(t('c3'), 'c_warnings', c.warnings, { req: 1 })}${err('c_warnings')}${ck(t('c4'), 'c_consent', c.consent, { req: 1 })}${err('c_consent')}</div>
      ${TW.errs._server ? `<div class="dngbox" role="alert">${esc(TW.errs._server)}</div>` : ''}<div class="muted-p" style="margin-top:10px">${t('official')}</div>`;
    }
    return '';
  }
  function consentHtml(c) {
    return c ? `<details><summary style="cursor:pointer;font-weight:700">📄 ${t('consentRead')}${c.version ? ' (версия ' + c.version + ')' : ''}</summary><div style="white-space:pre-wrap;margin-top:10px;font-size:14px;line-height:1.5">${esc(c.body)}</div>${c.isDefault ? '<div class="muted-p" style="font-size:12px;margin-top:8px">Текст подготовлен как черновик и может быть изменён администратором после юридической проверки.</div>' : ''}</details>` : '<div class="muted-p">Загружаем текст согласия…</div>';
  }
  function riskHtml(r) {
    return `<div class="tw-risk ${r.level}" role="status" aria-live="polite"><h3>${r.icon} ${esc(r.label)} <small style="font:600 13px var(--font);color:var(--ink-3)">· ${t('riskTitle')}, баллы: ${r.score}</small></h3>
      ${r.reasons.length ? `<div>${esc(r.summary)}</div>` : '<div>Существенных факторов риска по введённым данным не найдено.</div>'}
      ${r.recommendations.length ? `<div style="margin-top:8px"><b>Рекомендуется:</b><ul>${r.recommendations.slice(0, 6).map(x => `<li>${esc(x)}</li>`).join('')}</ul></div>` : ''}
      ${r.reasons.length > 3 ? `<details style="margin-top:6px"><summary style="cursor:pointer">Все причины (${r.reasons.length})</summary><ul>${r.reasons.map(x => `<li>${esc(x)}</li>`).join('')}</ul></details>` : ''}
      <div class="muted-p" style="font-size:12px;margin-top:8px">${t('riskNote')}</div></div>`;
  }
  function summaryHtml(d, view) {
    const e = d.equipment, comm = [e.mobile && 'мобильная', e.satellite && 'спутниковая', e.radio && 'рация'].filter(Boolean), h = durationHours(d), nights = nightsBetween(d.schedule.startDate, d.schedule.returnDate);
    const route = [d.route.start && d.route.start.name, ...d.route.waypoints.map(w => w.name), d.route.end && d.route.end.name].filter(Boolean).join(' → ');
    const ed = s => view ? '' : ` <button type="button" class="btn btn-sm" data-action="twGo" data-n="${s}" style="margin-left:6px">${t('edit')}</button>`;
    return `<div class="card"><div class="tw-sum">
      <span>Маршрут${ed(1)}</span><b>${esc(route || '—')}${d.route.distanceKm ? ` · ${d.route.distanceKm} км` : ''} · ${esc(t('types')[d.routeType] || '')}</b>
      <span>Дата${ed(2)}</span><b>${ruDate(d.schedule.startDate)} ${esc(d.schedule.startTime || '')} — ${ruDate(d.schedule.returnDate)} ${esc(d.schedule.returnTime || '')}</b>
      <span>Продолжительность</span><b>${durText(h)}</b>
      <span>Ночевки</span><b>${nights}${d.overnights.filter(o => o.name).length ? ': ' + esc(d.overnights.filter(o => o.name).map(o => o.name).join(', ')) : ''}</b>
      <span>Участники${ed(3)}</span><b>${count(d)} ${plural(count(d), 'человек', 'человека', 'человек')}</b>
      <span>Ответственный</span><b>${esc(fio(d.leader) || '—')}${d.leader.phone ? ', ' + esc(d.leader.phone) : ''}</b>
      <span>Связь${ed(4)}</span><b>${comm.length ? esc(comm.join(' + ')) : '<span style="color:#fca5a5">нет</span>'}</b>
      <span>GPS</span><b>${e.gps ? 'Да' : '<span style="color:#fca5a5">Нет</span>'}</b>
      <span>Аптечка</span><b>${e.firstAid ? 'Да' : '<span style="color:#fca5a5">Нет</span>'}</b>
      ${d.hazards.length ? `<span>Опасные участки</span><b>${esc(d.hazards.map(h => E.TripRisk.HAZARDS[h].ru).join(', '))}</b>` : ''}
    </div></div>`;
  }
  function wizardHtml() {
    if (!Remote.active) return `${pageHead('🎒 ' + t('title'))}<div class="card col"><b>${t('loginNeeded')}</b><button class="btn btn-primary" data-action="authTourist" style="min-height:52px">Войти</button><button class="btn" data-action="authRegister">Регистрация</button></div>`;
    const n = TW.step, total = 6;
    return `<div class="tw" id="tw"><div class="tw-prog" role="progressbar" aria-valuemin="1" aria-valuemax="${total}" aria-valuenow="${n}" aria-label="${t('step', { n, total })}">
      <div><b>${t('step', { n, total })}</b><span class="tw-sn">${esc(t('steps')[n - 1])}</span></div><div class="tw-bar"><i style="width:${Math.round(n / total * 100)}%"></i></div></div>
      <div id="tw-body">${stepHtml(n)}</div>
      <div class="tw-nav">${n > 1 ? `<button type="button" class="btn" data-action="twBack">← ${t('back')}</button>` : `<a class="btn" href="#/trips">← ${t('back')}</a>`}
      <button type="button" class="btn btn-primary" data-action="twNext" ${TW.busy ? 'disabled' : ''}>${TW.busy ? t('saving') : n === 6 ? t('create') : t('next') + ' →'}</button></div></div>`;
  }

  /* ввод: значения сразу пишутся в состояние (ничего не теряется при переходах между шагами) */
  function bindInputs() {
    const root = $('#tw'); if (!root) return;
    root.addEventListener('input', e => {
      const el = e.target, k = el.dataset && el.dataset.tw; if (!k) return; const d = TW.d, v = el.value;
      const m = /^(pLast|pFirst|pMiddle|pPhone|nName|nArr|nLeave)(\d+)$/.exec(k);
      if (m) { const i = +m[2], P = { pLast: 'lastName', pFirst: 'firstName', pMiddle: 'middleName', pPhone: 'phone' }; if (P[m[1]]) d.participants[i][P[m[1]]] = v; else d.overnights[i][{ nName: 'name', nArr: 'arriveDate', nLeave: 'leaveDate' }[m[1]]] = v; return; }
      const map = { name: () => { d.name = v; }, routeDesc: () => { d.route.description = v; }, distance: () => { d.route.distanceKm = v === '' ? null : +v; },
        lLast: () => { d.leader.lastName = v; }, lFirst: () => { d.leader.firstName = v; }, lMiddle: () => { d.leader.middleName = v; }, lPhone: () => { d.leader.phone = v; },
        startDate: () => { d.schedule.startDate = v; }, startTime: () => { d.schedule.startTime = v; }, returnDate: () => { d.schedule.returnDate = v; }, returnTime: () => { d.schedule.returnTime = v; } };
      if (map[k]) map[k]();
      if (['startDate', 'startTime', 'returnDate', 'returnTime'].includes(k)) {
        const du = $('#tw-dur'), ni = $('#tw-nights'); if (du) du.textContent = durText(durationHours(d));
        const before = TW.nightsShown, now = nightsBetween(d.schedule.startDate, d.schedule.returnDate); if (ni) ni.textContent = now;
        if ((before >= 1) !== (now >= 1)) paint(); TW.nightsShown = now;
      }
    });
    root.addEventListener('change', e => {
      const sk = e.target.dataset && e.target.dataset.twsel; if (sk) { const m2 = /^(nArr|nLeave)(\d+)$/.exec(sk); if (m2) TW.d.overnights[+m2[2]][m2[1] === 'nArr' ? 'arriveDate' : 'leaveDate'] = e.target.value; return; }
      const el = e.target, k = el.dataset && el.dataset.twck; if (!k) return; const d = TW.d, on = el.checked;
      if (k.startsWith('eq_')) { d.equipment[k.slice(3)] = on; const rb = $('#tw-riskbox'); if (rb) rb.innerHTML = riskHtml(riskOf(d)); return; }
      if (k.startsWith('c_')) { d.confirmations[k.slice(2)] = on; return; }
      if (k === 'leaderConsent') { d.leader.consent = on; return; }
      const m = /^pc(\d+)$/.exec(k); if (m) d.participants[+m[1]].consent = on;
    });
  }
  function paint() {
    const main = $('#c-main'); if (!main || (TouristView.seg[0] !== 'trip')) return;
    const y = window.scrollY; main.innerHTML = TouristView.v_trip(TouristView.seg); bindInputs(); TW.nightsShown = nightsBetween(TW.d.schedule.startDate, TW.d.schedule.returnDate);
    if (TW.keepScroll) window.scrollTo(0, y); TW.keepScroll = false;
  }
  const focusFirstError = () => setTimeout(() => { const e = document.querySelector('.tw-err'); if (e) { const f = e.parentElement.querySelector('input,textarea') || e; e.scrollIntoView({ block: 'center' }); if (f.focus) f.focus({ preventScroll: true }); } }, 30);

  /* сохранение черновика на сервере после каждого шага (если пользователь вошёл) */
  async function saveDraft() {
    if (!Remote.active) return;
    try {
      if (TW.id) await Remote.patch('/trips/' + TW.id, body(TW.d));
      else { const r = await Remote.post('/trips', body(TW.d, { draft: true })); TW.id = r.trip.id; }
    } catch (e) { if (e.status === 422 && e.details) { TW.errs._server = Remote.errText(e); } /* черновик — не критично: данные остаются во вкладке */ }
  }
  async function loadConsent() { if (TW.consent) return; try { TW.consent = (await Remote.get('/consent/trip_pd', { noAuth: true })).consent; const el = $('#tw-ctext'); if (el) el.innerHTML = consentHtml(TW.consent); } catch (e) { /* ignore */ } }

  /* прогноз погоды для оценки риска (Open-Meteo, только если даты в пределах 14 дней и есть координаты конечной точки) */
  async function loadWeather() {
    const d = TW.d, p = d.route.end; if (!p || p.lat == null || !d.schedule.startDate || !d.schedule.returnDate) return;
    const days = (new Date(d.schedule.startDate) - Date.now()) / 86400e3; if (days > 14 || days < -1) { d.weather = null; return; }
    const key = [p.lat, p.lon, d.schedule.startDate, d.schedule.returnDate].join(); if (TW.weatherKey === key) return; TW.weatherKey = key;
    try {
      const u = `https://api.open-meteo.com/v1/forecast?latitude=${(+p.lat).toFixed(4)}&longitude=${(+p.lon).toFixed(4)}&daily=temperature_2m_min,precipitation_sum,wind_speed_10m_max,weather_code&timezone=auto&start_date=${d.schedule.startDate}&end_date=${d.schedule.returnDate}`;
      const j = await (await fetch(u, { referrerPolicy: 'no-referrer' })).json(); const D = j.daily; if (!D || !D.time) return;
      d.weather = { maxWindKmh: Math.max(...D.wind_speed_10m_max), precipMm: Math.max(...D.precipitation_sum), minTempC: Math.min(...D.temperature_2m_min), thunder: D.weather_code.some(c => c >= 95) };
      const rb = $('#tw-riskbox'); if (rb) rb.innerHTML = riskHtml(riskOf(d));
    } catch (e) { /* без прогноза оценка честно не учитывает погоду */ }
  }

  /* ═════════════ авто-определение по маршруту: тип, протяжённость (км и дни), сложность, удалённость, опасные участки ═════════════ */
  const AUTO_KEYS = ['routeType', 'difficulty', 'remoteness', 'hazards'];
  function autoHtml() {
    const d = TW.d, ins = d.insight;
    if (TW.autoBusy) return '<div class="card"><div class="spinner"></div> Строим маршрут по тропам OpenStreetMap и считаем длину, время и опасные участки…</div>';
    const chipsBlock = `<div class="field"><label>${t('routeType')} ${d.manual.routeType ? '' : '<span class="mx-badge real">авто</span>'}</label>${chips('routeType', Object.entries(t('types')), d.routeType)}</div>
      <div class="field"><label>${t('difficulty')} ${d.manual.difficulty ? '' : ins ? '<span class="mx-badge real">авто</span>' : ''}</label>${chips('difficulty', Object.entries(t('diffs')), d.difficulty)}</div>
      <div class="field"><label>${t('remoteness')} ${d.manual.remoteness ? '' : ins ? '<span class="mx-badge real">авто</span>' : ''}</label>${chips('remoteness', Object.entries(t('remotes')), d.remoteness)}</div>
      <div class="field"><label>${t('hazards')} ${d.manual.hazards ? '' : ins ? '<span class="mx-badge real">авто</span>' : ''}</label>${chips('hazards', HAZ, d.hazards, true)}
      ${ins && ins.hazards.length ? `<div class="muted-p" style="font-size:13px;margin-top:6px">${ins.hazards.map(h => '• ' + esc(E.TripRisk.HAZARDS[h].ru) + ': ' + esc(ins.hazardWhy[h] || '')).join('<br>')}</div>` : ''}</div>`;
    if (!ins) return `<div class="card col" style="gap:10px">${TW.autoErr ? `<div class="warnbox">Не удалось построить маршрут по тропам: ${esc(TW.autoErr)}. Укажите протяжённость вручную.</div>` : '<div class="muted-p">Выберите начальную и конечную точки (или готовый маршрут) — длину, время в днях, тип, сложность, удалённость и опасные участки посчитаем сами.</div>'}
      ${fld(t('distance'), 'distance', d.route.distanceKm ?? '', { type: 'number', attr: 'min="0" max="2000" step="0.1" inputmode="decimal"' })}${chipsBlock}</div>`;
    return `<div class="card col" style="gap:10px"><b>📐 Определено по маршруту</b>${X.insightHtml(ins)}<div class="muted-p" style="font-size:13px">Значения ниже подставлены автоматически — их можно изменить.</div>${chipsBlock}</div>`;
  }
  const paintAuto = () => { const el = $('#tw-auto'); if (el) el.innerHTML = autoHtml(); };
  function applyInsight(ins) {
    const d = TW.d; d.insight = ins; if (!ins) return;
    d.route.distanceKm = ins.distanceKm;
    if (!d.manual.routeType) d.routeType = ins.type;
    if (!d.manual.difficulty && ins.difficulty) d.difficulty = ins.difficulty;
    if (!d.manual.remoteness && ins.remoteness) d.remoteness = ins.remoteness;
    if (!d.manual.hazards) d.hazards = ins.hazards.slice();
  }
  const monthOf = d => d.schedule.startDate ? +d.schedule.startDate.slice(5, 7) : null;
  let autoSeq = 0;
  async function autoDetect() {
    const d = TW.d, seq = ++autoSeq; TW.autoErr = '';
    try {
      let model = null;
      if (d.routeSel) {
        const e = d.routeSel.entry;
        if (e.geometryStatus === 'available') { model = TW.models[e.id] || await X.RouteStore.model(e); TW.models[e.id] = model; }
        else { if (seq === autoSeq) { applyInsight(e.insight ? E.RouteInsight.analyze({ name: e.name, difficulty: e.difficulty, landmark: e.landmark, declared: e.declared }, { month: monthOf(d) }) : null); paintAuto(); } return; }
      } else if (d.route.start && d.route.start.lat != null && d.route.end && d.route.end.lat != null) {
        TW.autoBusy = true; paintAuto();
        const via = d.route.waypoints.filter(w => w && w.lat != null).map(w => ({ lat: w.lat, lon: w.lon }));
        const b = { from: { lat: d.route.start.lat, lon: d.route.start.lon }, to: { lat: d.route.end.lat, lon: d.route.end.lon } }; if (via.length) b.via = via;
        model = (await Remote.post('/routing/foot', b, { noAuth: !Remote.active })).route;
        model.name = d.route.start.name + ' → ' + d.route.end.name;
      } else { if (seq === autoSeq) { d.insight = null; paintAuto(); } return; }
      if (seq !== autoSeq) return;
      applyInsight(E.RouteInsight.analyze(Object.assign({}, model, { name: model.name || (d.routeSel && d.routeSel.name), difficulty: d.routeSel ? d.routeSel.entry.difficulty : null }), { month: monthOf(d) }));
    } catch (e) { if (seq === autoSeq) { TW.autoErr = Remote.errText(e); d.insight = null; } }
    if (seq === autoSeq) { TW.autoBusy = false; paintAuto(); }
  }
  X.TripAuto = autoDetect;

  /* готовые маршруты каталога: выбор целиком (старт, финиш, промежуточные — из трека) */
  async function routeList() {
    if (!X.RouteStore.list) await X.RouteStore.load().catch(() => {});
    const list = (X.RouteStore.list || []).filter(r => r.server && !r.demo && r.insight);
    Modal.open({ id: 'twroutes', title: '📚 Маршруты «Горы Алматы»', body: `<div class="col" style="gap:8px">${list.length ? list.map(r => `<div class="card" style="padding:12px"><div class="row sp"><b>${esc(r.name)}</b>${r.geometryStatus === 'available' ? '<span class="mx-badge real">трек</span>' : '<span class="mx-badge warn">без трека</span>'}</div>
      <div class="muted-p" style="font-size:13px">${X.km(r.insight.distanceKm)} · +${r.insight.gainM} м · ~${r.insight.totalHours} ч · ${r.insight.days} ${plural(r.insight.days, 'день', 'дня', 'дней')} · сложных участков: ${r.insight.fromGeometry ? r.insight.difficultCount : '—'}</div>
      <button class="btn btn-sm btn-primary" data-action="twRouteSel" data-id="${esc(r.id)}" style="margin-top:6px">Выбрать</button></div>`).join('') : '<div class="muted-p">Маршруты не загрузились. Проверьте связь.</div>'}</div>` });
  }
  async function selectRoute(id) {
    const e = (X.RouteStore.list || []).find(r => r.id === id); if (!e) return; Modal.closeAll();
    const d = TW.d; d.routeSel = { id: e.id, name: e.name, entry: e }; d.manual = {};
    if (!d.name) d.name = e.name;
