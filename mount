    if (cur && cur !== App.state.rChat) App.state.rChat = cur;
    return `${pageHead('Чат')}${cs.length ? `<div class="grid g2" style="grid-template-columns:minmax(200px,280px) 1fr;align-items:start"><div class="col">${cs.map(c => `<button class="member" style="text-align:left;${c.actor.id === cur ? 'box-shadow:var(--shadow-md)' : ''}" data-action="rChatWith" data-id="${c.actor.id}"><span class="avatar">${esc(initials(c.actor.name))}</span><span class="nm">${esc(c.actor.name)}<br><small class="muted">${esc(c.actor.tag)}</small></span>${c.dispUnread ? `<i class="dot-badge">${c.dispUnread}</i>` : ''}</button>`).join('')}</div><div>${cur ? Chat.html(cur, 'disp') : ''}</div></div>` : '<div class="empty"><h3>Обращений в чат пока нет</h3></div>'}`;
  },
};


/* ════════════════════════════════════════════════════════════════
   9. GEO — реальная геолокация, история пути, карта, SOS, офлайн, DEMO MODE
   ────────────────────────────────────────────────────────────────
   Здесь НЕТ выдуманных координат. Позиция берётся только из navigator.geolocation.
   Заранее заготовленные точки используются исключительно в явно помеченном DEMO MODE.
   Места подключения настоящего backend помечены «BACKEND».
   ════════════════════════════════════════════════════════════════ */
const GeoCfg = {
  high: { enableHighAccuracy: true, timeout: 15000, maximumAge: 5000 },     // GPS высокой точности
  fallback: { enableHighAccuracy: false, timeout: 20000, maximumAge: 30000 },// запасной вариант: по сети/Wi-Fi (менее точный)
  lowAccuracyM: 100,          // от этого значения точность считается низкой
  freshSingleMs: 120000,      // одиночный фикс «свежий» 2 минуты
  freshWatchMs: 300000,       // при отслеживании: 5 минут (watch не шлёт события, пока вы стоите)
  retainDays: 7, maxPoints: 5000, minMoveM: 5, minIntervalMs: 30000,
  emergencyApi: '',           // BACKEND: адрес API спасателей, например 'https://api.example.kz/v1/emergency'
  trackApi: '',               // BACKEND: адрес API для синхронизации сохранённого пути
};
const tms = ts => new Date(ts).toLocaleTimeString('ru-RU', { hour12: false });
const OSM_TILE = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';   /* OSM требует Referer — поэтому referrer-политика strict-origin-when-cross-origin */
const TILE_CACHE = 'ms-tiles-v2';

/* ── постоянное состояние устройства (localStorage): последняя позиция, SOS, режим DEMO ── */
const GeoStore = {
  KEY: 'ms_geo_v1',
  d: { last: null, demo: false, sos: { level: 'normal', ts: 0, id: null, payload: null }, packTs: 0 },
  load() { try { const j = JSON.parse(Local.get(this.KEY) || '{}'); Object.assign(this.d, j); } catch (e) { /* повреждённые данные: начинаем с нуля */ } },
  save() { Local.set(this.KEY, JSON.stringify(this.d)); },
};

/* ── IndexedDB: история пути и очередь синхронизации. Если IndexedDB недоступна, работаем в памяти ── */
const Hist = {
  db: null, mem: { track: [], outbox: [], kv: {} }, idb: false, seq: 1,
  open() {
    return new Promise(res => {
      try {
        const rq = indexedDB.open('mountainsafe', 1);
        rq.onupgradeneeded = () => { const d = rq.result; d.createObjectStore('track', { keyPath: 'id', autoIncrement: true }).createIndex('ts', 'ts'); d.createObjectStore('outbox', { keyPath: 'id' }); d.createObjectStore('kv', { keyPath: 'k' }); };
        rq.onsuccess = () => { this.db = rq.result; this.idb = true; res(true); };
        rq.onerror = () => res(false); rq.onblocked = () => res(false);
      } catch (e) { res(false); }
    });
  },
  op(store, mode, fn) {
    return new Promise(res => { try { const t = this.db.transaction(store, mode), s = t.objectStore(store), r = fn(s); t.oncomplete = () => res(r && 'result' in r ? r.result : undefined); t.onerror = t.onabort = () => res(undefined); } catch (e) { res(undefined); } });
  },
  async addPoint(p) { if (this.idb) await this.op('track', 'readwrite', s => s.add(p)); else this.mem.track.push({ ...p, id: this.seq++ }); },
  async points(mode) { const all = this.idb ? (await this.op('track', 'readonly', s => s.getAll())) || [] : this.mem.track.slice(); return all.filter(p => p.mode === mode).sort((a, b) => a.ts - b.ts); },
  async clearPoints(mode) {
    if (this.idb) { const all = (await this.op('track', 'readonly', s => s.getAll())) || []; await this.op('track', 'readwrite', s => { all.filter(p => p.mode === mode).forEach(p => s.delete(p.id)); }); }
    else this.mem.track = this.mem.track.filter(p => p.mode !== mode);
  },
  /* ретеншн: не храним координаты бесконечно */
  async prune() {
    const cut = Date.now() - GeoCfg.retainDays * 864e5, all = await this.points('real'), dropOld = all.filter(p => p.ts < cut), extra = Math.max(0, all.length - dropOld.length - GeoCfg.maxPoints);
    const del = [...dropOld, ...all.filter(p => p.ts >= cut).slice(0, extra)]; if (!del.length) return;
    if (this.idb) await this.op('track', 'readwrite', s => { del.forEach(p => s.delete(p.id)); }); else this.mem.track = this.mem.track.filter(p => !del.some(d => d.id === p.id));
  },
  async outboxAdd(x) { if (this.idb) await this.op('outbox', 'readwrite', s => s.put(x)); else this.mem.outbox.push(x); },
  async outboxAll() { return this.idb ? (await this.op('outbox', 'readonly', s => s.getAll())) || [] : this.mem.outbox.slice(); },
  async kvSet(k, v) { if (this.idb) await this.op('kv', 'readwrite', s => s.put({ k, v })); else this.mem.kv[k] = v; },
  async kvGet(k) { if (this.idb) { const r = await this.op('kv', 'readonly', s => s.get(k)); return r ? r.v : undefined; } return this.mem.kv[k]; },
};

/* ── DEMO MODE: заготовленный вымышленный маршрут. Используется ТОЛЬКО когда включён переключатель DEMO MODE ── */
const DEMO_WAYPOINTS = [
  { k: 'START', lat: 43.0512, lon: 76.9781, acc: 7 },
  { k: 'POINT 1', lat: 43.0538, lon: 76.9812, acc: 9 },
  { k: 'POINT 2', lat: 43.0571, lon: 76.9849, acc: 11 },
  { k: 'DANGER ZONE', lat: 43.0603, lon: 76.9893, acc: 130 },   // намеренно плохая точность: показывает предупреждение
  { k: 'SOS', lat: 43.0611, lon: 76.9905, acc: 14 },
];
const DEMO_PATH = (() => { const o = []; for (let i = 0; i < DEMO_WAYPOINTS.length; i++) { const a = DEMO_WAYPOINTS[i], b = DEMO_WAYPOINTS[i + 1]; o.push({ ...a, wp: i }); if (b) for (let s = 1; s < 4; s++) { const t = s / 4; o.push({ k: '', lat: a.lat + (b.lat - a.lat) * t, lon: a.lon + (b.lon - a.lon) * t, acc: Math.round(a.acc + (b.acc - a.acc) * t), wp: i }); } } return o; })();

/* ── причины ошибок → человеческие тексты и следующий шаг ── */
const GEO_PROBLEMS = {
  unsupported: { title: 'Геолокация не поддерживается', text: 'Этот браузер не умеет определять местоположение.', next: 'Откройте сайт в актуальном Chrome, Safari или Firefox. Для показа без GPS включите DEMO MODE.' },
  insecure: { title: 'Нужно защищённое соединение', text: 'Для определения местоположения требуется защищённое HTTPS-соединение.', next: 'Откройте сайт по адресу https:// (или localhost при разработке).' },
  1: { title: 'Доступ к геолокации запрещён', text: 'Вы (или браузер) запретили сайту узнавать местоположение.', next: 'Нажмите на значок замка рядом с адресом, разрешите «Местоположение» и нажмите «Обновить». Если данные есть, ниже показана последняя известная позиция.' },
  2: { title: 'Позиция временно недоступна', text: 'Устройство не смогло определить местоположение.', next: 'Включите геолокацию в настройках телефона, выйдите на открытое место и нажмите «Обновить».' },
  3: { title: 'Время ожидания истекло', text: 'GPS не ответил вовремя. В помещении, ущелье или под густой кроной это бывает.', next: 'Выйдите на открытое место, подождите полминуты и нажмите «Обновить».' },
  demo: { title: 'DEMO MODE', text: 'Сейчас используется симуляция, а не GPS вашего устройства.', next: 'Выключите DEMO MODE, чтобы определить настоящее местоположение.' },
};

/* ── ядро геолокации ── */
const GeoSvc = {
  st: { pending: false, error: null, watching: false, watchId: null, real: null, demoFix: null, perm: 'unknown', trackN: 0, demoIdx: -1, demoTimer: null, lastStored: null, connLostAt: 0, restoredAt: 0 },
  supported: () => 'geolocation' in navigator && !!navigator.geolocation,
  secure: () => window.isSecureContext !== false,
  demo: () => !!GeoStore.d.demo,
  mode: () => GeoStore.d.demo ? 'demo' : 'real',
  cur() { return this.demo() ? this.st.demoFix : this.st.real; },              // текущая позиция в активном режиме
  async init() {
    GeoStore.load(); this.st.real = GeoStore.d.last;
    await Hist.open(); await Hist.prune(); await this.refreshCount();
    try { if (navigator.permissions && navigator.permissions.query) { const r = await navigator.permissions.query({ name: 'geolocation' }); this.st.perm = r.state; r.onchange = () => { this.st.perm = r.state; Bus.emit('geo'); }; } } catch (e) { /* не везде поддерживается */ }
    Bus.emit('geo');
  },
  async refreshCount() { this.st.trackN = (await Hist.points(this.mode())).length; },
  problem() { if (this.demo()) return null; if (!this.supported()) return GEO_PROBLEMS.unsupported; if (!this.secure()) return GEO_PROBLEMS.insecure; return null; },
  ageMs() { const f = this.cur(); return f ? Date.now() - f.ts : Infinity; },
  fresh() { return this.ageMs() <= (this.st.watching || this.demo() ? GeoCfg.freshWatchMs : GeoCfg.freshSingleMs); },
  /* статус GPS не зависит от интернета */
  status() {
    if (this.demo()) return { k: 'demo', c: 'demo', t: 'DEMO MODE', d: 'симуляция, не GPS' };
    const f = this.cur();
    if (this.st.pending && !this.fresh()) return { k: 'search', c: 'warn', t: 'SEARCHING', d: 'определяем местоположение…' };
    if (f && this.fresh()) return { k: 'active', c: 'ok', t: 'GPS ACTIVE', d: 'GPS найден' };
    if (this.st.error && !f) return { k: 'unavail', c: 'crit', t: 'UNAVAILABLE', d: 'местоположение недоступно' };
    if (this.st.error) return { k: 'unavail', c: 'crit', t: 'UNAVAILABLE', d: 'есть только последняя известная позиция' };
    if (f) return { k: 'stale', c: 'warn', t: 'LAST FIX', d: 'позиция устарела: ' + this.agoText(f.ts) };
    return { k: 'idle', c: 'off', t: 'GPS IDLE', d: 'ещё не запрашивался' };
  },
  agoText(ts) { const s = Math.max(0, Math.round((Date.now() - ts) / 1000)); return s < 60 ? s + ' с назад' : s < 3600 ? Math.round(s / 60) + ' мин назад' : Math.round(s / 3600) + ' ч назад'; },
  accInfo(acc) {
    if (acc == null) return { c: 'off', t: 'нет данных' };
    if (acc <= 20) return { c: 'ok', t: 'высокая' }; if (acc <= 50) return { c: 'ok', t: 'хорошая' }; if (acc < GeoCfg.lowAccuracyM) return { c: 'warn', t: 'средняя' };
    return { c: 'crit', t: 'низкая', low: true };
  },
  fmt(f) { return f ? `${f.lat.toFixed(6)}, ${f.lon.toFixed(6)}` : ''; },
  whereText() { const f = this.cur(); return f ? this.fmt(f) + (f.src === 'demo' ? ' (ДЕМО)' : '') : ''; },
  mapLinks(f) { return f ? { osm: `https://www.openstreetmap.org/?mlat=${f.lat}&mlon=${f.lon}#map=17/${f.lat}/${f.lon}`, google: `https://www.google.com/maps?q=${f.lat},${f.lon}`, geo: `geo:${f.lat},${f.lon}` } : null; },

  /* ---- разовое определение: getCurrentPosition ---- */
  getPos(opts) {
    return new Promise((ok, bad) => {
      let done = false; const t = setTimeout(() => { if (!done) { done = true; bad({ code: 3, message: 'timeout' }); } }, opts.timeout + 2500);   // страховка: часть браузеров не вызывает error
      navigator.geolocation.getCurrentPosition(p => { if (!done) { done = true; clearTimeout(t); ok(p); } }, e => { if (!done) { done = true; clearTimeout(t); bad(e); } }, opts);
    });
  },
  async requestOnce(o = {}) {
    if (this.demo()) { if (!this.st.demoFix) this.demoGoto(0); else Bus.emit('geo'); return this.st.demoFix; }
    const pr = this.problem(); if (pr) { this.st.error = pr === GEO_PROBLEMS.insecure ? 'insecure' : 'unsupported'; Bus.emit('geo'); return null; }
    if (this.st.pending) return this.cur();
    this.st.pending = true; this.st.error = null; Bus.emit('geo');
    try {
      let pos;
      try { pos = await this.getPos(o.opts || GeoCfg.high); }
      catch (e) { if (e && e.code === 3 && !(o.opts && !o.opts.enableHighAccuracy)) { if (!o.silent) Toast.show('GPS не ответил. Пробую определить позицию менее точным способом', { icon: '📍' }); pos = await this.getPos(GeoCfg.fallback); } else throw e; }
      return this.accept(pos);
    } catch (e) { this.fail(e); return null; }
    finally { this.st.pending = false; Bus.emit('geo'); }
  },
  accept(pos) {
    const c = pos.coords, fix = { lat: c.latitude, lon: c.longitude, acc: Math.round(c.accuracy || 0), alt: c.altitude != null ? Math.round(c.altitude) : null, speed: c.speed, heading: c.heading, ts: pos.timestamp || Date.now(), src: 'gps' };
    this.st.error = null; this.st.real = fix; GeoStore.d.last = fix; GeoStore.save();
    Prefs.set(P => { P.gps = { lat: fix.lat, lon: fix.lon, acc: fix.acc, ts: fix.ts }; P.card.coords = this.fmt(fix); P.card.coordsAt = fix.ts; });   // для погоды, карточки и Stress Mode
    if (this.st.watching) this.record(fix, 'real');
    Bus.emit('geo'); return fix;
  },
  fail(e) {
    const code = e && [1, 2, 3].includes(e.code) ? e.code : 2; this.st.error = code; Bus.emit('geo');
    if (code === 1) this.stopTracking(true);
  },
  problemNow() {
    const p = this.problem(); if (p) return p;
    if (this.st.error && GEO_PROBLEMS[this.st.error]) return GEO_PROBLEMS[this.st.error];
    return null;
  },

  /* ---- постоянное отслеживание: watchPosition / clearWatch ---- */
  startTracking() {
    if (this.demo()) return false;
    const pr = this.problem(); if (pr) { Toast.show(pr.text, { icon: '📍' }); return false; }
    if (this.st.watching) return true;
    try {
      this.st.watchId = navigator.geolocation.watchPosition(p => { this.st.pending = false; this.accept(p); }, e => {
        if (e.code === 1) { this.fail(e); Toast.show(GEO_PROBLEMS[1].title, { icon: '📍' }); }      // доступ отозван: watcher останавливаем
        else { this.st.error = e.code; Bus.emit('geo'); }                                              // временные сбои: продолжаем слушать
      }, GeoCfg.high);
      this.st.watching = true; this.st.pending = !this.fresh(); this.st.error = null; Bus.emit('geo'); return true;
    } catch (e) { this.fail(e); return false; }
  },
  stopTracking(silent) {
    if (this.st.watchId != null) { try { navigator.geolocation.clearWatch(this.st.watchId); } catch (e) { /* ignore */ } }
    const was = this.st.watching; this.st.watchId = null; this.st.watching = false; this.st.pending = false; Bus.emit('geo');
    if (was && !silent) Toast.show('Отслеживание остановлено', { icon: '⏹' });
  },
  async record(fix, mode) {
    const l = this.st.lastStored;
    if (l && l.mode === mode) { const d = haversine([l.lat, l.lon], [fix.lat, fix.lon]); if (d < Math.max(GeoCfg.minMoveM, fix.acc * .5) && fix.ts - l.ts < GeoCfg.minIntervalMs) return; }
    const p = { ts: fix.ts, lat: fix.lat, lon: fix.lon, acc: fix.acc, mode }; this.st.lastStored = p;
    await Hist.addPoint(p); this.st.trackN++; Bus.emit('track', p);
    if (this.st.trackN % 200 === 0) Hist.prune();
  },
  async stats() {
    const pts = await Hist.points(this.mode()); let d = 0; for (let i = 1; i < pts.length; i++) { if (pts[i].acc > 200 || pts[i - 1].acc > 200) continue; d += haversine([pts[i - 1].lat, pts[i - 1].lon], [pts[i].lat, pts[i].lon]); }
    return { n: pts.length, dist: d, from: pts[0] ? pts[0].ts : 0, to: pts.length ? pts[pts.length - 1].ts : 0, pts };
  },
  async clearHistory() { await Hist.clearPoints(this.mode()); this.st.trackN = 0; this.st.lastStored = null; Bus.emit('track'); Bus.emit('geo'); },
  async exportGpx() {
    const pts = await Hist.points(this.mode()); if (!pts.length) return false;
    const x = `<?xml version="1.0" encoding="UTF-8"?>\n<gpx version="1.1" creator="Mountain Safe" xmlns="http://www.topografix.com/GPX/1/1"><trk><name>Mountain Safe ${this.demo() ? 'DEMO ' : ''}${new Date().toISOString().slice(0, 10)}</name><trkseg>${pts.map(p => `<trkpt lat="${p.lat}" lon="${p.lon}"><time>${new Date(p.ts).toISOString()}</time></trkpt>`).join('')}</trkseg></trk></gpx>`;
    const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([x], { type: 'application/gpx+xml' })); a.download = 'mountain-safe-track.gpx'; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000); return true;
  },

  /* ---- DEMO MODE ---- */
  setDemo(on) {
    if (on === this.demo()) return;
    this.stopTracking(true); this.demoStop(); GeoStore.d.demo = !!on; GeoStore.save(); this.st.demoFix = null; this.st.demoIdx = -1; this.st.lastStored = null; this.st.error = null;
    this.refreshCount().then(() => Bus.emit('geo')); Bus.emit('geo');
