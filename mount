const shrinkImage = (file, max = 320, q = 0.8) => new Promise((ok, bad) => {
  const img = new Image(), u = URL.createObjectURL(file);
  img.onload = () => { const k = Math.min(1, max / Math.max(img.width, img.height)), c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k); c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(u); let out = c.toDataURL('image/jpeg', q); if (out.length > 260000) out = c.toDataURL('image/jpeg', 0.5); ok(out); };
  img.onerror = () => { URL.revokeObjectURL(u); bad(new Error('Не удалось прочитать изображение')); }; img.src = u;
});

