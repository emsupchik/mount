  const t = GeoSvc.fmt(f);
  try { await navigator.clipboard.writeText(t); Toast.show('✓ Координаты скопированы', { icon: '📋' }); }
  catch (e) { try { const ta = document.createElement('textarea'); ta.value = t; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); const ok = document.execCommand('copy'); ta.remove(); Toast.show(ok ? '✓ Координаты скопированы' : 'Не удалось скопировать. Координаты: ' + t, { icon: '📋', duration: 6000 }); } catch (e2) { Toast.show('Не удалось скопировать. Координаты: ' + t, { icon: '📋', duration: 6000 }); } }
}
