'use strict';
const { v } = require('../lib/validate');
const { E } = require('../lib/errors');

module.exports = (r, S) => {
  const { auth, cfg } = S;
  const email = v.email(), pw = v.password();
  const RT = 'ms_rt';
  const setRefresh = (ctx, token, expires) => ctx.setCookie(RT, token, { httpOnly: true, secure: cfg.cookieSecure, sameSite: 'Strict', path: '/api/v1/auth', expires: new Date(expires) });
  const clearRefresh = ctx => ctx.setCookie(RT, '', { httpOnly: true, secure: cfg.cookieSecure, sameSite: 'Strict', path: '/api/v1/auth', maxAge: 0 });
  const tokens = s => ({ accessToken: s.access, expiresIn: cfg.accessTtlSec, sessionId: s.sessionId, user: s.user });

  r.post('/api/v1/auth/register', { auth: 'none', rate: [{ name: 'register', max: 10, windowMs: 3600e3 }], body: v.obj({ email, password: pw, fullName: v.str({ min: 1, max: 80 }), phone: v.phone().optional() }) }, async ctx => {
    if ((await S.admin.setting('registration_open', true)) === false) throw E.forbidden('Регистрация временно закрыта');
    const c = await auth.registerFull(ctx, ctx.body);
    const s = await auth.startSession(c.u, ctx);
    setRefresh(ctx, s.refresh, s.refreshExpires);
    ctx.status = 201; return tokens(Object.assign(s, { user: auth.publicUser(c.u, c.p) }));
  });
  r.post('/api/v1/auth/login', { auth: 'none', rate: [{ name: 'login', max: 15, windowMs: 10 * 60e3 }], body: v.obj({ email, password: v.rawStr(200) }) }, async ctx => {
    if (S.rate && !S.rate.hit('login-email:' + ctx.body.email, 12, 15 * 60e3).ok) throw E.tooMany(60);
    const s = await auth.login(ctx, ctx.body); setRefresh(ctx, s.refresh, s.refreshExpires); return tokens(s);
  });
  r.post('/api/v1/auth/refresh', { auth: 'none', csrf: true, rate: [{ name: 'refresh', max: 60, windowMs: 60e3 }] }, async ctx => {
    try { const s = await auth.refresh(ctx, ctx.cookies[RT]); setRefresh(ctx, s.refresh, s.refreshExpires); return tokens(s); }
    catch (e) { if (e.status === 401) clearRefresh(ctx); throw e; }
  });
  r.post('/api/v1/auth/logout', { auth: 'optional', csrf: true }, async ctx => { if (ctx.user) await auth.logout(ctx.user.sid); else if (ctx.cookies[RT]) { const C = require('../lib/crypto'); await S.db.query("UPDATE sessions SET revoked_at=now(), revoked_reason='logout' WHERE refresh_hash=$1 AND revoked_at IS NULL", [C.sha256(ctx.cookies[RT])]); } clearRefresh(ctx); return { ok: true }; });
  r.post('/api/v1/auth/logout-all', { csrf: true }, async ctx => { const n = await auth.logoutAll(ctx.user.id); await S.audit.log(ctx, 'auth.logout_all', 'user', ctx.user.id, { revoked: n }); clearRefresh(ctx); return { revoked: n }; });
  r.get('/api/v1/auth/sessions', async ctx => ({ sessions: await auth.listSessions(ctx.user.id, ctx.user.sid) }));
  r.del('/api/v1/auth/sessions/:id', {}, async ctx => { await auth.revokeSession(ctx.user.id, ctx.params.id); return { ok: true }; });
  r.post('/api/v1/auth/verify-email', { auth: 'none', rate: [{ name: 'verify', max: 20, windowMs: 3600e3 }], body: v.obj({ token: v.rawStr(200) }) }, async ctx => { await auth.verifyEmail(ctx.body.token); return { ok: true }; });
  r.post('/api/v1/auth/resend-verification', { rate: [{ name: 'resend', max: 3, windowMs: 3600e3, by: 'user' }] }, async ctx => { if (ctx.user.email_verified_at) return { ok: true, alreadyVerified: true }; await auth.sendVerification(ctx.user); return { ok: true }; });
  r.post('/api/v1/auth/forgot-password', { auth: 'none', rate: [{ name: 'forgot', max: 5, windowMs: 3600e3 }], body: v.obj({ email }) }, async ctx => { await auth.forgotPassword(ctx, ctx.body.email); ctx.status = 202; return { ok: true, message: 'Если такой аккаунт существует, мы отправили письмо со ссылкой' }; });
  r.post('/api/v1/auth/reset-password', { auth: 'none', rate: [{ name: 'reset', max: 10, windowMs: 3600e3 }], body: v.obj({ token: v.rawStr(200), password: pw }) }, async ctx => { await auth.resetPassword(ctx, ctx.body); return { ok: true }; });
  r.post('/api/v1/auth/change-password', { rate: [{ name: 'chpw', max: 10, windowMs: 3600e3, by: 'user' }], body: v.obj({ current: v.rawStr(200), password: pw }) }, async ctx => ({ ok: true, ...(await auth.changePassword(ctx, ctx.body)) }));
  r.post('/api/v1/auth/change-email', { rate: [{ name: 'chem', max: 5, windowMs: 3600e3, by: 'user' }], body: v.obj({ newEmail: email, password: v.rawStr(200) }) }, async ctx => { await auth.requestEmailChange(ctx, ctx.body); ctx.status = 202; return { ok: true, message: 'Письмо отправлено на новый адрес' }; });
  r.post('/api/v1/auth/confirm-email-change', { auth: 'none', rate: [{ name: 'cfem', max: 20, windowMs: 3600e3 }], body: v.obj({ token: v.rawStr(200) }) }, async ctx => { await auth.confirmEmailChange(ctx, ctx.body.token); return { ok: true }; });
  r.post('/api/v1/auth/restore-account', { auth: 'none', rate: [{ name: 'restore', max: 5, windowMs: 3600e3 }], body: v.obj({ email, password: v.rawStr(200) }) }, async ctx => { await auth.restoreAccount(ctx, ctx.body); return { ok: true }; });
  r.get('/api/v1/auth/me', async ctx => { const p = await S.db.one('SELECT * FROM profiles WHERE user_id=$1', [ctx.user.id]); return { user: auth.publicUser(ctx.user, p), sessionId: ctx.user.sid }; });

  /* одноразовый билет для SSE (EventSource не умеет заголовки Authorization) */
  r.post('/api/v1/stream/ticket', { rate: [{ name: 'ticket', max: 30, windowMs: 60e3, by: 'user' }] }, async ctx => { const C = require('../lib/crypto'); return { ticket: C.signJwt({ sub: ctx.user.id, sid: ctx.user.sid, typ: 'sse', jti: C.randomToken(8) }, cfg.jwtSecret, 60) }; });

  /* учётная запись */
  r.del('/api/v1/account', { body: v.obj({ password: v.rawStr(200) }) }, async ctx => auth.deleteAccount(ctx, ctx.body));
  r.get('/api/v1/account/export', { rate: [{ name: 'export', max: 5, windowMs: 3600e3, by: 'user' }] }, async ctx => { const d = await S.exporter.export(ctx.user.id); await S.audit.log(ctx, 'account.exported', 'user', ctx.user.id); ctx.headers['Content-Disposition'] = 'attachment; filename="mountain-safe-export.json"'; return d; });

  /* ── вход/регистрация по номеру телефона (OTP проверяется только на сервере) ── */
  r.get('/api/v1/auth/otp/status', { auth: 'none' }, async () => S.otp.status());
  r.post('/api/v1/auth/otp/send', { auth: 'none', rate: [{ name: 'otpsend', max: 8, windowMs: 10 * 60e3 }], body: v.obj({ phone: v.phone() }, { strict: true }) }, async ctx => S.otp.sendOTP(ctx, ctx.body.phone));
  r.post('/api/v1/auth/otp/verify', { auth: 'none', rate: [{ name: 'otpverify', max: 20, windowMs: 10 * 60e3 }], body: v.obj({ phone: v.phone(), code: v.str({ re: /^\d{4,8}$/, max: 8 }), fullName: v.str({ min: 1, max: 80 }).optional() }, { strict: true }) }, async ctx => {
    if (S.rate && !S.rate.hit('otp-phone:' + ctx.body.phone, 10, 15 * 60e3).ok) throw E.tooMany(120);
    const exists = await S.db.one('SELECT 1 FROM users WHERE phone=$1 AND phone_verified_at IS NOT NULL', [ctx.body.phone]);
    if (!exists && (await S.admin.setting('registration_open', true)) === false) throw E.forbidden('Регистрация временно закрыта');
    const s = await S.otp.verifyOTP(ctx, ctx.body.phone, ctx.body.code);
    setRefresh(ctx, s.refresh, s.refreshExpires); ctx.status = s.created ? 201 : 200; return Object.assign(tokens(s), { created: s.created });
  });

  /* привязка телефона через Twilio Verify (тот же провайдер, что и раньше) */
  r.post('/api/v1/auth/phone/start', { rate: [{ name: 'phstart', max: 3, windowMs: 600e3, by: 'user' }], body: v.obj({ phone: v.phone() }) }, async ctx => { await S.sms.start(ctx.body.phone); return { sent: true }; });
  r.post('/api/v1/auth/phone/check', { rate: [{ name: 'phcheck', max: 6, windowMs: 600e3, by: 'user' }], body: v.obj({ phone: v.phone(), code: v.str({ re: /^\d{4,10}$/, max: 10 }) }) }, async ctx => {
    if (!(await S.sms.check(ctx.body.phone, ctx.body.code))) throw E.badRequest('Неверный или просроченный код');
    try { await S.db.query('UPDATE users SET phone=$2, phone_verified_at=now() WHERE id=$1', [ctx.user.id, ctx.body.phone]); } catch (e) { if (e.code === '23505') throw E.conflict('Этот номер уже привязан к другому аккаунту', 'phone_taken'); throw e; }
    await S.audit.log(ctx, 'auth.phone_verified', 'user', ctx.user.id); return { ok: true };
  });
};


