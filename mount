'use strict';
const { E } = require('../lib/errors');
const { checkPhoto } = require('./profile');
const { haversineM } = require('../lib/geo');

const HAZARD_KINDS = ['trail_closed', 'bridge_damaged', 'hazard', 'landslide'];
const ALERT_TO_CAT = { severe_weather: 'weather', extreme_temperature: 'weather', avalanche: 'route', landslide: 'route', flood: 'route', route_hazard: 'route', route_closed: 'route', wildfire: 'route', river_crossing: 'route' };

function createSafety({ db, log, audit, notify, bus, achievements }) {
  const S = {};
  const isMod = u => ['ADMIN', 'DISPATCHER'].includes(u.role);
  const rview = (r, mod = false) => Object.assign({ id: r.id, kind: r.kind, routeId: r.route_id, routeName: r.route_name, body: r.body, lat: r.lat, lon: r.lon, observedAt: r.observed_at, status: r.status, photo: r.photo, createdAt: r.created_at },
    mod ? { userId: r.user_id, moderatedBy: r.moderated_by, moderatedAt: r.moderated_at, note: r.moderation_note } : {});

  S.createReport = async (ctx, d) => {
    if (d.routeId && !(await db.one('SELECT 1 FROM routes WHERE id=$1', [d.routeId]))) throw E.notFound('Маршрут не найден');
    if (d.photo) checkPhoto(d.photo);
    if (d.observedAt && new Date(d.observedAt) > new Date(Date.now() + 5 * 60000)) throw E.validation({ observedAt: 'время из будущего' });
    const r = await db.one("INSERT INTO safety_reports(user_id,route_id,kind,body,lat,lon,observed_at,photo,client_id) VALUES($1,$2,$3,$4,$5,$6,COALESCE($7,now()),$8,$9) ON CONFLICT (user_id,client_id) WHERE client_id IS NOT NULL DO NOTHING RETURNING *",
      [ctx.user.id, d.routeId || null, d.kind, d.body || '', d.lat ?? null, d.lon ?? null, d.observedAt || null, d.photo || null, d.clientId || null]);
    if (!r) return Object.assign(rview(await db.one('SELECT * FROM safety_reports WHERE user_id=$1 AND client_id=$2', [ctx.user.id, d.clientId])), { duplicate: true });
    await audit.log(ctx, 'report.created', 'report', r.id, { kind: r.kind });
    bus.publish('staff', 'report.created', { id: r.id, kind: r.kind });
    return rview(r);
  };
  S.myReports = async (ctx) => (await db.all('SELECT r.*, ro.name route_name FROM safety_reports r LEFT JOIN routes ro ON ro.id=r.route_id WHERE r.user_id=$1 ORDER BY r.created_at DESC LIMIT 100', [ctx.user.id])).map(r => rview(r));
  /* Публично видны только проверенные отчёты, без данных автора */
  S.verifiedForRoute = async (routeId) => (await db.all("SELECT r.*, ro.name route_name FROM safety_reports r LEFT JOIN routes ro ON ro.id=r.route_id WHERE r.route_id=$1 AND r.status='verified' AND r.observed_at > now() - interval '60 days' ORDER BY r.observed_at DESC LIMIT 50", [routeId])).map(r => { const v = rview(r); delete v.photo; return v; });
  S.queue = async (ctx, { status = 'pending', routeId, limit = 50, offset = 0 }) => {
    if (!isMod(ctx.user)) throw E.forbidden();
    return (await db.all('SELECT r.*, ro.name route_name FROM safety_reports r LEFT JOIN routes ro ON ro.id=r.route_id WHERE r.status=$1 AND ($2::uuid IS NULL OR r.route_id=$2) ORDER BY r.created_at ASC LIMIT $3 OFFSET $4', [status, routeId || null, limit, offset])).map(r => rview(r, true));
  };
  S.moderate = async (ctx, id, { status, note, createAlert }) => {
    if (!isMod(ctx.user)) throw E.forbidden();
    const r = await db.one("UPDATE safety_reports SET status=$2, moderated_by=$3, moderated_at=now(), moderation_note=$4 WHERE id=$1 RETURNING *", [id, status, ctx.user.id, note || null]);
    if (!r) throw E.notFound('Отчёт не найден');
    await audit.log(ctx, 'report.' + status, 'report', id, { note: note ? '[provided]' : null });
    if (r.user_id) {
      notify.send(r.user_id, { category: 'route', title: status === 'verified' ? 'Ваш отчёт о тропе проверен' : 'Отчёт отклонён', body: status === 'verified' ? 'Спасибо! Отчёт теперь виден другим туристам.' : (note || 'Модератор не подтвердил отчёт.'), data: { reportId: id } }).catch(() => {});
      if (status === 'verified') await achievements.evaluate(r.user_id, 'report');
    }
    if (status === 'verified' && createAlert && HAZARD_KINDS.includes(r.kind)) {
      const kind = { trail_closed: 'route_closed', bridge_damaged: 'route_hazard', hazard: 'route_hazard', landslide: 'landslide' }[r.kind];
      await S.createAlert(ctx, { kind, severity: 'WARNING', title: 'Проверенный отчёт: ' + r.kind, body: r.body, lat: r.lat, lon: r.lon, routeId: r.route_id, source: 'Отчёт пользователя, проверен модератором Mountain Safe', ttlHours: 72 });
    }
    return rview(r, true);
  };

  /* ── предупреждения безопасности: только с источником; никаких автогенерируемых «фальшивых» ── */
  const aview = a => ({ id: a.id, kind: a.kind, severity: a.severity, title: a.title, body: a.body, location: a.lat != null ? { lat: a.lat, lon: a.lon, radiusKm: a.radius_km == null ? null : +a.radius_km } : null, routeId: a.route_id, routeName: a.route_name, source: a.source, sourceUrl: a.source_url, startsAt: a.starts_at, expiresAt: a.expires_at, status: a.status });
  S.createAlert = async (ctx, d) => {
    if (!isMod(ctx.user)) throw E.forbidden('Создавать предупреждения могут диспетчеры и администраторы');
    if (d.routeId && !(await db.one('SELECT 1 FROM routes WHERE id=$1', [d.routeId]))) throw E.notFound('Маршрут не найден');
