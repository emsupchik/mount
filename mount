'use strict';
/* npm run e2e — последовательно запускает все браузерные сценарии, итог: код возврата 0 только если всё прошло */
const { spawnSync } = require('node:child_process'); const path = require('node:path'); const fs = require('node:fs');
const files = ['sos-lifecycle', 'offline', 'groups', 'pages', 'admin', 'csp', 'pwa', 'demo-mode', 'simulation', 'xss', 'mobile', 'axe', 'v3', 'real-mode', 'trip-wizard', 'scenarios', 'friends', 'help'].map(n => path.join(__dirname, n + '.js')).concat(fs.readdirSync(path.join(__dirname, 'legacy')).filter(f => f.endsWith('.js')).map(f => path.join(__dirname, 'legacy', f)));
let failed = 0;
for (const f of files) {
  const t0 = Date.now(); const r = spawnSync(process.execPath, [f], { encoding: 'utf8', timeout: 240000, env: process.env });
  const out = (r.stdout || '') + (r.stderr || ''); const fails = out.split('\n').filter(l => /^FAIL|CRASH|ERR |serious\/critical: [1-9]/.test(l));
  const ok = r.status === 0 && !fails.length; if (!ok) failed++;
  console.log((ok ? 'OK    ' : 'FAIL  ') + path.relative(__dirname, f).padEnd(24) + ((Date.now() - t0) / 1000).toFixed(1) + ' с' + (ok ? '' : '\n' + fails.slice(0, 8).join('\n')));
}
console.log(failed ? `\n${failed} сценариев с ошибками` : '\nВсе браузерные сценарии пройдены'); process.exit(failed ? 1 : 0);


