      <a class="btn btn-danger btn-lg" href="tel:112">Позвонить 112</a>
      <div class="grid g2"><button class="btn" data-action="sosCopyCard">📋 Скопировать карточку</button><button class="btn" data-action="geoCopy" ${c ? '' : 'disabled'}>📋 Скопировать координаты</button>${l ? `<a class="btn" href="${l.osm}" target="_blank" rel="noopener">🗺️ Открыть координаты</a>` : ''}<a class="btn" href="${esc(smsHref(this.text(p)))}">✉️ SMS близкому</a><button class="btn" data-action="sosShare">Поделиться</button><button class="btn" data-action="sosStress">Что делать: по шагам</button><button class="btn" data-action="sosDispatch">В ДЕМО-диспетчерскую</button><button class="btn btn-primary" data-action="sosSafe">Я в безопасности, отменить SOS</button></div></div>`;
  },
};


