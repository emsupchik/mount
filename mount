      if (P.route && (P.route.catalogId || P.route.gpx)) { const c = routeCalc(P.route); body.risk = { source: 'app-estimate', difficulty: DIFF[c.d].t, estHours: c.h, route: P.route.name }; }
      Object.keys(body).forEach(k => body[k] === undefined && delete body[k]);
