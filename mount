      COALESCE(avg(EXTRACT(EPOCH FROM (acknowledged_at-received_at))) FILTER (WHERE acknowledged_at IS NOT NULL AND received_at>now()-interval '7 days'),0)::int avg_ack_sec FROM sos_incidents`);
    return { active: r.active, acknowledged: r.acknowledged, dispatched: r.dispatched, inProgress: r.in_progress, resolved24h: r.resolved_24h, avgAcknowledgeSec7d: r.avg_ack_sec };
  };
  S.mustBeIncidentAccess = access;
  return S;
}
module.exports = { createSos, SITUATIONS, OPEN, FLOW };


