.sos-fab.app{z-index:60}
@media(max-width:959px){.sos-fab.app{display:none}}
@media(max-width:700px){.geo-pills .pill{padding:5px 8px;font-size:11px}.pill.lvl{display:none}.map{height:300px}}
.c-right{flex-wrap:wrap;justify-content:flex-end}

/* онлайн-режим: индикаторы, таблицы, графики */
