  v_incidents() {
    const f = App.state.rFilter || 'open', all = Sel.incidents(), list = f === 'all' ? all : f === 'new' ? all.filter(i => i.status === 0 && !i.cancelled) : f === 'done' ? all.filter(i => i.status === 4 || i.cancelled) : all.filter(i => i.status < 4 && !i.cancelled);
    return `${pageHead('Обращения')}<div class="chips">${[['open', 'Активные'], ['new', 'Новые'], ['done', 'Завершённые'], ['all', 'Все']].map(x => `<button class="chip ${f === x[0] ? 'on' : ''}" data-action="rFilter" data-v="${x[0]}">${x[1]}</button>`).join('')}</div>${list.length ? list.map(i => this.incCard(i)).join('') : '<div class="empty"><h3>Ничего нет</h3></div>'}`;
  },
  v_groups() {
    const gs = Sel.groups();
    return `${pageHead('Группы')}${gs.length ? gs.map(g => { const ld = Sel.user(g.leaderId), cnt = {}; g.members.forEach(m => { const s = Sel.memberStatus(m); cnt[s] = (cnt[s] || 0) + 1; });
      return `<div class="card"><div class="row sp"><h3>${esc(g.name)}</h3><span class="badge">код ${g.code}</span></div><div class="muted-p">Руководитель: ${esc(ld ? ld.name : '—')} · участников: ${g.members.length}</div><div class="row">${Object.keys(STATUS).filter(k => cnt[k]).map(k => `<span class="pill"><span class="dot ${STATUS[k].c}"></span>${STATUS[k].t}: ${cnt[k]}</span>`).join('') || '<span class="muted-p">Нет данных</span>'}</div>
      <details class="memo-d"><summary>Участники</summary><div>${g.members.map(m => `<div class="member"><span class="avatar">${esc(initials(m.name))}</span><span class="nm">${esc(m.name)}</span><span class="pill"><span class="dot ${STATUS[Sel.memberStatus(m)].c}"></span>${STATUS[Sel.memberStatus(m)].t}</span><small class="muted">${agoTxt(m.seenAt)}</small></div>`).join('')}</div></details></div>`; }).join('') : '<div class="empty"><h3>Групп пока нет</h3></div>'}`;
