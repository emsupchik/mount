  const cat = JSON.parse(fs.readFileSync(path.join(__dirname, 'db', 'seed', 'almaty-catalog.json'), 'utf8'));
  for (const r of cat) {
    const total = r.distanceKind === 'one-way' ? r.distanceKm : r.distanceKm;
    await db.query(`INSERT INTO routes(slug,name,description,region,distance_km,gain_m,max_alt_m,difficulty,seasons,is_public,origin,sources,landmark)
      VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9,true,'catalog',$10,$11)
      ON CONFLICT (slug) DO UPDATE SET name=EXCLUDED.name, description=EXCLUDED.description, distance_km=EXCLUDED.distance_km, gain_m=EXCLUDED.gain_m, max_alt_m=EXCLUDED.max_alt_m, difficulty=EXCLUDED.difficulty, seasons=EXCLUDED.seasons, sources=EXCLUDED.sources, landmark=EXCLUDED.landmark`,
      [r.slug, r.name, (r.notes || []).join(' '), r.region, total, r.gainM, r.maxAltM, r.difficulty, monthsRange(r.months), JSON.stringify(r.sources), r.landmark ? JSON.stringify(r.landmark) : null]);
  }
  await S.geodata.seed();
  /* треки каталога «Горы Алматы»: построены по тропам OpenStreetMap (scripts/build-catalog-tracks.py), ставятся только туда, где геометрии ещё нет */
  try {
    const tracks = JSON.parse(fs.readFileSync(path.join(__dirname, 'db', 'seed', 'catalog-tracks.json'), 'utf8'));
    for (const [slug, t] of Object.entries(tracks)) {
      const r = await db.one('SELECT r.id, (SELECT count(*)::int FROM route_points p WHERE p.route_id=r.id) n FROM routes r WHERE r.slug=$1', [slug]);
      if (!r || r.n >= 2) continue;
      await S.geodata.setGeometry({ user: { id: null, role: 'ADMIN' }, actorId: null }, slug, { coordinates: t.coordinates, kind: t.kind, source: Object.assign({ anchors: t.anchors }, t.source) });
      log.info({ slug, msg: 'catalog track seeded' });
    }
  } catch (e) { log.warn({ err: e }, 'catalog tracks seed failed'); }
  if (cfg.adminEmail && cfg.adminPassword) {
    const has = await db.one("SELECT 1 FROM users WHERE role='ADMIN' LIMIT 1");
    if (!has) {
      const { v, parse } = require('./lib/validate');
      try { parse(v.obj({ e: v.email(), p: v.password() }), { e: cfg.adminEmail, p: cfg.adminPassword }); }
      catch (e) { throw new Error('ADMIN_EMAIL/ADMIN_PASSWORD не проходят проверку: ' + JSON.stringify(e.details || {})); }
      const { u } = await db.tx(q => auth.createUser(q, { email: cfg.adminEmail, password: cfg.adminPassword, fullName: 'Администратор', role: 'ADMIN', emailVerified: true }));
      log.info({ userId: u.id, msg: 'bootstrap admin created' });
    }
  }
}
const MONTHS = ['янв', 'фев', 'мар', 'апр', 'май', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];
function monthsRange(m) { if (!m || !m.length) return null; if (m.length === 12) return 'круглый год'; return m.slice().sort((a, b) => a - b).map(x => MONTHS[x - 1]).join(', '); }

module.exports = { createApp };


