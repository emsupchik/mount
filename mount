  };

  /* Обновление позиции владельцем активного SOS (координаты меняются, пока человек идёт/ждёт) */
  S.updatePosition = async (ctx, id, p) => {
    const i = await load(id); if (i.user_id !== ctx.user.id) throw E.notFound('Инцидент не найден');
