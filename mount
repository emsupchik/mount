      const r = await q.one(`UPDATE sos_incidents SET team_id=$2, eta_min=$3, status='DISPATCHED', dispatched_at=COALESCE(dispatched_at, now()),
        acknowledged_at=COALESCE(acknowledged_at, now()), acknowledged_by=COALESCE(acknowledged_by,$4), dispatcher_id=COALESCE(dispatcher_id,$4), updated_at=now() WHERE id=$1 RETURNING *`, [id, teamId, e, ctx.user.id]);
