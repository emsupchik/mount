'use strict';
/* Экспорт всех данных пользователя (GDPR-подобное право на переносимость). Хэши паролей и токенов не включаются. */
function createExporter({ db, profile }) {
  return {
    async export(userId) {
      const q = (sql, p = [userId]) => db.all(sql, p);
      const u = await db.one('SELECT id,email,email_verified_at,phone,phone_verified_at,role,status,created_at,last_login_at FROM users WHERE id=$1', [userId]);
      return {
        exportedAt: new Date().toISOString(), format: 'mountain-safe-export/1',
        account: u, profile: await db.one('SELECT * FROM profiles WHERE user_id=$1', [userId]),
        emergencyContacts: await profile.contacts(userId), medical: await profile.getMedical(userId),
        groups: await q("SELECT g.id,g.name,gm.role,gm.status,gm.joined_at FROM group_members gm JOIN groups g ON g.id=gm.group_id WHERE gm.user_id=$1"),
        trips: await q('SELECT * FROM trips WHERE owner_id=$1 ORDER BY planned_start DESC'),
        gpsPoints: await q('SELECT lat,lon,accuracy,altitude,speed,battery,ts,trip_id FROM gps_points WHERE user_id=$1 ORDER BY ts DESC LIMIT 100000'),
        checkins: await q('SELECT status,lat,lon,at,trip_id,group_id FROM checkins WHERE user_id=$1 ORDER BY at DESC'),
        sosIncidents: await q('SELECT code,situation,description,status,priority,lat,lon,received_at,resolved_at,cancelled_at FROM sos_incidents WHERE user_id=$1 ORDER BY received_at DESC'),
        safetyReports: await q('SELECT kind,body,lat,lon,observed_at,status,created_at FROM safety_reports WHERE user_id=$1'),
        routes: await q('SELECT slug,name,description,region,distance_km,gain_m,is_public,created_at FROM routes WHERE owner_id=$1'),
