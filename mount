  /* ═════════════ Predictor (Predictive Safety Engine для навигации) ═════════════ */
  const SAFE_BUFFER_MIN = 30;                 // запас до заката: ≥ 30 мин — SAFE WINDOW, 0–30 — LIMITED, < 0 — RETURN TIME EXCEEDED
