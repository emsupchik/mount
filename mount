  };

  /* Высоты из DEM (Open-Meteo Elevation API, до 100 точек за запрос) */
  G.elevations = async (pts) => {
    const out = new Array(pts.length).fill(null);
    for (let i = 0; i < pts.length; i += 100) {
      const chunk = pts.slice(i, i + 100);
      const u = cfg.geo.elevationUrl + '?latitude=' + chunk.map(p => (+p.lat).toFixed(5)).join(',') + '&longitude=' + chunk.map(p => (+p.lon).toFixed(5)).join(',');
      const r = await F(u, { signal: AbortSignal.timeout(20000) }); if (!r.ok) throw E.unavailable('Сервис высот недоступен (HTTP ' + r.status + ')', 'elevation_failed');
