      html += `<form data-form="login" novalidate>${fld({ name: 'login', label: r === 'rescuer' ? 'Логин сотрудника' : 'Логин или телефон', ac: 'username' })}${fld({ name: 'password', label: 'Пароль', type: 'password', ac: 'current-password' })}
