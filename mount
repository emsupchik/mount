'use strict';
/* Мастер «Подготовка похода»: обязательные поля, оценка риска, статусы draft → planned → active → completed / overdue / emergency,
   защита персональных данных участников (шифрование, доступ только организатору, нет ПДн в журнале). */
const { test, before, after } = require('node:test');
const assert = require('node:assert/strict');
const { makeEnv, client, signup, staff } = require('./helpers');
const Engine = require('../public/js/ms-engine.js');

let env; before(async () => { env = await makeEnv(); }); after(() => env.close());

const pad = n => String(n).padStart(2, '0');
const local = ms => { const d = new Date(ms); return { date: `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`, time: `${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}` }; };
const ALL = { mobile: true, gps: true, firstAid: true, water: true, food: true, warmClothes: true, flashlight: true, powerbank: true, tent: true, sleepingBag: true, signal: true, compass: true, offlineMap: true };
async function consentVersion() { return (await client(env).get('/api/v1/consent/trip_pd')).body.consent.version; }
async function plan(over = {}) {
  const s = local(Date.now() + 2 * 3600e3), e = local(Date.now() + (over.hours || 10) * 3600e3 + 2 * 3600e3);
  const base = {
    routeType: 'hiking', route: { start: { name: 'Медеу', lat: 43.157, lon: 77.059, source: 'map' }, end: { name: 'Пик Фурманова', lat: 43.106, lon: 77.072, source: 'search' }, waypoints: [], distanceKm: 12 },
    schedule: { startDate: s.date, startTime: s.time, returnDate: e.date, returnTime: e.time, tzOffsetMin: 0 },
    leader: { lastName: 'Иванов', firstName: 'Иван', phone: '+77001234567', consent: true }, participants: [],
    equipment: ALL, confirmations: { route: true, people: true, warnings: true, consent: true }, consentVersion: await consentVersion(),
  };
  return Object.assign(base, over.body || {});
}

