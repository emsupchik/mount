function makeStore(kind) {
  let ok = true; const mem = {};
  try { const s = window[kind]; s.setItem('__t', '1'); s.removeItem('__t'); } catch (e) { ok = false; }
  return {
    get: k => { try { return ok ? window[kind].getItem(k) : (k in mem ? mem[k] : null); } catch (e) { return null; } },
    set: (k, v) => { try { ok ? window[kind].setItem(k, v) : (mem[k] = v); } catch (e) { mem[k] = v; } },
    del: k => { try { ok ? window[kind].removeItem(k) : delete mem[k]; } catch (e) { /* ignore */ } },
  };
}
