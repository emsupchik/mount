        <div class="grid g3"><a class="btn" href="${esc(smsHref(sitrep(S.a)))}">SMS близкому</a><button class="btn" data-action="stShare">Поделиться</button><button class="btn" data-action="stCopy">Скопировать</button></div>
        <div class="warnbox">Передайте сообщение по 112 голосом. SMS проходит при слабом сигнале. Пока идёт помощь: держите пострадавшего в тепле и следите за дыханием.</div>`; }
      else body = `<div class="big-step"><div class="n">Шаг ${S.pi + 1} из ${P.length}</div>${p.h ? `<div class="sect-t">${esc(p.h)}</div>` : ''}<div class="t">${esc(p.t)}</div></div>`;
      foot = `<div class="grid g2"><button class="btn" data-action="stPrev" ${S.pi === 0 ? 'disabled' : ''}>← Назад</button>${p.report ? `<button class="btn btn-primary" data-action="stClose">Готово</button>` : `<button class="btn btn-primary" data-action="stNext">Сделано, дальше</button>`}</div>`;
    }
    root.innerHTML = `<div class="in">${top}${body}<div style="flex:0">${foot}</div></div>`;
  },
  /* BACKEND: POST /incidents */
  send() {
    const S = this.st; const i = Api.incident.create(S.a, { sitrep: sitrep(S.a), demo: !!S.demo }); S.sent = i.id; this.draw(); Toast.show(`Обращение ${i.id} отправлено`, { icon: '🚨', title: 'SOS' });
  },
};

/* ── алгоритм ситуации ── */
const DONE = {};
const LEAD = ['Назначьте ответственных: за пострадавшего, за группу, за связь.', 'Запишите время события и первичное состояние пострадавшего.', 'Сформируйте сообщение спасателям и передайте его.', 'Решите: эвакуация силами группы или ожидание спасателей на месте.'];
function incView(id) {
  const I = INC[id], lv = Prefs.get().level, dn = DONE[id] || (DONE[id] = {}), me = Sel.me();
  const li = (t, i, cls, pre) => `<li class="${cls} ${dn[pre + i] ? 'done' : ''}" data-action="doneStep" data-id="${id}" data-k="${pre + i}" role="button" tabindex="0">${esc(t)}</li>`;
  return `<div class="row"><a class="btn btn-sm btn-ghost" href="#/sos">← Все ситуации</a></div>
  ${pageHead(I.em + ' ' + I.t)}
  ${I.call ? '<div class="dngbox"><b>Нужна экстренная помощь.</b> Позвоните 112 как можно раньше.</div>' : '<div class="warnbox">Если состояние ухудшается или вы не уверены, звоните 112.</div>'}
  <ol class="steps">${I.steps.map((t, i) => li(t, i, '', 's')).join('')}</ol>
  ${lv >= 2 && I.adv.length ? `<div class="sect-t">Расширенно</div><ol class="steps">${I.adv.map((t, i) => li(t, i, 'adv', 'a')).join('')}</ol>` : ''}
  ${lv >= 3 ? `<div class="sect-t">Протокол руководителя</div><ol class="steps">${LEAD.map((t, i) => li(t, i, 'adv', 'l')).join('')}</ol>` : ''}
  ${I.no.length ? `<div class="sect-t">Нельзя</div>${I.no.map(t => `<div class="dont">${esc(t)}</div>`).join('')}` : ''}
  <div class="grid g2"><button class="btn btn-danger btn-lg" data-action="openStress" data-id="${id}">SOS: пошагово и отправить</button><button class="btn btn-lg" data-action="showSitrep" data-id="${id}">Сообщение спасателям</button></div>${numsCard()}`;
}
function sitrepModal(id) {
  const a = { inc: id, danger: null, who: null, move: null, comm: null, where: Prefs.get().card.coords || '' }, t = sitrep(a);
  Modal.open({ id: 'sit', title: 'Сообщение спасателям', body: `<div class="sit">${esc(t)}</div><div class="row" style="margin-top:12px"><button class="btn btn-primary" data-action="copyText" data-t="${esc(t)}">Скопировать</button><a class="btn" href="${esc(smsHref(t))}">SMS близкому</a></div><p class="muted-p" style="margin-top:10px;font-size:12px">Чтобы заполнить поля точнее, пройдите Stress Mode.</p>` });
}

/* ── экран туриста: шапка, роутинг внутри раздела ── */
const TouristView = {
  seg: [],
  render(seg) { this.seg = seg; if (!$('#c-main')) this.shell(); this.head(); this.paint(); },
  shell() {
    $('#app').innerHTML = `<header class="c-head"><div class="c-head-in"><a class="brand" href="#/sos">${logo(30)}<span>Mountain Safe</span></a><nav class="c-nav" id="c-nav" aria-label="Разделы"></nav><div class="c-right" id="c-right"></div></div></header><div id="offb" style="max-width:1180px;margin:10px auto 0;padding:0 16px"></div><main class="c-main" id="c-main"></main><button class="sos-fab app" data-action="sosRequest" aria-label="SOS, экстренная помощь">${icon('alert', 24)} SOS</button><nav class="tabbar" id="tabbar" aria-label="Основная навигация"></nav>`;
  },
  head() {
    const me = Sel.me(), r = this.seg[0] || 'sos', P = Prefs.get(), un = Sel.userUnread(Sel.actor().id);
    const items = TNAV.filter(n => n[0] !== 'group' || me).map(n => n[0] === 'group' && me && me.role === 'leader' ? ['leader', 'Панель группы', 'users'] : n);
    $('#c-nav').innerHTML = items.map(n => `<a href="#/${n[0]}" class="${r === n[0] || (n[0] === 'sos' && r === 'track') ? 'on' : ''}">${n[1]}</a>`).join('');
    $('#c-right').innerHTML = `${Conn.pill()}<span id="geo-pills" class="geo-pills">${GeoUI.pills()}</span><button class="pill lvl" data-action="openLevel" title="Уровень подготовки">${icon('gauge', 14)}${lvName(P.level)}</button>
      <button class="icon-btn" data-action="openChat" aria-label="Чат с диспетчером" style="position:relative">${icon('msg', 18)}${un ? `<i class="dot-badge" style="position:absolute;top:-8px;right:-8px">${un}</i>` : ''}</button>
      ${me ? `<button class="icon-btn" data-action="openProfile" aria-label="Профиль">${icon('user', 18)}</button>` : `<button class="btn btn-sm btn-primary" data-action="authTourist">Войти</button>`}`;
    const t = (id, l, ic, cls = '') => `<a href="#/${id}" class="${cls} ${r === id ? 'on' : ''}">${icon(ic, 20)}<span>${l}</span></a>`;
    $('#tabbar').innerHTML = t('location', 'Локация', 'pin') + t('prep', 'Готовность', 'list') + `<button class="sos" data-action="sosRequest" aria-label="SOS">${icon('alert', 20)}<span>SOS</span></button>` + t('memos', 'Памятки', 'book') + `<button data-action="openMore">${icon('users', 20)}<span>Ещё</span></button>`;
    const c = Conn.state(); $('#offb').innerHTML = c === 'offline' ? `<div class="dngbox"><b>OFFLINE.</b> Сайт работает на сохранённых данных. Отправка диспетчеру и обновления недоступны, алгоритмы, карточка и чек-листы работают.</div>` : c === 'weak' ? `<div class="warnbox"><b>Слабая связь.</b> Отправляйте короткие сообщения (SMS).</div>` : '';
  },
  paint() {
    const r = this.seg[0] || 'sos', f = this['v_' + r] || this.v_sos;
    if (r !== 'location') GeoMap.destroy();
    if (r !== 'routes' && typeof AlmatyMap !== 'undefined') AlmatyMap.destroy();
    const main = $('#c-main'); main.innerHTML = f.call(this, this.seg); document.title = 'Mountain Safe';
    if (this['a_' + r]) this['a_' + r](); if (App.changed) window.scrollTo(0, 0);
  },
  refresh() { const f = document.activeElement; if (f && /INPUT|TEXTAREA|SELECT/.test(f.tagName)) return; if (['track', 'group', 'sos'].includes(this.seg[0] || 'sos') && !Stress.st) { this.head(); this.paint(); } else this.head(); },
  tick() { const p = $('.conn'); if (p) { const m = Conn.meta[Conn.state()]; if (!p.textContent.includes(m.t)) this.head(); } GeoUI.paintPills(); if ((this.seg[0] || 'sos') === 'location') GeoUI.paintFast(); },

  /* ── SOS ── */
  v_sos(seg) {
    if (seg[1] && INC[seg[1]]) return incView(seg[1]);
    const a = Sel.actor(), act = Sel.activeFor(a.id), q = App.state.what || '';
    return `${pageHead('SOS. Что произошло?', 'Выберите ситуацию и получите короткий алгоритм.')}
    ${act ? `<div class="risk t-hi"><div style="flex:1"><b>Активное обращение ${act.id}</b><div class="small muted">${INC_STATUS[act.status].t}</div></div><a class="btn btn-sm" href="#/track/${act.id}">Открыть</a></div>` : ''}
    <div class="dngbox row sp"><div><b>Угроза жизни?</b> Сначала звоните <span class="mono">112</span>.</div><button class="btn btn-danger" data-action="openStress">Stress Mode</button></div>
    <div class="field" style="margin:0"><label for="whatIn">Что делать, если…</label><input id="whatIn" data-live="what" type="search" placeholder="Например: я потерялся" value="${esc(q)}" autocomplete="off"></div>
    <div class="chips">${QUICK.map(x => `<button class="chip" data-action="whatChip" data-q="${esc(x.q)}">${x.q}</button>`).join('')}</div>
    <div id="whatres" class="col">${this.whatRes(q)}</div>
    <div class="inc-grid">${SOS_IDS.map(id => `<a class="inc" href="#/sos/${id}"><span class="em">${INC[id].em}</span><b>${INC[id].t}</b></a>`).join('')}</div>
    <button class="btn btn-block" data-action="demoIncident">${icon('bolt', 16)} Демо: сымитировать ЧС (перелом)</button>${numsCard()}`;
  },
  whatRes(q) {
    q = String(q).trim().toLowerCase(); if (q.length < 2) return '';
    const hits = QUICK.filter(x => x.q.toLowerCase().includes(q) || x.k.some(k => q.includes(k) || (q.length >= 3 && k.includes(q))));
    if (!hits.length) return `<div class="empty"><b>Ничего не найдено.</b><div class="muted-p">Попробуйте другие слова или выберите ситуацию ниже.</div></div>`;
    const top = hits[0], I = INC[top.id];
    return `<div class="card"><h2>${I.em} ${top.q}</h2><div class="sect-t">Сейчас</div><ol class="steps">${I.steps.slice(0, 7).map(t => `<li>${esc(t)}</li>`).join('')}</ol>${I.call ? '<div class="dngbox">Нужна экстренная помощь: <b>112</b>.</div>' : ''}<div class="grid g2"><button class="btn btn-danger" data-action="openStress" data-id="${top.id}">Пошагово (Stress Mode)</button><a class="btn" href="#/sos/${top.id}">Полный алгоритм</a></div></div>`;
  },

  /* ── отслеживание обращения ── */
  v_track(seg) {
    const i = Sel.incident(seg[1]); if (!i) return `<div class="empty"><h3>Обращение не найдено</h3><a class="btn btn-primary" href="#/sos" style="margin-top:12px">К SOS</a></div>`;
    const I = INC[i.type], done = i.status >= 4 || i.cancelled;
    const tl = INC_STATUS.map((s, k) => { const h = i.history.find(x => x.status === k), cls = i.cancelled ? (h ? 'done' : 'todo') : k < i.status ? 'done' : k === i.status ? 'cur' : 'todo'; return `<div class="tl ${cls}"><i>${k < i.status ? '✓' : k + 1}</i><div><b>${s.t}</b><small class="muted">${h ? tm(h.ts) + ' · ' : ''}${s.s}</small></div></div>`; }).join('');
    return `${pageHead(`${i.emoji} ${i.id}`, i.typeName)}
    <div class="warnbox"><b>ДЕМО.</b> Ответ диспетчера имитируется. Настоящих спасателей приложение не вызывает. При угрозе жизни звоните <b class="mono">112</b>.</div>
    ${i.cancelled ? '<div class="risk"><b>Обращение отменено пользователем</b></div>' : `<div class="risk ${i.status >= 4 ? '' : 't-hi'}"><div style="flex:1"><b style="font:700 26px var(--display)">${INC_STATUS[i.status].t}</b><div class="small muted">${INC_STATUS[i.status].s}</div></div>${i.status < 3 ? `<div style="text-align:right"><small>Ориентир (ДЕМО)</small><div class="mono" style="font-size:28px;font-weight:700">~${Sel.eta(i)} мин</div></div>` : ''}</div>`}
    <div class="grid g2"><div class="card"><div class="sect-t">Ход обращения</div><div class="timeline">${tl}</div></div>
    <div class="card"><div class="sect-t">Что видит диспетчер</div><div class="sit">${esc(i.sitrep || 'Сообщение не сформировано')}</div><div class="row"><button class="btn btn-sm" data-action="copyText" data-t="${esc(i.sitrep || '')}">Скопировать</button><button class="btn btn-sm" data-action="openChat">${icon('msg', 14)} Чат с диспетчером</button></div>${i.dispNote ? `<div class="warnbox"><b>Диспетчер:</b> ${esc(i.dispNote)}</div>` : ''}</div></div>
    ${done ? '' : `<div class="card"><div class="sect-t">Пока ждёте</div><ol class="steps">${I.steps.map(t => `<li>${esc(t)}</li>`).join('')}</ol></div><div class="row"><a class="btn btn-danger" href="tel:112">Позвонить 112</a><button class="btn" data-action="cancelInc" data-id="${i.id}">Ложная тревога, отменить</button></div>`}`;
  },

  /* ── подготовка ── */
  prepVis: () => PREP.filter(p => p.min <= Prefs.get().level),
  prepPct() { const v = this.prepVis(), P = Prefs.get(); return v.length ? Math.round(v.filter(p => P.prep[p.id]).length / v.length * 100) : 0; },
  prepWarns() {
    const P = Prefs.get(), w = [], vis = this.prepVis(), rk = wxRisk(P.wx), rc = routeCalc(P.route);
    const miss = vis.filter(p => p.crit && !P.prep[p.id]).map(p => p.t); if (miss.length) w.push('Не отмечено важное: ' + miss.join('; ') + '.');
    if (rk.l >= 2 && !P.prep.rain) w.push('Погода тяжёлая, а дождевик не отмечен.');
    if (rc.h > 6 && !P.prep.light) w.push('Маршрут долгий (' + hm(rc.h) + '): возьмите фонарик на случай темноты.');
    if (P.prep.charge && !P.prep.pb && rc.h > 5) w.push('Долгий маршрут без powerbank: заряд может закончиться.');
    return w;
  },
  v_prep() {
    const P = Prefs.get(), vis = this.prepVis(), pct = this.prepPct(), warns = this.prepWarns(), gs = [...new Set(vis.map(p => p.g))];
    const lab = pct >= 100 ? 'Чек-лист выполнен' : pct >= 70 ? 'Почти готовы' : 'Подготовка неполная';
    return `${pageHead('Подготовка к походу', 'Отметьте, что готово. Список зависит от уровня: ' + lvName(P.level) + '.')}
    <div class="card"><div class="row sp"><div><div class="sect-t">Готовность к походу</div><h2 style="font-size:56px">${pct}%</h2></div><span class="badge dark">${lab}</span></div><div class="bar" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100"><i style="width:${pct}%"></i></div>
    <p class="muted-p">Готовность считает только ваш чек-лист. ${pct >= 100 ? 'Даже 100% не означает, что поход безопасен: условия в горах меняются. Оценивайте погоду и состояние группы по ходу маршрута.' : 'Заполните критичные пункты (пунктирная рамка).'}</p></div>
    ${warns.length ? `<div class="warnbox"><b>Умная проверка</b><ul style="margin:6px 0 0;padding-left:18px;list-style:disc">${warns.map(x => `<li>${esc(x)}</li>`).join('')}</ul></div>` : ''}
    ${gs.map(g => `<div class="col"><div class="sect-t">${g}</div>${vis.filter(p => p.g === g).map(p => `<button class="chk ${P.prep[p.id] ? 'on' : ''} ${p.crit ? 'crit' : ''}" data-action="prepT" data-id="${p.id}" role="checkbox" aria-checked="${!!P.prep[p.id]}"><span class="bx">✓</span><span>${esc(p.t)}${p.why ? `<small>${esc(p.why)}</small>` : ''}</span></button>`).join('')}</div>`).join('')}
    <button class="btn btn-ghost" data-action="prepReset">Сбросить отметки</button>`;
  },

  /* ── маршрут ── */
  v_route() {
    const P = Prefs.get(), r = P.route, c = routeCalc(r), lv = P.level, d = DIFF[c.d], back = addTime(r.start, c.h * 1.25), demo = !r.gpx && !r.catalogId;
    const sm = (a, b) => { const [h1, m1] = a.split(':').map(Number), [h2, m2] = b.split(':').map(Number); return (h2 * 60 + m2) - (h1 * 60 + m1); }, buf = sm(back, r.sunset);
    const inp = (l, p, t = 'number') => `<div class="field"><label>${l}</label><input type="${t}" ${t === 'number' ? 'inputmode="decimal" data-n' : ''} data-bind="route.${p}" data-r value="${esc(r[p])}"></div>`;
    const pt = x => (x.k != null ? x.k + ' км' : '') + (x.lat != null ? (x.k != null ? ' · ' : '') + fmtCoord(x.lat, x.lon) : '');
    const list = (arr, ty) => arr.map((x, i) => `<div class="emnum"><b class="mono" style="font-size:13px;min-width:60px">${pt(x)}</b><span style="flex:1">${esc(x.t)}</span>${lv >= 1 ? `<button class="btn btn-sm btn-ghost" data-action="delPt" data-ty="${ty}" data-k="${i}" aria-label="Удалить">✕</button>` : ''}</div>`).join('') || '<div class="muted-p">Нет точек</div>';
    return `${pageHead('Маршрут', 'Импортируйте трек GPX, получите сложность, время и профиль высоты.', demo ? demoBadge : '<span class="badge dark">GPX</span>')}
    ${r.catalogId ? '<div class="warnbox">Параметры взяты из каталога «Горы Алматы» (по открытым источникам, без GPS-трека). Проверьте актуальность на местности; для точных данных импортируйте свой GPX.</div>' : ''}${demo ? '<div class="warnbox">Показан пример маршрута (ДЕМО). Загрузите свой GPX-файл: дистанция, набор высоты и профиль посчитаются по нему.</div>' : ''}
    <div class="card"><div class="row"><label class="btn btn-primary" for="gpxIn" style="cursor:pointer">Импортировать GPX</label><input id="gpxIn" type="file" accept=".gpx,application/gpx+xml,text/xml,application/xml" style="position:absolute;left:-9999px">${demo ? '' : '<button class="btn" data-action="routeDemo">Вернуться к примеру</button>'}</div><small class="muted">Файл читается на вашем устройстве и никуда не отправляется.</small></div>
    <div class="card"><div class="form-grid">${inp('Название', 'name', 'text')}${inp('Дистанция, км', 'dist')}${inp('Набор высоты, м', 'up')}${inp('Максимальная высота, м', 'max')}${inp('Старт (чч:мм)', 'start', 'text')}${inp('Закат (чч:мм)', 'sunset', 'text')}</div><small class="muted">Время заката возьмите из календаря: приложение не вычисляет его само.</small></div>
    <div class="grid g2"><div class="risk t-${d.c}"><div><div class="sect-t" style="color:inherit;opacity:.7">Сложность</div><b style="font:700 30px var(--display)">${d.t}</b><div class="small muted">Оценка по дистанции, набору и высоте. Ориентир, не гарантия.</div></div></div>
    <div class="card"><div class="sect-t">Время в пути</div><h2 style="font-size:40px">${hm(c.h)}</h2><div class="muted-p">~4 км/ч + 500 м подъёма в час. Реальное время зависит от группы.</div></div></div>
    <div class="card"><div class="sect-t">План возвращения</div><div class="row sp"><div>Старт <b class="mono">${esc(r.start)}</b></div><div>Вернуться ориентировочно к <b class="mono">${back}</b></div><div>Закат <b class="mono">${esc(r.sunset)}</b></div></div>
    ${buf < 60 ? '<div class="dngbox">До заката меньше часа после ожидаемого возвращения. Стартуйте раньше или сократите маршрут.</div>' : `<div class="muted-p">Запас до заката: ${Math.floor(buf / 60)} ч ${buf % 60} мин (с запасом 25% ко времени пути).</div>`}</div>
    ${lv >= 1 ? `<div class="card"><div class="row sp"><div class="sect-t">Профиль высоты</div>${demo ? demoBadge : ''}</div>${elevSvg(r)}<small class="muted">Чёрные точки: риски на маршруте.</small></div>` : ''}
    <div class="card"><div class="sect-t">Точки риска</div>${list(r.risks, 'risk')}</div>
    ${lv >= 1 ? `<div class="grid g2"><div class="card"><div class="sect-t">Точки отдыха</div>${list(r.rest, 'rest')}</div><div class="card"><div class="sect-t">Точки выхода</div>${list(r.exits, 'exit')}</div></div><div class="card"><div class="field" style="margin:0"><label>Запасной маршрут</label><textarea data-bind="route.alt">${esc(r.alt)}</textarea></div></div>` : ''}
    ${lv >= 2 ? `<div class="card"><div class="sect-t">Добавить точку</div><div class="form-grid"><div class="field"><label>Тип</label><select id="npT"><option value="risk">Риск</option><option value="rest">Отдых</option><option value="exit">Выход</option></select></div><div class="field"><label>Километр</label><input id="npK" type="number" inputmode="decimal" placeholder="5.5"></div></div><div class="field"><label>Описание</label><input id="npY" placeholder="Осыпь, крутой склон, брод"></div><button class="btn btn-primary" data-action="addPt">Добавить</button></div>` : '<small class="muted">Добавление точек, запасной маршрут и профиль высоты открываются с уровня AVERAGE.</small>'}`;
  },

  /* ── погода ── */
  v_weather() {
    const P = Prefs.get(), live = P.wx.sc === 'live' && P.wxLive, off = Conn.state() === 'offline';
    const sl = (l, p, mn, mx, st) => `<div class="field"><label><span class="row sp"><span>${l}</span><output class="mono">${P.wx[p]}</output></span></label><input type="range" min="${mn}" max="${mx}" step="${st}" value="${P.wx[p]}" data-bind="wx.${p}" data-n data-live="wx"></div>`;
    return `${pageHead('Погода и риски', 'Оценка риска по температуре, ветру, осадкам, грозе и видимости.', wxBadge())}
    ${live ? `<div class="card flat muted-p">${esc(wxSource())} Высота расчётной точки: ${P.wxLive.elev != null ? Math.round(P.wxLive.elev) + ' м' : 'н/д'}. «Вероятность грозы» оценивается по коду погоды и энергии конвекции (CAPE): это не официальный показатель. Сверяйтесь с официальным прогнозом.</div>` : '<div class="warnbox">Сейчас показан ДЕМО-сценарий. Загрузите реальный прогноз для вашей точки.</div>'}
