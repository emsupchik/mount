      else if (v === 'send') { s.phase = 'sent'; s.status = 'NEW'; s.created = now; lg('SOS создан на телефоне туриста и получен (симуляция)'); lg('Email/SMS диспетчеру: SIMULATED, ничего не отправлено'); }
