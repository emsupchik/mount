});

test('SOS → email и SMS дежурному диспетчеру: адреса из env, содержимое письма, статусы SENT/FAILED, повтор', async () => {
  const u = await signup(env, { fullName: 'Ерлан' });
  const r = await u.post('/api/v1/sos', { clientId: 'v3-sos-1-abcdef', situation: 'fracture', lat: 43.0506, lon: 76.985, accuracy: 9, altitude: 2640, battery: 32, connection: 'weak', route: { name: 'Большое Алматинское озеро' } });
  assert.equal(r.status, 201); await env.app.S.sos.lastAfterCreate;
  const em = net.calls.filter(c => c.url.startsWith('https://api.resend.com')).pop(); const mail = JSON.parse(em.body);
  assert.deepEqual(mail.to, ['duty@rescue.test']); assert.match(mail.subject, /🚨 MOUNTAIN SAFE — NEW SOS INCIDENT/);
  for (const re of [/NEW SOS ALERT/, /Tourist:\nЕрлан/, /Coordinates:\n43\.050600, 76\.985000/, /Altitude:\n2640 m/, /Battery:\n32%/, /Route:\nБольшое Алматинское озеро/, /Last known movement:/, /https:\/\/ms\.test\/#\/admin\/incidents\//]) assert.match(mail.text, re);
  const sms = smsCalls().pop(); assert.match(decodeURIComponent(sms.body), /recipient=77005550101/);
  const d = await staff(env, 'DISPATCHER');
  const list = (await d.get('/api/v1/rescue/incidents/' + r.body.incident.id + '/notifications')).body.notifications;
  assert.deepEqual(list.map(x => [x.channel, x.status]).sort(), [['email', 'SENT'], ['sms', 'SENT']]);
  assert.ok(list.every(x => !x.target.includes('rescue.test') || x.target.includes('***')), 'адрес в журнале замаскирован');
  assert.equal((await u.get('/api/v1/rescue/incidents/' + r.body.incident.id + '/notifications')).status, 403, 'турист не видит журнал доставки');
  const detail = (await d.get('/api/v1/rescue/incidents/' + r.body.incident.id)).body.incident; assert.equal(detail.altitude, 2640);
  // провайдер упал → FAILED (не SENT), повтор после восстановления → SENT
  net.st.emailFail = true; const u2 = await signup(env);
  const r2 = await u2.post('/api/v1/sos', { clientId: 'v3-sos-2-abcdef', situation: 'lost', lat: 43.1, lon: 77.0 }); await env.app.S.sos.lastAfterCreate;
  const l2 = (await d.get('/api/v1/rescue/incidents/' + r2.body.incident.id + '/notifications')).body.notifications; const fe = l2.find(x => x.channel === 'email');
  assert.equal(fe.status, 'FAILED'); assert.match(fe.error, /HTTP 500/);
  net.st.emailFail = false; const rt = await d.post('/api/v1/rescue/notifications/' + fe.id + '/retry'); assert.equal(rt.body.notification.status, 'SENT'); assert.equal(rt.body.notification.attempts, 2);
});

