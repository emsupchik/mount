  },
  /* скачивает только видимую область на текущем масштабе, не больше 60 плиток за раз (правила использования OSM) */
  async download(b, z, onProgress) {
    if (!window.caches) throw new Error('Кэш браузера недоступен');
    if (Conn.state() === 'offline') throw new Error('Нет интернета: карту нужно скачивать заранее, пока связь есть');
    const urls = this.urls(b, z); if (urls.length > 60) throw new Error(`Область велика (${urls.length} плиток). Приблизьте карту: за раз можно сохранить до 60 плиток`);
    const c = await caches.open(TILE_CACHE); let ok = 0;
    for (let i = 0; i < urls.length; i++) { try { if (!(await c.match(urls[i]))) { const r = await fetch(urls[i], { mode: 'cors' }); if (r.ok) { await c.put(urls[i], r); ok++; } } else ok++; } catch (e) { /* пропускаем недоступные */ } if (onProgress) onProgress(i + 1, urls.length); }
    return { ok, need: urls.length };
  },
  async tileBlob(url) { try { if (!window.caches) return null; const c = await caches.open(TILE_CACHE), r = await c.match(url); return r ? await r.blob() : null; } catch (e) { return null; } },
};

/* ── PWA: регистрация service worker и установка ── */
