'use strict';
const { v } = require('../lib/validate');
const { parse } = require('../lib/validate');
const { E } = require('../lib/errors');
const { SITUATIONS } = require('../services/sos');

/* Оффлайн-очередь клиента: пачка операций, каждая идемпотентна (opId = clientId). Ошибка одной операции не блокирует остальные.
   permanent=true означает «повторять бессмысленно, удалите из очереди»; иначе клиент повторит позже. */
module.exports = (r, S) => {
  const loc = { lat: v.lat(), lon: v.lon(), accuracy: v.num({ min: 0, max: 100000 }).optional(), altitude: v.num({ min: -500, max: 9000 }).nullable().optional(), speed: v.num({ min: 0, max: 200 }).nullable().optional() };
  const OPS = {
    location: [v.obj({ ...loc, battery: v.int({ min: 0, max: 100 }).optional(), ts: v.date(), gpsStatus: v.str({ max: 20 }).optional(), netQuality: v.enum(['online', 'weak', 'offline']).optional() }), (ctx, p, id) => S.trips.location(ctx, { ...p, clientId: id })],
    checkin: [v.obj({ status: v.enum(['ok', 'need_rest', 'need_help']), groupId: v.uuid().optional(), tripId: v.uuid().optional(), lat: v.lat().optional(), lon: v.lon().optional(), at: v.date().optional() }), (ctx, p, id) => S.trips.checkin(ctx, { ...p, clientId: id })],
    sos: [v.obj({ situation: v.enum(SITUATIONS), description: v.str({ max: 1000, multiline: true }).optional(), lat: v.lat().optional(), lon: v.lon().optional(), accuracy: v.num({ min: 0, max: 100000 }).optional(), altitude: v.num({ min: -500, max: 9000 }).nullable().optional(), positionAt: v.date().optional(), battery: v.int({ min: 0, max: 100 }).optional(), connection: v.enum(['online', 'weak', 'offline']).optional(), route: v.json(4000).optional(), groupId: v.uuid().optional(), tripId: v.uuid().optional(), clientCreatedAt: v.date().optional(), includeMedical: v.bool().optional() }), (ctx, p, id) => S.sos.create(ctx, { ...p, clientId: id })],
    sos_position: [v.obj({ incidentId: v.uuid(), lat: v.lat(), lon: v.lon(), accuracy: v.num({ min: 0, max: 100000 }).optional(), at: v.date().optional(), battery: v.int({ min: 0, max: 100 }).optional() }), (ctx, p) => S.sos.updatePosition(ctx, p.incidentId, p)],
    group_message: [v.obj({ groupId: v.uuid(), body: v.str({ min: 1, max: 1000, multiline: true }) }), (ctx, p, id) => S.groups.post(ctx, p.groupId, { body: p.body, clientId: id })],
    incident_message: [v.obj({ incidentId: v.uuid(), body: v.str({ min: 1, max: 1000, multiline: true }) }), (ctx, p, id) => S.sos.message(ctx, p.incidentId, { body: p.body, clientId: id })],
    safety_report: [v.obj({ kind: v.enum(['trail_condition', 'trail_closed', 'bridge_damaged', 'hazard', 'landslide', 'water', 'weather', 'navigation']), routeId: v.uuid().optional(), body: v.str({ max: 1000, multiline: true }).optional(), lat: v.lat().optional(), lon: v.lon().optional(), observedAt: v.date().optional(), photo: v.rawStr(300 * 1024).optional() }), (ctx, p, id) => S.safety.createReport(ctx, { ...p, clientId: id })],
  };
  r.post('/api/v1/sync/batch', { rate: [{ name: 'syncbatch', max: 30, windowMs: 60e3, by: 'user' }], bodyLimit: 512 * 1024, body: v.obj({ ops: v.arr(v.obj({ opId: v.str({ min: 8, max: 64 }), type: v.enum(Object.keys(OPS)), payload: v.any(300 * 1024), createdAt: v.date().optional() }), { min: 1, max: 100 }) }) }, async ctx => {
    const results = [];
    for (const op of ctx.body.ops) {
      const [schema, run] = OPS[op.type];
      try {
        const payload = parse(schema, op.payload);
        const out = await run(ctx, payload, op.opId);
        results.push({ opId: op.opId, status: out && (out.duplicate || out.existingActive) ? 'duplicate' : 'ok', result: op.type === 'sos' ? out.incident : undefined });
      } catch (e) {
        const st = e.status || 500; const permanent = st >= 400 && st < 500 && st !== 408 && st !== 429 && st !== 409 || (st === 409 && e.code !== 'refresh_conflict');
        if (st >= 500) S.log.error({ err: e, type: op.type }, 'sync op failed');
        results.push({ opId: op.opId, status: 'error', httpStatus: st, code: e.code || 'internal_error', message: e.expose ? e.message : 'Внутренняя ошибка', details: e.details, permanent: st < 500 && permanent });
      }
    }
    const failed = results.filter(x => x.status === 'error').length;
    if (failed) S.log.event('sync', 'batch_partial', { userId: ctx.user.id, count: failed });
    return { results, serverTime: new Date().toISOString() };
  });

  /* Снимок для восстановления состояния клиента после (пере)подключения */
  r.get('/api/v1/sync/state', async ctx => {
    const u = ctx.user;
    const [profile, contacts, groups, sos, trip, unread, alerts, banner] = await Promise.all([
      S.profile.get(u.id), S.profile.contacts(u.id), S.groups.listMine(u.id), S.sos.myActive(ctx), S.trips.active(ctx),
      S.db.one('SELECT count(*)::int n FROM notifications WHERE user_id=$1 AND read_at IS NULL', [u.id]), S.safety.listAlerts({}), S.admin.setting('maintenance_banner', ''),
    ]);
    return { serverTime: new Date().toISOString(), user: S.auth.publicUser(u, { tag: profile.tag, full_name: profile.fullName }), profile, contacts, groups, activeSos: sos, activeTrip: trip, unreadNotifications: unread.n, alerts: alerts.slice(0, 20), banner };
  });
};


