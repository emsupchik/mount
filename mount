    const list = await this.pending(); let n = 0;
    for (const x of list) { const r = await sendEmergencyData(x.payload); x.status = r.delivered ? 'sent' : 'prepared'; x.result = { demo: r.demo, message: r.message }; await Hist.outboxAdd(x); n++; }
    if (GeoCfg.trackApi) { /* BACKEND: POST GeoCfg.trackApi с историей пути (Hist.points('real')) */ }
    return { prepared: n };
  },
};

