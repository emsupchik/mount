.switch .lab{font:700 12px var(--label);position:absolute;right:12px;color:var(--ink-2)}
.switch.on{background:var(--accent)}.switch.on .knob{transform:translateX(46px);background:var(--on-accent)}
.switch.on .lab{right:auto;left:14px;color:var(--on-accent)}
.switch.on.demo{background:#a78bfa}.switch.on.demo .knob{background:#160c33}.switch.on.demo .lab{color:#160c33}
.switch[disabled]{opacity:.45;pointer-events:none}
.demo-steps{display:flex;gap:6px;flex-wrap:wrap;list-style:none}
