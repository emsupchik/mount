'use strict';
const { v, parse } = require('../lib/validate');
const { E } = require('../lib/errors');
const { randomToken } = require('../lib/crypto');

module.exports = (rr, S) => {
  const { trips, consent, sos } = S; const id = { id: 'uuid' };
  /* Все маршруты походов доступны и по /api/v1/trips…, и по короткому /api/trips… (одни и те же обработчики и проверки) */
  const r = {};
  for (const m of ['get', 'post', 'put', 'patch', 'del']) r[m] = (p, o, h) => { rr[m](p, o, h); if (p.startsWith('/api/v1/trips')) rr[m](p.replace('/api/v1/', '/api/'), o, h); };

  /* ── старый быстрый планировщик (без участников) — без изменений ── */
  const pt = v.json(1000);
  const trip = { name: v.str({ min: 2, max: 120 }), groupId: v.uuid().optional(), routeId: v.uuid().optional(), startPoint: pt.nullable().optional(), destination: pt.nullable().optional(), plannedStart: v.date(), expectedReturn: v.date(),
    participantIds: v.arr(v.uuid(), { max: 50 }).optional(), contacts: v.arr(v.obj({ name: v.str({ max: 80 }), relation: v.str({ max: 40 }).optional(), phone: v.phone() }), { max: 10 }).optional(),
    checklist: v.arr(v.obj({ item: v.str({ max: 120 }), done: v.bool().optional() }), { max: 100 }).optional(), weather: v.json(4000).nullable().optional(), risk: v.json(4000).nullable().optional(), backupPlan: v.str({ max: 1500, multiline: true }).optional(), checkinIntervalMin: v.int({ min: 5, max: 1440 }).optional() };
  const legacyCreate = v.obj(trip, { strict: true });
  const legacyPatch = v.obj({ name: trip.name.optional(), plannedStart: trip.plannedStart.optional(), expectedReturn: trip.expectedReturn.optional(), startPoint: trip.startPoint, destination: trip.destination, contacts: trip.contacts, checklist: trip.checklist, weather: trip.weather, risk: trip.risk, backupPlan: trip.backupPlan, checkinIntervalMin: trip.checkinIntervalMin }, { strict: true });

  /* ── поход из мастера «Подготовка похода»: строгая серверная валидация ── */
  const DATE = /^\d{4}-\d{2}-\d{2}$/, TIME = /^([01]\d|2[0-3]):[0-5]\d$/;
  const NAME = { min: 1, max: 60, re: /^[\p{L}][\p{L}\s'’.-]*$/u, reMsg: 'только буквы, пробел, дефис, апостроф' };
  const point = v.obj({ name: v.str({ min: 1, max: 120 }), lat: v.lat().nullable().optional(), lon: v.lon().nullable().optional(), source: v.enum(['map', 'search', 'gps', 'manual']).optional() }, { strict: true });
  const person = (leader) => v.obj({ lastName: v.str(NAME).optional(), firstName: v.str(NAME).optional(), middleName: v.str({ ...NAME, min: 0 }).optional(),
    phone: leader ? v.phone().optional() : v.phone().optional(), consent: v.bool().optional() }, { strict: true });
  const equipment = v.obj(Object.fromEntries(['mobile', 'satellite', 'radio', 'gps', 'offlineMap', 'compass', 'water', 'food', 'firstAid', 'powerbank', 'battery', 'flashlight', 'signal', 'tent', 'sleepingBag', 'warmClothes'].map(k => [k, v.bool().optional()])), { strict: true });
  const planShape = {
    draft: v.bool().optional(), status: v.enum(['draft', 'planned']).optional(), name: v.str({ max: 120 }).optional(), groupId: v.uuid().optional(),
    routeType: v.enum(['hiking', 'mountain', 'multiday', 'winter', 'other']).optional(), difficulty: v.enum(['easy', 'medium', 'hard', 'extreme']).optional(), remoteness: v.enum(['near', 'medium', 'remote']).optional(),
    hazards: v.arr(v.enum(['river', 'avalanche', 'glacier', 'rockfall', 'cliffs', 'scree']), { max: 6 }).optional(),
    route: v.obj({ start: point.nullable().optional(), end: point.nullable().optional(), waypoints: v.arr(point, { max: 20 }).optional(), description: v.str({ max: 1500, multiline: true }).optional(), distanceKm: v.num({ min: 0, max: 2000 }).nullable().optional() }, { strict: true }).optional(),
    schedule: v.obj({ startDate: v.str({ re: DATE, reMsg: 'дата ГГГГ-ММ-ДД' }).optional(), startTime: v.str({ re: TIME, reMsg: 'время ЧЧ:ММ' }).optional(), returnDate: v.str({ re: DATE, reMsg: 'дата ГГГГ-ММ-ДД' }).optional(), returnTime: v.str({ re: TIME, reMsg: 'время ЧЧ:ММ' }).optional(), tzOffsetMin: v.int({ min: -840, max: 840 }).optional() }, { strict: true }).optional(),
    overnights: v.arr(v.obj({ name: v.str({ min: 1, max: 120 }), lat: v.lat().nullable().optional(), lon: v.lon().nullable().optional(), arriveDate: v.str({ re: DATE, reMsg: 'дата ГГГГ-ММ-ДД' }).optional(), leaveDate: v.str({ re: DATE, reMsg: 'дата ГГГГ-ММ-ДД' }).optional() }, { strict: true }), { max: 30 }).optional(),
    leader: person(true).optional(), participants: v.arr(person(false), { max: 99 }).optional(),
    equipment: equipment.optional(), weather: v.obj({ maxWindKmh: v.num({ min: 0, max: 400 }).optional(), precipMm: v.num({ min: 0, max: 1000 }).optional(), minTempC: v.num({ min: -80, max: 60 }).optional(), thunder: v.bool().optional() }, { strict: true }).nullable().optional(),
    confirmations: v.obj({ route: v.bool().optional(), people: v.bool().optional(), warnings: v.bool().optional(), consent: v.bool().optional() }, { strict: true }).optional(),
    consentVersion: v.int({ min: 0, max: 100000 }).optional(),
  };
  const planSchema = v.obj(planShape, { strict: true });
  const isPlanBody = b => b && typeof b === 'object' && ['leader', 'participants', 'route', 'schedule', 'equipment', 'draft', 'routeType', 'confirmations'].some(k => k in b);
  const checkDates = d => { const o = d.overnights || [], s = d.schedule || {}; o.forEach((x, i) => { if (x.arriveDate && x.leaveDate && x.leaveDate < x.arriveDate) throw E.validation({ [`overnights[${i}].leaveDate`]: 'дата ухода раньше даты прибытия' }); if (s.startDate && x.arriveDate && x.arriveDate < s.startDate) throw E.validation({ [`overnights[${i}].arriveDate`]: 'раньше начала похода' }); if (s.returnDate && x.leaveDate && x.leaveDate > s.returnDate) throw E.validation({ [`overnights[${i}].leaveDate`]: 'позже возвращения' }); }); };

  /* ── текст согласия: публично читается, меняет только администратор (после юридической проверки) ── */
  rr.get('/api/v1/consent/:key', { auth: 'none', params: { key: 'str' } }, async ctx => ({ consent: await consent.current(ctx.params.key) }));
  rr.get('/api/v1/admin/consent/:key', { roles: ['ADMIN'], params: { key: 'str' } }, async ctx => ({ consent: await consent.current(ctx.params.key), history: await consent.history(ctx.params.key) }));
  rr.put('/api/v1/admin/consent/:key', { roles: ['ADMIN'], params: { key: 'str' }, bodyLimit: 32 * 1024, body: v.obj({ title: v.str({ min: 5, max: 200 }), body: v.str({ min: 50, max: 12000, multiline: true }) }, { strict: true }) },
    async ctx => ({ consent: await consent.save(ctx, ctx.params.key, ctx.body) }));

  r.get('/api/v1/trips', { query: v.obj({ status: v.enum(['draft', 'planned', 'active', 'completed', 'cancelled', 'overdue', 'emergency']).optional(), limit: v.int({ min: 1, max: 100 }).optional() }) }, async ctx => ({ trips: await trips.listPlans(ctx, ctx.query) }));
  r.get('/api/v1/trips/active', async ctx => { await trips.refreshOverdue(ctx.user.id); return { trip: await trips.active(ctx) }; });
  r.post('/api/v1/trips', { rate: [{ name: 'tripcreate', max: 60, windowMs: 3600e3, by: 'user' }], bodyLimit: 64 * 1024, body: v.any(60000) }, async ctx => {
    ctx.status = 201;
    if (isPlanBody(ctx.body)) { const d = parse(planSchema, ctx.body); checkDates(d); return { trip: await trips.createPlan(ctx, d, await consent.current('trip_pd')) }; }
    return { trip: await trips.create(ctx, parse(legacyCreate, ctx.body)) };
  });
  r.get('/api/v1/trips/:id', { params: id }, async ctx => ({ trip: await trips.getPlan(ctx, ctx.params.id) }));
  r.patch('/api/v1/trips/:id', { params: id, bodyLimit: 64 * 1024, body: v.any(60000) }, async ctx => {
    if (isPlanBody(ctx.body) || (ctx.body && ctx.body.status)) { const d = parse(planSchema, ctx.body); checkDates(d); return { trip: await trips.updatePlan(ctx, ctx.params.id, d, await consent.current('trip_pd')) }; }
    return { trip: await trips.update(ctx, ctx.params.id, parse(legacyPatch, ctx.body)) };
  });
  r.del('/api/v1/trips/:id', { params: id }, async ctx => trips.remove(ctx, ctx.params.id));
  r.post('/api/v1/trips/:id/start', { params: id }, async ctx => ({ trip: await trips.start(ctx, ctx.params.id) }));
  r.post('/api/v1/trips/:id/complete', { params: id, body: v.obj({ distanceKm: v.num({ min: 0, max: 1000 }).optional(), gainM: v.int({ min: 0, max: 20000 }).optional(), durationMin: v.int({ min: 1, max: 20000 }).optional(),
    allSafe: v.bool().optional(), participantsCount: v.int({ min: 1, max: 100 }).optional(), lat: v.lat().optional(), lon: v.lon().optional(), accuracy: v.num({ min: 0, max: 100000 }).optional() }, { strict: true }) },
  async ctx => ({ trip: await trips.complete(ctx, ctx.params.id, ctx.body) }));
  r.post('/api/v1/trips/:id/cancel', { params: id }, async ctx => ({ trip: await trips.cancel(ctx, ctx.params.id) }));
  r.post('/api/v1/trips/:id/safe', { params: id, body: v.obj({ lat: v.lat().optional(), lon: v.lon().optional(), accuracy: v.num({ min: 0, max: 100000 }).optional(), extendMin: v.int({ min: 15, max: 1440 }).optional() }, { strict: true }) },
    async ctx => ({ trip: await trips.safe(ctx, ctx.params.id, ctx.body) }));
  /* Экстренный режим похода. sendSos=true — дополнительно создаёт настоящий SOS (тот же, что кнопка SOS: диспетчер + email/SMS дежурному).
     Без sendSos ничего никуда не отправляется — только запись события и координат. */
  r.post('/api/v1/trips/:id/emergency', { params: id, rate: [{ name: 'tripemerg', max: 30, windowMs: 3600e3, by: 'user' }], body: v.obj({ lat: v.lat().optional(), lon: v.lon().optional(), accuracy: v.num({ min: 0, max: 100000 }).optional(),
    altitude: v.num({ min: -500, max: 9000 }).nullable().optional(), positionAt: v.date().optional(), battery: v.int({ min: 0, max: 100 }).optional(), connection: v.enum(['online', 'weak', 'offline']).optional(),
    sendSos: v.bool().optional(), clientId: v.str({ min: 8, max: 64 }).optional() }, { strict: true }) },
  async ctx => {
    const d = ctx.body, view = await trips.emergency(ctx, ctx.params.id, d);
    let incident = null, sosError = null;
    if (d.sendSos) {
      try {
        const out = await sos.create(ctx, { clientId: d.clientId || 'trip-' + randomToken(9), situation: 'other', description: trips.dispatchSummary(view), lat: d.lat, lon: d.lon, accuracy: d.accuracy, altitude: d.altitude,
          positionAt: d.positionAt, battery: d.battery, connection: d.connection, tripId: view.id, route: view.plan && view.plan.route ? { name: view.name, start: view.plan.route.start, end: view.plan.route.end } : undefined });
        incident = out.incident || null;
      } catch (e) { sosError = e.message || 'SOS не отправлен'; }
    }
    return { trip: view, incident, sosSent: !!incident, sosError };
  });
  r.get('/api/v1/trips/:id/track', { params: id }, async ctx => ({ points: await trips.track(ctx, ctx.params.id) }));
};


