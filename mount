.sim-step header b{font:700 15px var(--label);letter-spacing:.06em}
.sim-step header .mono{font-size:12px;color:var(--ink-3)}
.sim-chip{margin-left:auto;min-width:38px;text-align:center;font:700 13px var(--mono);padding:3px 8px;border-radius:8px;background:var(--lv);color:#04140d}
.sim-step.pending{border-style:dashed;background:var(--bg)}.sim-step.pending>*{opacity:.45}
.sim-step.pending header b{color:var(--ink-3)}
.sim-skel{display:flex;flex-direction:column;gap:7px}.sim-skel i{display:block;height:9px;border-radius:5px;background:var(--mint-2)}.sim-skel i:nth-child(2){width:70%}.sim-skel i:nth-child(3){width:50%}
.sim-step.on{border-color:color-mix(in srgb,var(--lv) 45%,transparent);box-shadow:0 0 0 1px color-mix(in srgb,var(--lv) 18%,transparent),var(--shadow-sm);animation:simIn .55s cubic-bezier(.2,.8,.2,1) both}
.sim-step.on::before{content:"";position:absolute;left:12px;right:12px;top:-1px;height:3px;border-radius:0 0 3px 3px;background:var(--lv)}
@keyframes simIn{from{opacity:0;transform:translateY(14px) scale(.98)}to{opacity:1;transform:none}}
.sim-high{font:800 13px var(--label);letter-spacing:.16em;color:#fff;background:var(--crit);border-radius:8px;padding:5px 10px;text-align:center;animation:blink 1.6s 3}
.sim-kv{display:flex;flex-direction:column;gap:5px;font:500 13px var(--label);color:var(--ink-2)}
.sim-kv li{display:flex;gap:8px;align-items:center}.sim-kv .ic{color:var(--ink-3)}
