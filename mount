.sim-act{font:800 clamp(30px,4vw,46px) var(--display);letter-spacing:-.02em;color:var(--lv);line-height:1}
.sim-reasons{display:flex;flex-direction:column;gap:6px}
.sim-reasons li{padding:8px 10px 8px 26px;position:relative;background:var(--surface-2);border:1px solid var(--line);border-radius:10px}
.sim-reasons li::before{content:"";position:absolute;left:11px;top:15px;width:6px;height:6px;border-radius:50%;background:var(--lv,var(--crit))}
.sim-reasons b{display:block;font:600 13.5px var(--label)}.sim-reasons small{color:var(--ink-3)}
.sim-fin-note{color:var(--ink-3)}
.sim-altc h3{font-size:20px;margin-top:4px}
.sim-cmp{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:700px){.sim-cmp{grid-template-columns:1fr}}
.sim-cmp>div{display:flex;flex-direction:column;gap:6px;padding:14px;border-radius:14px;background:var(--surface-2);border:1px solid var(--line)}
