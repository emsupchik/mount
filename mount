      await q.query("UPDATE rescue_teams SET availability='available' WHERE id=$1 AND NOT EXISTS (SELECT 1 FROM sos_incidents WHERE team_id=$1 AND id<>$2 AND status IN ('DISPATCHED','IN_PROGRESS'))", [i.team_id, id]);
